{
  "name": "diatyposi-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static marketing website for ΔΙΑΤΥΠΩΣΗ | Διαφήμιση – Εκτυπώσεις",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "content-review": "node --import ./scripts/register-alias.mjs scripts/content-review.mjs && prettier --write CONTENT_REVIEW.md",
    "brand-assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
