# Response headers for the Cloudflare Worker `diatyposi` (static assets). Cloudflare reads this
# file from the build output; tests/security.test.ts checks it. The page's Content-Security-Policy
# is a <meta> tag that Astro writes (security.csp in astro.config.mjs); the header below adds only
# what a <meta> policy cannot say (frame-ancestors). Both policies apply.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Fingerprinted build files: their names change whenever their contents do.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The share image is shown by other sites (link previews).
/og.jpg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
