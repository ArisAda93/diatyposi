---
/**
 * Shared page shell: head (SEO, Open Graph, JSON-LD, fonts), the living background, skip link,
 * header, footer and the mobile floating contact bar. Every page renders exactly one <h1> inside
 * the default slot.
 */
import '~/styles/global.css';
import '~/styles/motion.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import FloatingContact from '~/components/FloatingContact.astro';
import LivingBackground from '~/components/LivingBackground.astro';
import { site } from '~/data/site';
import { defaultLocale, localeTags, t, type Locale } from '~/i18n/ui';
import { buildLocalBusiness } from '~/lib/seo';

interface Props {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of a custom share image inside /public. */
  ogImage?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Emit the LocalBusiness JSON-LD (home and contact). */
  structuredData?: boolean;
  /** Home only: the header sits over the full-screen hero and is part of its composition. */
  heroHeader?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  ogImage = '/og.jpg',
  noindex = false,
  structuredData = false,
  heroHeader = false,
  locale = defaultLocale,
} = Astro.props;

const brand = `${site.name} | ${site.descriptor[locale]}`;
const fullTitle = title ? `${title} | ${site.name}` : brand;
const metaDescription = description ?? t('defaultDescription', locale);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const jsonLd = structuredData ? JSON.stringify(buildLocalBusiness(siteUrl, locale)) : null;
---

<!doctype html>
<html lang={localeTags[locale].html} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FAFAF7" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Runs before first paint. Marks JS support and decides whether the hero intro plays
      // (once per session, never with reduced motion).
      (function () {
        const d = document.documentElement;
        d.classList.remove('no-js');
        try {
          if (
            !sessionStorage.getItem('dt-hero-played') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            d.classList.add('hero-intro');
            // Safety net: never leave the hero in its pre-intro state if scripts fail.
            setTimeout(function () {
              d.classList.remove('hero-intro');
            }, 4000);
          }
        } catch {
          /* storage blocked: show the composed hero */
        }
      })();
    </script>

    <link
      rel="preload"
      href="/fonts/commissioner-greek-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-greek-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeTags[locale].og} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('ogImageAlt', locale)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] md:pb-0">
    <LivingBackground />
    <a href="#main" class="skip-link">
      {t('skipLink', locale)}
    </a>
    <Header locale={locale} overHero={heroHeader} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <FloatingContact locale={locale} />
    <script>
      import '~/scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--color-key);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
    outline-color: var(--color-yellow);
  }
</style>
