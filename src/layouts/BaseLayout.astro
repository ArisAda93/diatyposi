---
/**
 * Shared page shell: head (SEO, Open Graph, JSON-LD, fonts), the living background, skip link,
 * header, footer and the mobile floating contact bar. Every page renders exactly one <h1> inside
 * the default slot.
 *
 * Mobile call bar: <body> is padded by `--float-bar-h` (global.css), the bar's height with the
 * safe area below 48rem and 0 elsewhere, so the end of the page never hides under it.
 *
 * Theme: the inline head script sets `html[data-theme]` and both theme metas before first paint
 * (stored choice, else the system); the module script wires every theme toggle (theme.ts).
 * Without JS the metas and the page stay light.
 */
import '~/styles/global.css';
import '~/styles/motion.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import FloatingContact from '~/components/FloatingContact.astro';
import LivingBackground from '~/components/LivingBackground.astro';
import { site } from '~/data/site';
import { defaultLocale, localeTags, t, type Locale } from '~/i18n/ui';
import {
  buildBreadcrumbs,
  buildGraph,
  buildLocalBusiness,
  buildWebSite,
  pageCrumbs,
  type Crumb,
  type Json,
} from '~/lib/seo';
import { THEME_COLORS, THEME_STORAGE_KEY } from '~/scripts/theme';

interface Props {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of a custom share image inside /public. */
  ogImage?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Emit the LocalBusiness JSON-LD (home and contact). */
  structuredData?: boolean;
  /**
   * Breadcrumb trail for the BreadcrumbList JSON-LD, Home first. Omit to derive it from the
   * navigation label (or the title) of the current page.
   */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page (e.g. Service, FAQPage), added to the page's @graph. */
  jsonLd?: Json[];
  /** Home only: the header sits over the full-screen hero and is part of its composition. */
  heroHeader?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  ogImage = '/og.jpg',
  noindex = false,
  structuredData = false,
  breadcrumbs,
  jsonLd = [],
  heroHeader = false,
  locale = defaultLocale,
} = Astro.props;

const brand = `${site.name} | ${site.descriptor[locale]}`;
const fullTitle = title ? `${title} | ${site.name}` : brand;
const metaDescription = description ?? t('defaultDescription', locale);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

// One JSON-LD document per page. Breadcrumbs only on indexable pages below Home; a trail needs
// at least two steps to say anything.
const isHome = Astro.url.pathname === '/';
const crumbs =
  isHome || noindex ? [] : (breadcrumbs ?? pageCrumbs(Astro.url.pathname, title, locale));
const graphNodes: Json[] = [
  ...(isHome ? [buildWebSite(siteUrl, locale)] : []),
  ...(structuredData ? [buildLocalBusiness(siteUrl, locale)] : []),
  ...(crumbs.length >= 2 ? [buildBreadcrumbs(siteUrl, crumbs)] : []),
  ...jsonLd,
];
// `<` escaped as \u003c (still valid JSON) so no string can close the <script> element early.
const graphJson =
  graphNodes.length > 0 ? JSON.stringify(buildGraph(graphNodes)).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang={localeTags[locale].html} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta
          name="robots"
          content="max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <link rel="alternate" hreflang={localeTags[locale].html} href={canonical} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    )}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={THEME_COLORS.light} />
    <meta name="generator" content={Astro.generator} />

    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY, themeColors: THEME_COLORS }}>
      // Runs before first paint. Marks JS support, sets the theme and decides whether the hero
      // intro plays (once per session, never with reduced motion).
      (function () {
        const d = document.documentElement;
        d.classList.remove('no-js');

        // Theme: a valid stored choice, else the system. Keep in sync with resolveTheme() in
        // src/scripts/theme.ts (tests/theme.test.ts covers that decision).
        let stored = null;
        try {
          stored = localStorage.getItem(themeKey);
        } catch {
          /* storage blocked: follow the system */
        }
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        d.setAttribute('data-theme', theme);
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.setAttribute('content', themeColors[theme]);
        const colorScheme = document.querySelector('meta[name="color-scheme"]');
        if (colorScheme) colorScheme.setAttribute('content', theme);

        try {
          if (
            !sessionStorage.getItem('dt-hero-played') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            d.classList.add('hero-intro');
            // Safety net: never leave the hero in its pre-intro state if scripts fail.
            setTimeout(function () {
              d.classList.remove('hero-intro');
            }, 4000);
          }
        } catch {
          /* storage blocked: show the composed hero */
        }
      })();
    </script>

    <link
      rel="preload"
      href="/fonts/commissioner-greek-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-greek-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeTags[locale].og} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('ogImageAlt', locale)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {graphJson && <script type="application/ld+json" set:html={graphJson} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <LivingBackground />
    <a href="#main" class="skip-link">
      {t('skipLink', locale)}
    </a>
    <Header locale={locale} overHero={heroHeader} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer locale={locale} />
    <FloatingContact locale={locale} />
    <script>
      import '~/scripts/motion';
      import { initThemeToggle } from '~/scripts/theme';

      initThemeToggle();
      // iOS Safari only applies :active (the press states) when a touch listener exists.
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--color-key);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }
  /*
   * `:focus`, not `:focus-visible`: the link must show whenever it holds focus. The ring is the
   * site's focus colour: it sits on the page around the key face (a yellow ring vanished on paper).
   */
  .skip-link:focus {
    transform: none;
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  @media print {
    .skip-link {
      display: none;
    }
  }
</style>
