---
/**
 * Filterable gallery for /erga/. Data: `portfolio` in src/data/site.ts (images in
 * src/assets/portfolio/). Without JS every tile shows and links to its large image; the filter
 * chips stay hidden (`html.no-js`, removed by BaseLayout before first paint) because they cannot
 * work, so with JS they are visible from first paint (no layout shift). With JS
 * (src/scripts/gallery.ts) the chips filter, the count is announced and the tiles open the
 * lightbox.
 *
 * Feedback: each chip shows how many items it holds (a small tally); the pressed chip is printed
 * in key with a C/M plate shadow that snaps into register on press; the live count ticks when it
 * changes, and tiles that come back into view print in (`data-entering`, set by the script).
 * Phones: the chips are one sideways row (`data-chip-row`); the script keeps the pressed chip in
 * the middle and fades the sides that hide chips.
 */
import { getImage as optimizeImage } from 'astro:assets';
import WorkTile from './WorkTile.astro';
import Lightbox from './Lightbox.astro';
import { portfolio, services } from '~/data/site';
import { workText } from '~/i18n/pages/work';
import { getImage as imageFile } from '~/lib/images';
import { ALL, categoriesFor, categoryLabel, formatCount, tileLayout } from '~/lib/portfolio';

const text = workText.el;
const categories = categoriesFor(portfolio, services).map((c) => ({
  ...c,
  count: portfolio.filter((item) => item.service === c.slug).length,
}));
const shapes = tileLayout(portfolio.length);
const LARGE_WIDTHS = [960, 1600];

const tiles = await Promise.all(
  portfolio.map(async (item, index) => {
    const meta = imageFile(item.image);
    const usable = LARGE_WIDTHS.filter((w) => w <= meta.width);
    const widths = usable.length ? usable : [meta.width];
    const largest = widths[widths.length - 1] ?? meta.width;
    const large = await optimizeImage({ src: meta, widths, format: 'webp' });
    return {
      item,
      shape: shapes[index] ?? 'square',
      // The first tile is the LCP image. The second sits below the fold on phones, so it stays
      // lazy like the rest.
      priority: index === 0,
      category: categoryLabel(item.service, services),
      large: {
        src: large.src,
        srcset: large.srcSet.attribute,
        width: largest,
        height: Math.round((largest * meta.height) / meta.width),
      },
    };
  }),
);
---

<div class="work-gallery" data-gallery>
  <div class="work-filters" data-filter-bar>
    <div class="work-chips" role="group" aria-label={text.filterGroupLabel} data-chip-row>
      <button type="button" class="work-chip" aria-pressed="true" data-filter={ALL}>
        <span>{text.filterAll}</span>
        <span class="chip-count">{portfolio.length}</span>
      </button>
      {categories.map((c) => (
        <button type="button" class="work-chip" aria-pressed="false" data-filter={c.slug}>
          <span>{c.label}</span>
          <span class="chip-count">{c.count}</span>
        </button>
      ))}
    </div>
    <p class="work-count" role="status" data-filter-status>
      {formatCount(portfolio.length, { one: text.countOne, other: text.countOther })}
    </p>
  </div>

  <p id="work-open-hint" class="sr-only">
    {text.tileOpenHint}
  </p>

  <ul class="work-grid">
    {tiles.map((tile) => (
      <WorkTile {...tile} />
    ))}
  </ul>

  <Lightbox />
</div>

<script>
  import { initGallery } from '~/scripts/gallery';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

<style>
  @layer components {
    .work-filters {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    }
    :global(.no-js) .work-filters {
      display: none;
    }
    /* Phones: one sideways-scrolling row, edge to edge of the screen like the chip row on
       Υπηρεσίες: at rest the first chip lines up with the page gutter (or the landscape notch
       inset, as .wrap does), the chips run off the screen's edge instead of being cut at the
       gutter, and a side that hides chips fades out (`data-edges` from gallery.ts; without JS
       the chips are hidden anyway). Chips snap to the middle, where the script also brings the
       pressed chip; the symmetric scroll padding keeps a focused or snapped chip out of both
       fades. The padding also keeps focus outlines and the pressed chip's plate shadow inside
       the scroll box. */
    .work-filters {
      --work-bleed-start: max(var(--gutter), env(safe-area-inset-left, 0px));
      --work-bleed-end: max(var(--gutter), env(safe-area-inset-right, 0px));
    }
    .work-chips {
      --work-fade: 2rem;
      --work-fade-start: 0px;
      --work-fade-end: var(--work-fade);
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--work-fade);
      padding: 0.5rem max(var(--work-fade), var(--work-bleed-end)) 0.75rem var(--work-bleed-start);
      margin-inline: calc(var(--work-bleed-start) * -1) calc(var(--work-bleed-end) * -1);
      scrollbar-width: thin;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--work-fade-start),
        #000 calc(100% - var(--work-fade-end)),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--work-fade-start),
        #000 calc(100% - var(--work-fade-end)),
        transparent 100%
      );
    }
    @media (max-width: 47.99rem) {
      /* With the script: fades follow the hidden chips; the end padding matches the start (at
         least 1rem, so the pressed chip's 6px plate shadow stays inside the box). */
      .work-chips[data-edges] {
        --work-fade-end: 0px;
        padding-inline-end: var(--work-bleed-end);
      }
      .work-chips[data-edges~='start'] {
        --work-fade-start: var(--work-fade);
      }
      .work-chips[data-edges~='end'] {
        --work-fade-end: var(--work-fade);
      }
    }
    /* Touch screens: no scrollbar under the chips; the fades are the overflow hint. */
    @media (max-width: 47.99rem) and (pointer: coarse) {
      .work-chips {
        scrollbar-width: none;
      }
      .work-chips::-webkit-scrollbar {
        display: none;
      }
    }
    .work-chip {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.625rem 0.5rem 1rem;
      border: 2px solid var(--color-key);
      background-color: var(--color-paper);
      color: var(--color-key);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
      cursor: pointer;
      scroll-snap-align: center;
      -webkit-tap-highlight-color: transparent;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear,
        box-shadow var(--dur-base) var(--ease-snap);
    }
    /* Hover tint only where a pointer can hover: a tapped chip must not keep it. */
    @media (hover: hover) {
      .work-chip:hover {
        background-color: var(--color-paper-2);
      }
      .work-chip:hover .chip-count {
        background-color: var(--color-paper);
      }
    }
    /* Tally of the items under this chip. */
    .chip-count {
      min-width: 1.625rem;
      padding: 0.125rem 0.375rem;
      background-color: var(--color-paper-2);
      font-size: 0.8125rem;
      font-weight: 750;
      text-align: center;
      font-variant-numeric: tabular-nums;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear;
    }
    .work-chip[aria-pressed='true'] {
      background-color: var(--color-key);
      color: var(--color-paper);
      box-shadow:
        3px 3px 0 var(--color-cyan),
        6px 6px 0 var(--color-magenta);
    }
    /* The tally of the pressed chip: ink on yellow in both themes. */
    .work-chip[aria-pressed='true'] .chip-count {
      background-color: var(--color-yellow);
      color: var(--ink-fixed);
    }
    /* Press: the plates snap into register (the push-in itself is the global aria-pressed rule). */
    .work-chip:active {
      box-shadow: 0 0 0 transparent;
      transition-duration: 60ms;
    }

    .work-count {
      font-size: var(--text-small);
      color: var(--color-muted);
      font-variant-numeric: tabular-nums;
    }
    /* The count ticks when the filter changes (class set by the script). */
    @media (prefers-reduced-motion: no-preference) {
      .work-count.is-tick {
        animation: count-tick 520ms var(--ease-snap);
      }
    }

    .work-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--grid-gap);
    }

    @media (min-width: 48rem) {
      .work-filters {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
      }
      .work-chips {
        flex-wrap: wrap;
        overflow: visible;
        padding: 0 6px 6px 0;
        margin: 0;
        -webkit-mask-image: none;
        mask-image: none;
      }
      .work-count {
        flex: none;
        padding-bottom: 0.75rem;
      }
      .work-grid {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        grid-auto-rows: clamp(7.5rem, 1rem + 13vw, 12rem);
      }
    }
    @media (min-width: 64rem) {
      .work-grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-auto-rows: clamp(7rem, 2rem + 8vw, 13rem);
      }
    }
  }

  @keyframes count-tick {
    0% {
      color: var(--color-key);
      transform: translateY(-0.35em);
    }
    60% {
      color: var(--color-key);
    }
    100% {
      transform: none;
    }
  }
</style>
