---
/**
 * A drop of printing ink: the small mark that ends the press-sheet rules (section heads, page
 * headers, the hero, the footer and the sheets). Outline in `currentColor`, with the ink pooled
 * at the bottom of the drop. Decorative.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 28 28"
  width={size}
  height={size}
  class:list={['inkdrop', className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M14 3.5C14 3.5 7 11.6 7 16.8a7 7 0 0 0 14 0C21 11.6 14 3.5 14 3.5Z"></path>
  <path d="M9.9 17.6a4.1 4.1 0 0 0 8.2 0Z" fill="currentColor" stroke="none"></path>
</svg>
