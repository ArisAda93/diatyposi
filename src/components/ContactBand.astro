---
/**
 * Yellow contact band (home and /etaireia/): a short heading and line, then the quote and call
 * buttons. Takes no props; strings live in src/i18n/pages/home.ts (contactBand).
 */
import Icon from './Icon.astro';
import RegMark from './RegMark.astro';
import { routes, site } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { t } from '~/i18n/ui';
import { telHref } from '~/lib/links';
import { capsEl } from '~/lib/text';

const copy = homeText.el.contactBand;
---

<section class="contact-band" aria-labelledby="contact-band-title">
  <div class="wrap cb-inner">
    <div class="cb-copy" data-reveal="depth">
      <p class="label cb-label">{capsEl(copy.label)}</p>
      <h2 id="contact-band-title" class="h2 cb-title">
        {copy.heading}
      </h2>
      <p class="lead cb-text">{copy.text}</p>
    </div>
    <div class="cb-actions">
      <a href={routes.quote} class="btn btn-primary">
        <span>{t('requestQuote')}</span>
        <Icon name="arrow-right" size={20} />
      </a>
      <a href={telHref(site.contact.phone)} class="btn btn-secondary cb-phone">
        <Icon name="phone" size={18} />
        <span>
          <span class="sr-only">{t('callUs')}: </span>
          {site.contact.phoneDisplay}
        </span>
      </a>
    </div>
  </div>
  <span class="cb-reg" aria-hidden="true">
    <RegMark size={200} />
  </span>
</section>

<style>
  @layer components {
    .contact-band {
      position: relative;
      overflow: clip;
      background-color: var(--color-yellow);
      color: var(--color-key);
    }
    .cb-inner {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 2rem;
      padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    }
    .contact-band .cb-label {
      margin-bottom: 1.25rem;
      color: var(--color-key);
    }
    .cb-title {
      max-width: 20ch;
    }
    .cb-text {
      max-width: 48ch;
      margin-top: 1.25rem;
    }
    .cb-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .cb-phone {
      font-variant-numeric: tabular-nums;
    }
    .cb-reg {
      position: absolute;
      top: 50%;
      right: -3.5rem;
      display: none;
      color: var(--color-key);
      opacity: 0.18;
      transform: translateY(-50%);
      pointer-events: none;
    }

    @media (min-width: 40rem) {
      .cb-actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
    }

    @media (min-width: 64rem) {
      .cb-inner {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        align-items: end;
        gap: var(--grid-gap);
      }
      .cb-actions {
        justify-content: flex-end;
        padding-right: 7rem;
      }
      .cb-reg {
        display: block;
      }
    }
  }
</style>
