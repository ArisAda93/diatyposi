---
/** Registration target (circle with crosshair), as printed in the margins of a press sheet. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 28 28"
  width={size}
  height={size}
  class:list={['regmark', className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="14" cy="14" r="7.5"></circle>
  <circle cx="14" cy="14" r="3.5" fill="currentColor" stroke="none"></circle>
  <path d="M14 0v28M0 14h28"></path>
</svg>
