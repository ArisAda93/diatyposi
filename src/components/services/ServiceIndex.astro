---
/**
 * Index of the nine service chapters.
 *
 * Desktop (from 64rem): a slim sticky rail. A hairline track runs down the left with one square
 * tick per chapter; the track fills in the chapters' plate colours as the visitor reads on, the
 * ticks of chapters already read print in their ink (.is-read), and the chapter in view is marked
 * (aria-current). All three are set by src/scripts/services-page.ts; without JS the rail is a
 * plain list of anchor links. Below 64rem: one row of chips that scrolls sideways inside its own
 * box, in a bar that sticks under the header (src/pages/ypiresies.astro); the chip of the chapter
 * in view is filled and scrolled into the middle of the row.
 */
import Icon from '../Icon.astro';
import { quoteHref, services } from '~/data/site';
import { servicesText } from '~/i18n/pages/services';
import { t } from '~/i18n/ui';
import { capsEl } from '~/lib/text';
import { plateInk, railGradient } from '~/scripts/services-page';

const text = servicesText.el;
const fill = `background-image:${railGradient(services.length)}`;
---

<nav class="svc-index" aria-label={text.indexNavLabel} data-svc-index>
  <p class="label svc-index-heading" aria-hidden="true">
    {capsEl(text.indexHeading)}
  </p>
  <div class="svc-index-rail">
    <span class="svc-index-track" aria-hidden="true">
      <span class="svc-index-fill" style={fill}></span>
    </span>
    <ol class="svc-index-list" data-svc-index-list>
      {services.map((s, i) => (
        <li>
          <a href={`#${s.slug}`} class={`svc-index-link svc-index-ink-${plateInk(i)}`}>
            <span class="svc-index-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>{' '}
            <span class="svc-index-text">{s.text.el.short}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <a href={quoteHref()} class="btn btn-secondary svc-index-cta">
    <span>{t('requestQuote')}</span>
    <Icon name="arrow-right" size={20} />
  </a>
</nav>

<style>
  @layer components {
    .svc-index {
      min-width: 0;
    }
    .svc-index-heading,
    .svc-index-track,
    .svc-index-cta {
      display: none;
    }
    .svc-index-ink-cyan {
      --svc-index-ink: var(--color-cyan);
    }
    .svc-index-ink-magenta {
      --svc-index-ink: var(--color-magenta);
    }
    .svc-index-ink-yellow {
      --svc-index-ink: var(--color-yellow);
    }
    .svc-index-ink-key {
      --svc-index-ink: var(--color-key);
    }

    /* Below 1024px: one row of chips that scrolls sideways inside its own box. The right edge
       fades to show there is more; the end padding lets the last chip scroll clear of the fade. */
    .svc-index-list {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 0.375rem 2rem;
      /* Room so focus outlines are not clipped by the scroll box. */
      padding: 0.5rem 2rem 0.75rem 0.375rem;
      margin-inline: -0.375rem;
      scrollbar-width: thin;
      mask-image: linear-gradient(to left, transparent 0, #000 2rem);
    }
    .svc-index-list > li {
      flex: none;
      scroll-snap-align: start;
    }
    .svc-index-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.875rem 0.5rem 0.75rem;
      border: 2px solid var(--color-key);
      background-color: var(--color-paper);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
      text-decoration: none;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear,
        transform var(--dur-fast) var(--ease-out);
    }
    /* A square of the chapter's plate colour, like a colour-bar patch. */
    .svc-index-link::before {
      content: '';
      flex: none;
      width: 0.625rem;
      height: 0.625rem;
      background-color: var(--svc-index-ink);
      box-shadow: inset 0 0 0 1px var(--color-key);
    }
    .svc-index-link:hover,
    .svc-index-link[aria-current='true'] {
      background-color: var(--color-key);
      color: var(--color-paper);
    }
    /* On the key fill the patch keeps a paper edge, so the key patch still reads. */
    .svc-index-link:hover::before,
    .svc-index-link[aria-current='true']::before {
      box-shadow: inset 0 0 0 1px var(--color-paper);
    }
    .svc-index-link:active {
      transform: scale(0.97);
    }
    .svc-index-num {
      font-size: 0.75rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      color: var(--color-red);
      font-variant-numeric: tabular-nums;
    }
    .svc-index-link:hover .svc-index-num,
    .svc-index-link[aria-current='true'] .svc-index-num {
      color: inherit;
    }

    /* Desktop: the slim sticky rail. */
    @media (min-width: 64rem) {
      .svc-index {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
        max-height: calc(100dvh - var(--header-h) - 3rem);
        overflow-y: auto;
        padding: 0.375rem;
        margin: -0.375rem;
        scrollbar-width: thin;
      }
      .svc-index-heading {
        display: block;
        margin-bottom: 1.25rem;
      }
      .svc-index-rail {
        position: relative;
      }
      /* The track: a hairline down the tick column, filled to the reading progress. */
      .svc-index-track {
        position: absolute;
        top: 1.375rem;
        bottom: 1.375rem;
        left: calc(0.375rem - 1px);
        display: block;
        width: 2px;
        background-color: var(--color-line);
      }
      .svc-index-fill {
        position: absolute;
        inset: 0;
        clip-path: inset(0 0 calc(100% - var(--svcp-progress, 0) * 100%) 0);
      }
      .svc-index-list {
        flex-direction: column;
        gap: 0;
        overflow: visible;
        padding: 0;
        margin: 0;
        mask-image: none;
      }
      .svc-index-link {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        width: 100%;
        min-height: 2.75rem;
        padding: 0.625rem 0 0.625rem 1.5rem;
        border: 0;
        background-color: transparent;
        color: var(--color-muted);
        white-space: normal;
        transition: color var(--dur-fast) linear;
      }
      /* The tick: centred on the track. Ahead: an empty square. Read: printed in the chapter's
         ink. In view: inked, key-edged and a little larger. */
      .svc-index-link::before {
        position: absolute;
        top: 50%;
        left: 0;
        width: 0.75rem;
        height: 0.75rem;
        margin-top: -0.375rem;
        background-color: var(--color-paper);
        box-shadow: inset 0 0 0 2px var(--color-line);
        transition:
          background-color var(--dur-base) linear,
          box-shadow var(--dur-base) linear,
          transform var(--dur-base) var(--ease-snap);
      }
      .svc-index-link.is-read::before {
        background-color: var(--svc-index-ink);
        box-shadow: inset 0 0 0 1px var(--color-key);
      }
      .svc-index-link:hover,
      .svc-index-link[aria-current='true'] {
        background-color: transparent;
        color: var(--color-key);
      }
      .svc-index-link:hover .svc-index-num,
      .svc-index-link[aria-current='true'] .svc-index-num {
        color: var(--color-red);
      }
      .svc-index-link:hover::before {
        box-shadow: inset 0 0 0 2px var(--color-key);
      }
      .svc-index-link.is-read:hover::before {
        box-shadow: inset 0 0 0 1px var(--color-key);
      }
      .svc-index-link:active {
        transform: none;
      }
      .svc-index-text {
        background-image: linear-gradient(currentColor, currentColor);
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0 2px;
        transition: background-size var(--dur-base) var(--ease-out);
      }
      .svc-index-link:hover .svc-index-text {
        background-size: 100% 2px;
      }
      /* The chapter in view. Colour and tick only: no weight change, so nothing reflows. */
      .svc-index-link[aria-current='true']::before {
        background-color: var(--svc-index-ink);
        box-shadow: inset 0 0 0 2px var(--color-key);
      }
      .svc-index-link[aria-current='true'] .svc-index-text {
        background-size: 100% 2px;
      }
      @media (prefers-reduced-motion: no-preference) {
        .svc-index-link[aria-current='true']::before {
          transform: scale(1.25);
        }
      }
      .svc-index-cta {
        display: inline-flex;
        margin-top: 2rem;
      }
    }
  }
</style>
