---
/**
 * Index of the nine services. Desktop: a sticky numbered list in the left column, with the
 * section in view marked (IntersectionObserver; without JS the links simply jump). Below 1024px:
 * a horizontal chip row inside its own scroll box.
 */
import Icon from '../Icon.astro';
import { quoteHref, services } from '~/data/site';
import { servicesText } from '~/i18n/pages/services';
import { t } from '~/i18n/ui';
import { capsEl } from '~/lib/text';

const text = servicesText.el;
---

<nav class="svc-index" aria-label={text.indexNavLabel} data-svc-index>
  <p class="label svc-index-heading" aria-hidden="true">
    {capsEl(text.indexHeading)}
  </p>
  <ol class="svc-index-list">
    {services.map((s, i) => (
      <li>
        <a href={`#${s.slug}`} class="svc-index-link">
          <span class="svc-index-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="svc-index-text">{s.text.el.short}</span>
        </a>
      </li>
    ))}
  </ol>
  <a href={quoteHref()} class="btn btn-secondary svc-index-cta">
    <span>{t('requestQuote')}</span>
    <Icon name="arrow-right" size={20} />
  </a>
</nav>

<style>
  @layer components {
    .svc-index {
      min-width: 0;
    }
    .svc-index-heading,
    .svc-index-cta {
      display: none;
    }

    /* Below 1024px: one row of chips that scrolls sideways inside its own box. */
    .svc-index-list {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      /* Room so focus outlines are not clipped by the scroll box. */
      padding: 0.5rem 0.375rem 0.75rem;
      margin-inline: -0.375rem;
      scrollbar-width: thin;
    }
    .svc-index-list > li {
      flex: none;
      scroll-snap-align: start;
    }
    .svc-index-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.875rem;
      border: 2px solid var(--color-key);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
      text-decoration: none;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear;
    }
    .svc-index-link:hover {
      background-color: var(--color-key);
      color: var(--color-paper);
    }
    .svc-index-num {
      font-size: 0.75rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      color: var(--color-red);
      font-variant-numeric: tabular-nums;
    }
    .svc-index-link:hover .svc-index-num {
      color: inherit;
    }

    /* Desktop: sticky numbered list. */
    @media (min-width: 64rem) {
      .svc-index {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
        max-height: calc(100dvh - var(--header-h) - 3rem);
        overflow-y: auto;
        padding: 0.375rem;
        margin: -0.375rem;
        scrollbar-width: thin;
      }
      .svc-index-heading {
        display: block;
        margin-bottom: 1.25rem;
      }
      .svc-index-list {
        flex-direction: column;
        gap: 0;
        overflow: visible;
        padding: 0;
        margin: 0;
        border-bottom: 1px solid var(--color-line);
      }
      .svc-index-link {
        display: flex;
        align-items: baseline;
        gap: 0.875rem;
        width: 100%;
        min-height: 2.75rem;
        padding: 0.625rem 0;
        border: 0;
        border-top: 1px solid var(--color-line);
        color: var(--color-muted);
        white-space: normal;
        transition: color var(--dur-fast) linear;
      }
      .svc-index-link:hover {
        background-color: transparent;
        color: var(--color-key);
      }
      .svc-index-link:hover .svc-index-num {
        color: var(--color-red);
      }
      .svc-index-text {
        background-image: linear-gradient(currentColor, currentColor);
        background-repeat: no-repeat;
        background-position: 0 100%;
        background-size: 0 2px;
        transition: background-size var(--dur-base) var(--ease-out);
      }
      .svc-index-link:hover .svc-index-text {
        background-size: 100% 2px;
      }
      .svc-index-link[aria-current='true'] {
        color: var(--color-key);
        font-weight: 780;
      }
      .svc-index-link[aria-current='true'] .svc-index-num {
        color: var(--color-key);
      }
      .svc-index-link[aria-current='true'] .svc-index-text {
        background-size: 100% 2px;
      }
      .svc-index-cta {
        display: inline-flex;
        margin-top: 2rem;
      }
    }
  }
</style>

<script>
  // Marks the index entry of the section in the middle band of the viewport. Optional: without
  // IntersectionObserver or JS, the index is a plain list of anchor links.
  const index = document.querySelector<HTMLElement>('[data-svc-index]');
  if (index && 'IntersectionObserver' in window) {
    const links = new Map<string, HTMLAnchorElement>();
    index.querySelectorAll<HTMLAnchorElement>('.svc-index-link[href^="#"]').forEach((a) => {
      links.set(a.hash.slice(1), a);
    });
    const setCurrent = (id: string) => {
      links.forEach((a, key) => {
        if (key === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setCurrent(entry.target.id);
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
</script>
