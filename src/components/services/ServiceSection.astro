---
/**
 * One chapter of /ypiresies/, anchored by the service slug: a rule in the chapter's plate colour,
 * the folio (plate icon, number), the owner's title (h2), and below it a crop-marked photo beside
 * the description, the usual jobs as tag chips and the quote button that pre-selects this service.
 * A giant outlined number sits behind for depth. `side` puts the photo left or right.
 *
 * Scroll motion (src/scripts/services-page.ts): the frame straightens out of a 3D turn, the number
 * drifts, the rule draws in. Without JS or under reduced motion everything rests flat.
 */
import Icon from '../Icon.astro';
import PlateIcon from '../PlateIcon.astro';
import Photo from '../Photo.astro';
import { portfolio, quoteHref, type Service } from '~/data/site';
import { servicesText } from '~/i18n/pages/services';
import { t } from '~/i18n/ui';
import { capsEl } from '~/lib/text';
import type { PlateInk } from '~/scripts/services-page';

interface Props {
  service: Service;
  /** 1-based position, shown as 01–09. */
  number: number;
  total: number;
  /** Side of the photo from 48rem. */
  side: 'left' | 'right';
  ink: PlateInk;
}

const { service, number, total, side, ink } = Astro.props;
const text = servicesText.el;
const copy = service.text.el;
const titleId = `${service.slug}-title`;
const num = String(number).padStart(2, '0');
// Services carry no stand-in flag: take it from the portfolio entry that uses the same photo, so a
// real photo marked `standIn: false` there drops the label here too. A photo with no portfolio
// entry has no known provenance, so it stays labelled.
const standIn = portfolio.find((p) => p.image === service.image)?.standIn ?? true;

// Rendered photo width: full width less the crop-mark room on phones; 7 of 12 columns of the
// chapter from 768px; inside the 9.6-of-12 main column from 1024px.
const sizes = '(min-width: 1024px) min(35vw, 520px), (min-width: 768px) 46vw, calc(100vw - 5rem)';
---

<section
  id={service.slug}
  aria-labelledby={titleId}
  class:list={['svcp', 'plate-hover', `svcp--fig-${side}`, `svcp-ink-${ink}`]}
  data-svcp-chapter
  data-side={side}
>
  <div class="svcp-ghost" aria-hidden="true" data-motion="off">
    <span class="svcp-ghost-num" data-svcp-num>
      {num}
    </span>
  </div>
  <span class="svcp-rule" aria-hidden="true" data-motion="off" data-svcp-rule></span>

  <div class="svcp-folio" aria-hidden="true">
    <PlateIcon name={service.icon} size={40} />
    <span class="svcp-count">
      <span class="svcp-count-num">{num}</span>
      <span>/ {String(total).padStart(2, '0')}</span>
    </span>
  </div>
  <h2 id={titleId} class="h2 svcp-title">
    {copy.title}
  </h2>

  <div class="svcp-grid">
    <div class="svcp-fig">
      <div class="svcp-frame crop-frame" data-svcp-frame>
        <div class="svcp-media media">
          <Photo image={service.image} alt={copy.imageAlt} sizes={sizes} />
          {standIn && <span class="svcp-standin">{t('standInLabel')}</span>}
        </div>
      </div>
    </div>

    <div class="svcp-body">
      <p class="lead svcp-desc">{copy.description}</p>
      <h3 class="label svcp-tags-heading">{capsEl(text.productsHeading)}</h3>
      <ul class="svcp-tags">
        {copy.products.map((product) => (
          <li>{product}</li>
        ))}
      </ul>
      <a href={quoteHref(service.slug)} class="btn btn-primary svcp-cta" aria-describedby={titleId}>
        <span>{text.serviceQuoteCta}</span>
        <Icon name="arrow-right" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  @layer components {
    .svcp {
      position: relative;
      isolation: isolate;
      padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
    }
    .svcp-ink-cyan {
      --svcp-ink: var(--color-cyan);
      --svcp-stroke: var(--color-cyan);
    }
    .svcp-ink-magenta {
      --svcp-ink: var(--color-magenta);
      --svcp-stroke: var(--color-magenta);
    }
    .svcp-ink-yellow {
      --svcp-ink: var(--color-yellow);
      --svcp-stroke: var(--color-yellow);
    }
    .svcp-ink-key {
      --svcp-ink: var(--color-key);
      --svcp-stroke: color-mix(in srgb, var(--color-key) 30%, transparent);
    }

    /* The thin rule in the chapter's plate colour, across the top. */
    .svcp-rule {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background-color: var(--svcp-ink);
    }

    /* The giant outlined number, behind everything, clipped to the chapter as it drifts. */
    .svcp-ghost {
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: clip;
      pointer-events: none;
      user-select: none;
    }
    .svcp-ghost-num {
      position: absolute;
      top: clamp(1.5rem, 4vw, 4rem);
      right: 0;
      font-family: var(--font-display);
      font-size: clamp(8rem, 4rem + 16vw, 21rem);
      font-weight: 860;
      line-height: 0.8;
      letter-spacing: -0.05em;
      font-variant-numeric: tabular-nums;
      color: transparent;
      -webkit-text-stroke: 2px var(--svcp-stroke);
    }

    .svcp-folio {
      display: flex;
      align-items: center;
      gap: 0.875rem;
    }
    .svcp-count {
      display: inline-flex;
      gap: 0.375rem;
      color: var(--color-muted);
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      font-variant-numeric: tabular-nums;
    }
    .svcp-count-num {
      color: var(--color-key);
    }
    .svcp-title {
      max-width: 20ch;
      margin-top: 1.25rem;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .svcp-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'fig' 'body';
      row-gap: 2.25rem;
      margin-top: clamp(1.75rem, 1rem + 2vw, 3rem);
    }

    /* Room around the frame so the crop marks (20px outside it) never overflow. */
    .svcp-fig {
      grid-area: fig;
      padding: 1.25rem 1.5rem;
    }
    .svcp-media {
      aspect-ratio: 4 / 3;
    }
    .svcp-media :global(picture) {
      display: block;
      height: 100%;
    }
    /* Stand-in chip, as on /erga/: inside the image frame, so it never overflows. */
    .svcp-standin {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 1;
      padding: 0.3rem 0.55rem;
      background-color: var(--color-yellow);
      color: var(--color-key);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 720;
      line-height: 1.2;
    }

    .svcp-body {
      grid-area: body;
    }
    .svcp-desc {
      max-width: 42ch;
    }
    .svcp-tags-heading {
      margin-top: 2.25rem;
      margin-bottom: 0.875rem;
    }
    /* Usual jobs as square tag chips, each with a patch of the chapter's plate colour. */
    .svcp-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .svcp-tags > li {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.25rem;
      padding: 0.375rem 0.75rem 0.375rem 0.625rem;
      background-color: var(--color-paper-2);
      box-shadow: inset 0 0 0 1px var(--color-line);
      font-size: 0.9375rem;
      line-height: 1.3;
    }
    .svcp-tags > li::before {
      content: '';
      flex: none;
      width: 0.5rem;
      height: 0.5rem;
      background-color: var(--svcp-ink);
      box-shadow: inset 0 0 0 1px var(--color-key);
    }
    .svcp-cta {
      margin-top: 2.25rem;
      white-space: normal;
      text-align: left;
    }

    /* From 768px the photo and the text share a row, the photo alternating sides. */
    @media (min-width: 48rem) {
      .svcp-grid {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        grid-template-areas: 'fig body';
        column-gap: clamp(1.5rem, 3.5vw, 3.5rem);
        align-items: start;
      }
      .svcp--fig-right .svcp-grid {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        grid-template-areas: 'body fig';
      }
      .svcp-fig {
        padding: 1.5rem;
      }
      .svcp-body {
        padding-top: 1.5rem;
      }
    }
  }
</style>
