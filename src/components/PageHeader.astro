---
/**
 * Header block for inner pages, set as the logo's own lock-up: the four arches stand on a rule
 * and the page's single <h1> hangs under it, as the wordmark sits under the arches in the logo.
 *
 * - The masthead rule (decorative): the press colour bar, a key hairline across the content
 *   width and a registration mark at its end. It is the same strip that opens every section
 *   (Section.astro), set heavier here, so the header and the sections read as one system.
 * - The arches (decorative): drawn as four C/M/Y/K hairline outlines whose feet stand on the
 *   rule, right-aligned to where the hairline ends. They are sized from the title's type
 *   (7 × the display-l size, capped by the content width), so they scale with the h1.
 * - Under the rule, at every width, hang the red spaced label, the h1, the optional intro and the
 *   default slot (chips, notes): the arches above the rule, the type below it.
 *
 * Printing (CSS scroll-driven, where supported, never under reduced motion): at the top of the
 * page only the outlines show; as the page scrolls, a halftone screen of each ink prints into its
 * outline plate by plate in Y, M, C, K order, slightly out of register, then snaps into register.
 * Without support, or under reduced motion, the header shows the finished print, still. The inks
 * overprint with `--blend-ink` (multiply on paper, screen on the dark page); the K plate is the
 * theme's key. The h1 is plain text in the flow and paints at first paint (LCP).
 *
 * The block paints no background: the living background shows through, tinted by `accent`
 * (`data-bg-accent`). Decoration is aria-hidden.
 */
import RegMark from './RegMark.astro';
import ColorBar from './ColorBar.astro';
import { ARCH, ARCH_PLATES } from './logo-paths';
import { capsEl } from '~/lib/text';

interface Props {
  /** Small label above the title; converted to accent-free capitals. */
  label: string;
  title: string;
  intro?: string;
  /** Ink that tints the living background while this header is on screen. */
  accent?: 'cyan' | 'magenta' | 'yellow' | 'key';
  class?: string;
}
const { label, title, intro, accent = 'cyan', class: className } = Astro.props;

/** Back to front (key, yellow, magenta, cyan), as in the logo. */
const plates = [...ARCH_PLATES].reverse();
/** Halftone screen angles, as on press (C 15°, M 75°, Y 0°, K 45°). */
const screenAngle = { c: 15, m: 75, y: 0, k: 45 } as const;
/**
 * Tight box of the four arches in logo space (feet on y = 248), so the feet stand on the rule.
 * Strokes overflow it by half their width (`overflow: visible`).
 */
const VIEW_BOX = '699 60 825 188';
const hasExtra = Astro.slots.has('default');
---

<header class:list={['page-header', className]} data-bg-accent={accent}>
  <div class="wrap ph-inner">
    <div class="ph-mast" aria-hidden="true">
      <svg
        class="ph-arches"
        xmlns="http://www.w3.org/2000/svg"
        viewBox={VIEW_BOX}
        focusable="false"
      >
        <defs>
          {plates.map((p) => (
            <pattern
              id={`ph-screen-${p.id}`}
              width="8"
              height="8"
              patternUnits="userSpaceOnUse"
              patternTransform={`rotate(${screenAngle[p.id]})`}
            >
              <circle cx="4" cy="4" r="2.5" fill={p.color} />
            </pattern>
          ))}
        </defs>
        {plates.map((p) => (
          <g class={`ph-plate ph-plate-${p.id}`}>
            <path
              class="ph-ink"
              d={ARCH}
              transform={`translate(${p.x} 0)`}
              fill={`url(#ph-screen-${p.id})`}
            />
            <path
              class="ph-outline"
              d={ARCH}
              transform={`translate(${p.x} 0)`}
              fill="none"
              stroke={p.color}
              stroke-width="1.25"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
            />
          </g>
        ))}
      </svg>
    </div>

    <div class="ph-rule" aria-hidden="true">
      <ColorBar tints={3} class="ph-bar" />
      <span class="ph-line"></span>
      <RegMark size={18} class="ph-reg" />
    </div>

    <p class="label ph-label">{capsEl(label)}</p>
    <h1 class="display-l ph-title">{title}</h1>
    {intro && <p class="lead muted ph-intro">{intro}</p>}
    {hasExtra && (
      <div class="ph-extra">
        <slot />
      </div>
    )}
  </div>
</header>

<style>
  @layer components {
    .page-header {
      /* The registration mark at the end of the rule, and the gap before it. */
      --ph-reg: 18px;
      --ph-reg-gap: 0.75rem;
      position: relative;
      overflow-x: clip;
      padding-top: clamp(2rem, 1rem + 3.5vw, 5rem);
      padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    }
    .ph-inner {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .ph-mast,
    .ph-rule,
    .ph-label,
    .ph-title,
    .ph-intro,
    .ph-extra {
      grid-column: 1 / -1;
      min-width: 0;
    }

    /* The arches: right-aligned to the end of the hairline, sized from the title's type. */
    .ph-mast {
      justify-self: end;
      width: min(100% - var(--ph-reg) - var(--ph-reg-gap), var(--text-display-l) * 7);
      margin-right: calc(var(--ph-reg) + var(--ph-reg-gap));
      pointer-events: none;
    }
    .ph-arches {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      isolation: isolate;
    }
    .ph-plate {
      mix-blend-mode: var(--blend-ink);
    }

    /* The rule: its hairline runs through the middle of the row, which is pulled up by half its
       height, so the hairline lies exactly under the arches' feet. */
    .ph-rule {
      display: flex;
      align-items: center;
      gap: var(--ph-reg-gap);
      height: var(--ph-reg);
      margin-top: calc(var(--ph-reg) / -2);
    }
    .ph-rule :global(.ph-bar) {
      flex: none;
    }
    .ph-line {
      flex: 1;
      height: 1px;
      background-color: var(--color-key);
    }
    .ph-rule :global(.ph-reg) {
      flex: none;
      color: var(--color-key);
    }

    .ph-label {
      justify-self: start;
      margin-top: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    }
    .ph-title {
      max-width: 18ch;
      margin-top: clamp(1rem, 0.75rem + 0.75vw, 1.5rem);
    }
    .ph-intro {
      max-width: 58ch;
      margin-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    }

    /*
     * Printing on scroll: each plate's halftone prints into its outline in Y, M, C, K order,
     * arriving out of register and snapping into it. Offsets are in logo units (about 0.7 px
     * each on a wide screen). Where unsupported, or under reduced motion, the print is finished.
     */
    @supports (animation-timeline: scroll()) {
      @media (prefers-reduced-motion: no-preference) {
        .ph-ink {
          animation: ph-print linear both;
          animation-timeline: scroll(root block);
        }
        .ph-plate-y .ph-ink {
          --ph-dx: -12px;
          --ph-dy: 16px;
          animation-range: 0rem 10rem;
        }
        .ph-plate-m .ph-ink {
          --ph-dx: 22px;
          --ph-dy: -10px;
          animation-range: 2.5rem 12.5rem;
        }
        .ph-plate-c .ph-ink {
          --ph-dx: -24px;
          --ph-dy: -12px;
          animation-range: 5rem 15rem;
        }
        .ph-plate-k .ph-ink {
          --ph-dx: 8px;
          --ph-dy: 6px;
          animation-range: 7.5rem 17.5rem;
        }
      }
    }
  }

  @keyframes ph-print {
    0% {
      opacity: 0;
      translate: var(--ph-dx, 0) var(--ph-dy, 0);
    }
    45% {
      opacity: 1;
      translate: calc(var(--ph-dx, 0px) * 0.7) calc(var(--ph-dy, 0px) * 0.7);
    }
    80% {
      translate: calc(var(--ph-dx, 0px) * -0.12) calc(var(--ph-dy, 0px) * -0.12);
    }
    100% {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
