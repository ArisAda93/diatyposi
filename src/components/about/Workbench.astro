---
/**
 * /etaireia/ section 01 (“Πώς δουλεύουμε”): the studio's work table as one photograph, with four
 * numbered points on the stages of a job (sketch, logo proposals, colours, proof). The finished
 * work around them (cards, a T-shirt, a mug, stickers, a banner, an invitation, 3D prints, a social
 * post) shows the rest of the services. The page lists the four points beside it
 * (src/pages/etaireia.astro), so the markers here are decorative.
 *
 * The photograph is AI-generated (CREDITS.md) and carries the “Ενδεικτική εικόνα” chip, as the
 * service photos do. Its frame is 4 / 3, the photo's own ratio, so the markers' percentages
 * always sit on the same objects.
 */
import { Picture } from 'astro:assets';
import workbench from '~/assets/about/workbench.jpg';
import { aboutText } from '~/i18n/pages/about';
import { t } from '~/i18n/ui';

const text = aboutText.el.workbench;
/** Marker positions in % of the photo (left, top), in step order; plate ink per step (fixed key). */
const markers = [
  { x: 12, y: 55, ink: '--color-cyan' },
  { x: 34, y: 46, ink: '--color-magenta' },
  { x: 32, y: 66, ink: '--color-yellow' },
  { x: 61, y: 48, ink: '--ink-fixed' },
] as const;
// The photo takes the full column below 64rem and 7 ⁄ 12 of the wrap (max ~ 47rem) from 64rem.
const sizes = '(min-width: 64rem) min(47rem, 56vw), calc(100vw - 2rem)';
---

<figure class="wb">
  <div class="wb-frame crop-frame">
    <div class="wb-media media">
      <Picture
        src={workbench}
        alt={text.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 960, 1280, 1600, 2000]}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
      <span class="wb-standin">{t('standInLabel')}</span>
      <ol class="wb-markers" role="list" aria-hidden="true">
        {markers.map((m, i) => (
          <li class="wb-marker" style={`--wb-x: ${m.x}%; --wb-y: ${m.y}%; --wb-ink: var(${m.ink})`}>
            {i + 1}
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>

<style>
  @layer components {
    .wb {
      margin: 0;
    }
    .wb-media {
      aspect-ratio: 4 / 3;
      box-shadow: 0 1.75rem 3rem -2rem rgb(34 31 32 / 0.4);
    }
    @media not print {
      :global(html[data-theme='dark']) .wb-media {
        box-shadow:
          0 0 0 1px var(--color-line),
          0 1.75rem 3rem -1.75rem rgb(0 0 0 / 0.65);
      }
    }
    .wb-media :global(picture) {
      display: block;
      height: 100%;
    }
    /* No hover zoom (global .media): the markers must stay on their objects. */
    .wb-media:hover :global(img) {
      transform: none;
    }
    /* Stand-in chip, as on the service photos: inside the frame. */
    .wb-standin {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 1;
      padding: 0.3rem 0.55rem;
      background-color: var(--color-yellow);
      color: var(--ink-fixed);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 720;
      line-height: 1.2;
    }
    .wb-markers {
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      pointer-events: none;
    }
    /* A white disc with the step's plate ink as its ring; fixed colours, so it reads on the photo
       in both themes. */
    .wb-marker {
      --wb-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.25rem);
      position: absolute;
      left: calc(var(--wb-x) - var(--wb-size) / 2);
      top: calc(var(--wb-y) - var(--wb-size) / 2);
      display: grid;
      place-items: center;
      width: var(--wb-size);
      height: var(--wb-size);
      border-radius: 50%;
      background-color: #ffffff;
      box-shadow:
        inset 0 0 0 0.2rem var(--wb-ink),
        0 0.25rem 0.75rem rgb(0 0 0 / 0.28);
      color: var(--ink-fixed);
      font-family: var(--font-display);
      font-size: clamp(0.8125rem, 0.7rem + 0.3vw, 0.9375rem);
      font-weight: 860;
      line-height: 1;
    }
  }
</style>
