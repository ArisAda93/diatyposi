---
/**
 * The owner's four values on /etaireia/ (section 02, a `plain` Section) as four plate-coloured
 * blocks: cyan and yellow fills with ink text in both themes (`.tokens-light`), magenta only as a
 * graphic band and halftone (never behind text), and a solid ink block (`.on-ink`; darker than
 * the page with a hairline edge in the dark theme). Hovering a block sends C/M/Y ghosts of its
 * plate letter out of register and back, and turns its registration mark. The section paints
 * nothing else, so the living background shows between the blocks (`data-bg-accent`).
 */
import RegMark from '../RegMark.astro';
import Section from '../Section.astro';
import { ownerCopy } from '~/data/site';
import { aboutText } from '~/i18n/pages/about';

const text = aboutText.el;
const plates = ['c', 'm', 'y', 'k'] as const;
const blocks = ownerCopy.el.values.map((value, i) => ({
  value,
  note: text.valueNotes[value],
  plate: plates[i] ?? 'k',
}));
---

<Section
  id="values"
  index="02"
  label={text.valuesLabel}
  title={text.valuesTitle}
  accent="magenta"
  class="values"
>
  <ul class="values-grid">
    {blocks.map((b) => (
      <li
        class:list={[
          'value',
          `value-${b.plate}`,
          { 'on-ink': b.plate === 'k', 'tokens-light': b.plate === 'c' || b.plate === 'y' },
        ]}
        data-reveal="depth"
        data-tilt
      >
        <div class="value-top" aria-hidden="true">
          <span class="value-plate">{b.plate.toUpperCase()}</span>
          <RegMark size={22} class="value-reg" />
        </div>
        <div>
          <h3 class="h3 value-title">{b.value}</h3>
          <p class="value-note">{b.note}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  @layer components {
    .values-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--grid-gap);
    }
    .value {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2.5rem;
      min-height: 17rem;
      padding: clamp(1.25rem, 1rem + 1vw, 2rem);
      overflow: hidden;
      color: var(--color-key);
    }
    .value-c {
      background-color: var(--color-cyan);
    }
    .value-y {
      background-color: var(--color-yellow);
    }
    .value-k {
      background-color: var(--color-ink);
      color: var(--color-paper);
    }
    /* Magenta stays a graphic: a solid band on the left edge and a halftone field behind the
       plate letter. The text sits on paper. */
    .value-m {
      background-color: var(--color-paper-2);
      border-left: 0.75rem solid var(--color-magenta);
    }
    .value-m::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 60%;
      height: 45%;
      color: var(--color-magenta);
      background-image: radial-gradient(circle at center, currentColor 0 2px, transparent 2.6px);
      background-size: 9px 9px;
      -webkit-mask-image: linear-gradient(225deg, #000 10%, transparent 75%);
      mask-image: linear-gradient(225deg, #000 10%, transparent 75%);
      pointer-events: none;
    }
    .value-top {
      position: relative;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
    }
    .value-plate {
      font-family: var(--font-display);
      font-size: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
      font-weight: 860;
      line-height: 0.8;
      letter-spacing: -0.04em;
    }
    .value-top :global(.value-reg) {
      transition: transform var(--dur-slow) var(--ease-snap);
    }
    .value-title {
      position: relative;
      text-wrap: balance;
    }
    @media (prefers-reduced-motion: no-preference) and (hover: hover) {
      .value:hover .value-plate {
        animation: value-plate-reg 700ms var(--ease-snap);
      }
      .value:hover :global(.value-reg) {
        transform: rotate(90deg);
      }
    }
    .value-note {
      position: relative;
      margin-top: 0.75rem;
      max-width: 34ch;
      text-wrap: pretty;
    }

    /* Phones: one card per row, sized by its content instead of a fixed poster height (the
       plate letter and the text would otherwise float apart in a mostly empty card). */
    @media (max-width: 39.99rem) {
      .value {
        min-height: 0;
        gap: 2rem;
      }
    }
    @media (max-width: 359.98px) {
      .value-plate {
        font-size: 3rem;
      }
    }

    @media (min-width: 40rem) {
      .values-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 64rem) {
      .values-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: start;
      }
      .value {
        min-height: 22rem;
      }
      /* Staggered like four plates laid on the table, not a row of identical cards. */
      .value-m {
        margin-top: 3rem;
      }
      .value-y {
        margin-top: 1.5rem;
      }
      .value-k {
        margin-top: 4.5rem;
      }
    }
  }

  /* The plate letter's C/M/Y copies split off and snap back into register. */
  @keyframes value-plate-reg {
    0%,
    100% {
      text-shadow:
        0 0 0 transparent,
        0 0 0 transparent,
        0 0 0 transparent;
    }
    35% {
      text-shadow:
        -5px -3px 0 color-mix(in srgb, var(--color-cyan) 90%, transparent),
        5px -1px 0 color-mix(in srgb, var(--color-magenta) 90%, transparent),
        -2px 5px 0 color-mix(in srgb, var(--color-yellow) 90%, transparent);
    }
  }
</style>
