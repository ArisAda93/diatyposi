---
/**
 * Home “Μία ιδέα. Παντού.”: one partner takes the visitor's idea from a sketch to a brand on
 * everything they need. Section 02 of the home page, in the shared section shell
 * (src/components/Section.astro: index, label, heading, lead).
 *
 * Desktop (from 64rem, JS on, motion allowed): two columns. Left, a sticky stage (CSS
 * `position: sticky`, nothing pinned) where one sample mark is sketched, printed plate by plate
 * and carried along an arc onto a card, a T-shirt, a shop front, a mug and a phone
 * (src/scripts/idea-journey.ts). Scrolling only picks the step; the stage plays each change by
 * itself. Each object arrives as a line sketch, and its hyper-realistic photograph
 * (src/assets/journey/, generated from the sketch, same composition) then prints over it in
 * halftone plates (src/scripts/journey-print/), holds, and flies into its slot on the contact sheet
 * under the stage. A Sketch / Product switch (pointer) shows the step's sketch again. Right, the seven steps on
 * one spine that fills in the steps' plate inks up to the middle of the viewport, with a node per
 * step; each title links to its step. Otherwise (phones, reduced motion, no JS) each step shows
 * its own still: the sketch with its photograph over it (journey/JourneyStill.astro); with motion
 * allowed the photograph prints over the sketch as the step scrolls in, otherwise it is simply
 * shown. The illustrations repeat what the steps say, so they are hidden from assistive
 * technology.
 *
 * Closing block: toggle chips for the products in the story; the button links to the quote form
 * with every picked service pre-selected and counts them. Without JS the chips are hidden and the
 * button links to the plain quote form.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import Section from '~/components/Section.astro';
import JourneyArt from './journey/JourneyArt.astro';
import JourneyStill from './journey/JourneyStill.astro';
import { routes, serviceBySlug, services } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { JOURNEY_STEPS, journeyChoices, journeyInk } from '~/scripts/idea-journey';

const copy = homeText.el.journey;
const pad = (n: number): string => String(n).padStart(2, '0');
const total = pad(JOURNEY_STEPS.length);

const steps = JOURNEY_STEPS.map((step, index) => ({
  ...step,
  num: pad(index + 1),
  anchor: `journey-${step.id}`,
  ink: journeyInk(index),
  text: copy.steps[step.id],
  href: `${routes.services}#${step.service}`,
  linkLabel: serviceBySlug(step.service)?.text.el.short ?? copy.steps[step.id].title,
}));
// Chips follow the owner's order of services (src/data/site.ts), not the order of the story.
const choices = journeyChoices(services.map((service) => service.slug)).map((slug) => ({
  slug,
  label: copy.chooser.options[slug],
}));
/** Stage photographs (one per step, story order): one 1024 px WebP each, loaded by the stage. */
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/journey/*.jpg', {
  eager: true,
});
const stagePhotos = await Promise.all(
  JOURNEY_STEPS.map(async (step) => {
    const file = photoFiles[`/src/assets/journey/${step.id}.jpg`];
    if (!file) throw new Error(`Journey photo "src/assets/journey/${step.id}.jpg" is missing.`);
    const image = await getImage({ src: file.default, width: 1024, format: 'webp', quality: 80 });
    return image.src;
  }),
);
const promiseInks = ['c', 'm', 'y'] as const;
---

<Section
  id="apo-tin-idea"
  index="02"
  label={copy.label}
  titleId="journey-title"
  lead={copy.lead}
  accent="magenta"
>
  <h2 slot="title" id="journey-title" class="h2 ij-title">
    {copy.heading}
  </h2>
  <div slot="head-extra" class="ij-deco" aria-hidden="true">
    <span class="ij-deco-dots halftone" data-parallax="-0.12"></span>
    <span class="ij-deco-target" data-parallax="0.18">
      <svg viewBox="0 0 100 100" focusable="false">
        <circle cx="50" cy="50" r="22"></circle>
        <circle cx="50" cy="50" r="9"></circle>
        <path d="M50 4V96M4 50H96"></path>
      </svg>
    </span>
  </div>

  <div class="ij" data-journey>
    <div class="ij-grid" data-journey-grid data-motion="off">
      <div class="ij-stage-col" aria-hidden="true">
        <div class="ij-stage" data-journey-stage data-stage="blank">
          <div
            class="ij-stage-art crop-frame"
            data-journey-art
            data-journey-photos={JSON.stringify(stagePhotos)}
          >
            <div class="ij-print" data-journey-print></div>
            <JourneyArt mode="stage" />
            <div class="ij-view">
              <button type="button" tabindex="-1" aria-pressed="false" data-journey-view="0">
                {copy.view.sketch}
              </button>
              <button type="button" tabindex="-1" aria-pressed="true" data-journey-view="1">
                {copy.view.product}
              </button>
            </div>
          </div>
          <div class="ij-readout">
            <ol class="ij-sheet" role="list">
              {steps.map((step) => (
                <li
                  class="ij-slot"
                  data-journey-slot={step.id}
                  style={`--ij-ink: var(--color-${step.ink})`}
                >
                  <span class="ij-slot-num">{step.num}</span>
                </li>
              ))}
            </ol>
            <span class="ij-count" data-journey-count>
              01 / {total}
            </span>
          </div>
        </div>
      </div>

      <div class="ij-steps-col" data-journey-steps>
        <span class="ij-spine" aria-hidden="true">
          <span class="ij-spine-fill" data-journey-fill></span>
        </span>
        <ol class="ij-steps" role="list">
          {steps.map((step) => (
            <li
              class="ij-step"
              id={step.anchor}
              data-journey-step={step.id}
              style={`--ij-ink: var(--color-${step.ink})`}
            >
              <div class="ij-still" aria-hidden="true">
                <JourneyStill step={step.id} />
              </div>
              <div class="ij-step-body">
                <span class="ij-node" aria-hidden="true" data-journey-node />
                <p class="ij-step-num" aria-hidden="true">
                  {step.num} / {total}
                </p>
                <h3 class="h3 ij-step-title">
                  <a href={`#${step.anchor}`} class="ij-step-goto" data-journey-goto>
                    {step.text.title}
                  </a>
                </h3>
                <p class="muted ij-step-text">{step.text.text}</p>
                <a href={step.href} class="ij-step-link">
                  <span class="link">{step.linkLabel}</span>
                  <Icon name="arrow-up-right" size={18} />
                </a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="ij-choose">
      <div class="ij-choose-main">
        <h3 id="journey-choose-title" class="ij-choose-title">
          {copy.chooser.heading}
        </h3>
        <p id="journey-choose-hint" class="muted ij-js-only mt-4 max-w-[52ch]">
          {copy.chooser.hint}
        </p>
        <div
          class="ij-chips ij-js-only"
          role="group"
          aria-labelledby="journey-choose-title"
          aria-describedby="journey-choose-hint"
        >
          {choices.map((choice) => (
            <button
              type="button"
              class="ij-chip"
              aria-pressed="false"
              data-journey-choice={choice.slug}
              disabled
            >
              {choice.label}
            </button>
          ))}
        </div>
        <a href={routes.quote} class="btn btn-primary ij-cta" data-journey-cta>
          <span data-journey-cta-label>{copy.chooser.cta.none}</span>
          <Icon name="arrow-right" size={20} />
        </a>
        <p class="sr-only" role="status" aria-live="polite" data-journey-status></p>
      </div>

      <ul class="ij-promises" role="list">
        {copy.promises.map((promise, i) => (
          <li>
            <span class={`ij-sw ij-sw-${promiseInks[i % promiseInks.length]}`} aria-hidden="true" />
            <span>{promise}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<script>
  import { initIdeaJourney } from '~/scripts/idea-journey';
  import { initJourneyStills } from '~/scripts/journey-stills';

  initIdeaJourney();
  const journey = document.querySelector<HTMLElement>('[data-journey]');
  if (journey) initJourneyStills(journey);
</script>

<style>
  @layer components {
    /* ---------------------------------------------------------------------------------------- */
    /* Head (in the section shell's head)                                                       */
    /* ---------------------------------------------------------------------------------------- */

    .ij-title {
      max-width: 18ch;
    }
    /* Decorative: a registration target over a magenta halftone patch, on wide screens only. It
       sits in the shell's head aside (in flow, on the right of the heading). */
    .ij-deco {
      display: none;
    }
    .ij-deco-dots {
      position: absolute;
      top: 0.5rem;
      right: 3.5rem;
      width: clamp(8rem, 11vw, 11rem);
      aspect-ratio: 4 / 3;
      color: var(--color-magenta);
      opacity: 0.55;
      mix-blend-mode: var(--blend-ink);
      -webkit-mask-image: radial-gradient(closest-side, #000 35%, transparent);
      mask-image: radial-gradient(closest-side, #000 35%, transparent);
    }
    .ij-deco-target {
      position: absolute;
      top: 2.5rem;
      right: 0.5rem;
      width: clamp(5rem, 7vw, 7rem);
    }
    .ij-deco-target svg {
      width: 100%;
      height: auto;
      fill: none;
      stroke: var(--color-key);
      stroke-width: 1;
    }

    /* ---------------------------------------------------------------------------------------- */
    /* Steps: still illustrations by default (phones, reduced motion, no JS)                     */
    /* ---------------------------------------------------------------------------------------- */

    .ij-stage-col,
    .ij-spine,
    .ij-node {
      display: none;
    }
    .ij-steps {
      border-top: 1px solid var(--color-line);
    }
    .ij-step {
      display: grid;
      gap: 1.25rem;
      padding-block: 2rem 2.25rem;
      border-bottom: 1px solid var(--color-line);
    }
    .ij-still {
      width: min(100%, 22rem);
    }
    .ij-step-num {
      margin-bottom: 0.625rem;
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      font-variant-numeric: tabular-nums;
      color: var(--color-muted);
      transition: color var(--dur-base) var(--ease-out);
    }
    .ij-step-title {
      margin-bottom: 0.625rem;
      transition: color var(--dur-base) var(--ease-out);
    }
    /* The title links to its own step; its underline draws under every line on hover. */
    .ij-step-goto {
      color: inherit;
      text-decoration: none;
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 0 2px;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      transition: background-size var(--dur-base) var(--ease-out);
    }
    .ij-step-goto:is(:hover, :focus-visible) {
      background-size: 100% 2px;
    }
    .ij-step-text {
      max-width: 42ch;
    }
    .ij-step-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-top: 0.5rem;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--color-key);
      text-decoration: none;
    }
    .ij-step-link :global(svg) {
      flex: none;
      transition: transform var(--dur-base) var(--ease-out);
    }
    @media (prefers-reduced-motion: no-preference) {
      .ij-step-link:is(:hover, :focus-visible) :global(svg) {
        transform: translate(2px, -2px);
      }
    }

    @media (min-width: 48rem) {
      .ij-step {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        align-items: center;
        gap: var(--grid-gap) clamp(2rem, 4vw, 4rem);
      }
      .ij-still {
        width: 100%;
        max-width: 26rem;
      }
    }

    /* ---------------------------------------------------------------------------------------- */
    /* Live stage: wide screens with JS and motion (the same query as idea-journey.ts)           */
    /* ---------------------------------------------------------------------------------------- */

    @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
      :global(html:not(.no-js)) .ij-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
      }
      :global(html:not(.no-js)) .ij-stage-col {
        display: block;
        grid-column: 1 / span 6;
      }
      :global(html:not(.no-js)) .ij-steps-col {
        /* The spine's x and the steps' indent from it. */
        --ij-spine-x: 0.4375rem;
        --ij-indent: 2.25rem;
        position: relative;
        grid-column: 8 / span 5;
      }
      :global(html:not(.no-js)) .ij-steps {
        border-top: 0;
      }
      :global(html:not(.no-js)) .ij-step {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        /* The stage plays each change by itself, so a step needs no extra scroll of its own. */
        min-height: 70svh;
        padding-block: 2rem;
        padding-left: var(--ij-indent);
        border-bottom: 0;
      }
      :global(html:not(.no-js)) .ij-step-body {
        position: relative;
      }
      :global(html:not(.no-js)) .ij-still {
        display: none;
      }

      /* The spine: a hairline from the first node to the last (measured by the script), filled
         in the steps' plate inks up to the reading line. */
      .ij.is-live .ij-spine {
        position: absolute;
        top: var(--ij-spine-top, 0);
        left: var(--ij-spine-x);
        display: block;
        width: 2px;
        height: var(--ij-spine-h, 0);
        background-color: var(--color-line);
        pointer-events: none;
      }
      .ij-spine-fill {
        position: absolute;
        inset: 0;
        clip-path: inset(0 0 calc(100% - var(--ij-fill, 0) * 100%) 0);
      }
      /* A node per step, on the spine beside the step number. Ahead: an empty square. Passed:
         printed in the step's ink. Current: inked, key-edged and a little larger. */
      .ij.is-live .ij-node {
        position: absolute;
        top: 0.72rem;
        left: calc(var(--ij-spine-x) + 1px - var(--ij-indent));
        display: block;
        width: 0.75rem;
        height: 0.75rem;
        background-color: var(--color-paper);
        box-shadow: inset 0 0 0 2px var(--color-line);
        transform: translate(-50%, -50%);
        transition:
          background-color var(--dur-base) var(--ease-out),
          box-shadow var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-snap);
      }
      .ij.is-live .ij-step.is-read .ij-node {
        background-color: var(--ij-ink);
        box-shadow: inset 0 0 0 1px var(--color-key);
      }
      .ij.is-live .ij-step.is-active .ij-node {
        background-color: var(--ij-ink);
        box-shadow: inset 0 0 0 2px var(--color-key);
        transform: translate(-50%, -50%) scale(1.3);
      }
    }

    .ij-stage {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
    .ij-stage-art {
      /* Above the contact sheet, so a photograph flies over the slots into its own. */
      position: relative;
      z-index: 1;
      width: min(100% - 2.5rem, 100svh - var(--header-h) - 14rem);
      margin-inline: auto;
      transform-origin: 50% 50%;
      will-change: transform;
    }
    /* The photographs, under the line art and the same square as its view box
       (src/scripts/journey-print/). */
    .ij-print {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .ij-print :global(.ij-print-canvas),
    .ij-print :global(.ij-print-still) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    .ij-print :global(.ij-print-still) {
      object-fit: cover;
      opacity: 0;
    }
    .ij-stage-art :global(.ij-art) {
      position: relative;
    }
    /* Sketch / Product switch (pointer shortcut; idea-journey.ts un-prints and re-prints the shown
       step). On the stage's corner, above the art. */
    .ij-view {
      display: none;
    }
    /* Only once photographs can be printed (idea-journey.ts adds .has-print). */
    .ij.has-print .ij-view {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 2;
      display: flex;
      padding: 3px;
      gap: 2px;
      background-color: color-mix(in srgb, var(--color-paper) 88%, transparent);
      box-shadow: inset 0 0 0 1px var(--color-line);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .ij-view button {
      min-height: 2rem;
      padding: 0.25rem 0.75rem;
      border: 0;
      background: none;
      color: var(--color-muted);
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear;
    }
    .ij-view button[aria-pressed='true'] {
      background-color: var(--color-key);
      color: var(--color-paper);
    }
    @media (hover: hover) {
      .ij-view button[aria-pressed='false']:hover {
        color: var(--color-key);
      }
    }
    .ij-readout {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: min(100% - 2.5rem, 100svh - var(--header-h) - 14rem);
      margin: 1.75rem auto 0;
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      font-variant-numeric: tabular-nums;
    }
    /* The contact sheet: a slot per step. Each fills with its product's photograph as the
       photograph flies off the stage into it (idea-journey.ts adds .is-done and .is-current);
       by the last step it holds the whole journey. Pointer users can click a slot to go there. */
    .ij-sheet {
      display: grid;
      flex: 1;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.375rem;
      max-width: 26rem;
    }
    .ij-slot {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
      background-color: var(--color-paper);
      box-shadow: inset 0 0 0 1px var(--color-line);
      cursor: pointer;
      transition: box-shadow var(--dur-base) var(--ease-out);
    }
    .ij-slot-num {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
      color: var(--color-muted);
    }
    /* Added by idea-journey.ts once the step's photograph has loaded (or the slot fills). */
    .ij-slot :global(.ij-slot-img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(0.6);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-snap);
    }
    .ij-slot.is-done :global(.ij-slot-img) {
      opacity: 1;
      transform: none;
    }
    .ij-slot.is-current {
      box-shadow:
        inset 0 0 0 2px var(--color-key),
        0 3px 0 -1px var(--ij-ink);
    }
    @media (hover: hover) {
      .ij-slot:hover {
        box-shadow: inset 0 0 0 2px var(--color-key);
      }
    }

    /* Plate swatches (promises). */
    .ij-sw {
      display: inline-block;
      flex: none;
      width: 0.75rem;
      height: 0.75rem;
      box-shadow: inset 0 0 0 1px var(--color-key);
      transition: background-color var(--dur-base) var(--ease-out);
    }
    .ij-sw-c {
      background-color: var(--color-cyan);
    }
    .ij-sw-m {
      background-color: var(--color-magenta);
    }
    .ij-sw-y {
      background-color: var(--color-yellow);
    }
    .ij-sw-k {
      background-color: var(--color-key);
    }
    /* Active step (idea-journey.ts adds .is-live, .is-active and .is-read). Muted stays AA. */
    .ij.is-live .ij-step:not(.is-active) .ij-step-title {
      color: var(--color-muted);
    }
    .ij.is-live .ij-step.is-active .ij-step-num {
      color: var(--color-red);
    }

    /* ---------------------------------------------------------------------------------------- */
    /* Chooser                                                                                  */
    /* ---------------------------------------------------------------------------------------- */

    .ij-choose {
      display: grid;
      gap: 2.5rem;
      margin-top: clamp(3rem, 6vw, 6rem);
      padding-top: clamp(2rem, 4vw, 3rem);
      border-top: 2px solid var(--color-key);
    }
    .ij-choose-title {
      font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
      line-height: 1.1;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    :global(.no-js) .ij-js-only {
      display: none;
    }
    .ij-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
      margin-block: 1.5rem 2rem;
      padding: 0 6px 6px 0;
    }
    .ij-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.75rem;
      padding: 0.5rem 1rem;
      border: 2px solid var(--color-key);
      background-color: transparent;
      color: var(--color-key);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 650;
      line-height: 1.2;
      text-align: left;
      cursor: pointer;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear,
        box-shadow var(--dur-base) var(--ease-out);
    }
    /* A square tick box: empty, then filled with yellow when pressed. */
    .ij-chip::before {
      content: '';
      flex: none;
      width: 0.75rem;
      height: 0.75rem;
      box-shadow: inset 0 0 0 1.5px currentColor;
    }
    /* Hover-capable pointers only: on touch the hover sticks after a tap, and a chip just
       switched off would keep a tint that reads as half pressed. */
    @media (hover: hover) {
      .ij-chip:hover {
        background-color: var(--color-paper-2);
      }
    }
    .ij-chip[aria-pressed='true'] {
      background-color: var(--color-key);
      color: var(--color-paper);
      box-shadow:
        3px 3px 0 var(--color-cyan),
        6px 6px 0 var(--color-magenta);
    }
    .ij-chip[aria-pressed='true']::before {
      background-color: var(--color-yellow);
      box-shadow: none;
    }
    /* Dark mode: the pressed chip is light, so the yellow tick keeps a dark edge to read. */
    @media not print {
