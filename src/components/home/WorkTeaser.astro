---
/**
 * Home work teaser (section 03, a `plain` Section: index, label, heading and the “see all” link
 * in the shared head): the featured portfolio items in an editorial, staggered layout of
 * different sizes on the 12-column grid. Each tile links to /erga/; stand-in images carry a
 * visible label (ink on yellow in both themes). Phones also close the set with a full-width link.
 *
 * Depth: every tile sits on its own parallax layer (`data-parallax`, motion.ts) with a different
 * speed, so the set separates into planes while scrolling. The speeds stay small (neighbours
 * differ by at most 0.08) so stacked tiles on phones never meet. The layer is a wrapper because
 * the item itself carries the depth entry (`transform`) and the link the pointer tilt.
 * Captions: index number, category label, title with an arrow that slides in on hover and focus.
 */
import Icon from '~/components/Icon.astro';
import Photo from '~/components/Photo.astro';
import Section from '~/components/Section.astro';
import { portfolio, routes, serviceBySlug } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { t } from '~/i18n/ui';
import { capsEl } from '~/lib/text';

const copy = homeText.el.work;
const featured = portfolio.filter((item) => item.featured);

/** Rendered width per position (see the grid below): 7, 4, 4 and 5 of 12 columns on desktop. */
const sizes = [
  '(min-width: 96rem) 826px, (min-width: 64rem) 54vw, (min-width: 48rem) 46vw, 92vw',
  '(min-width: 96rem) 460px, (min-width: 64rem) 30vw, (min-width: 48rem) 46vw, 76vw',
  '(min-width: 96rem) 460px, (min-width: 64rem) 30vw, (min-width: 48rem) 46vw, 76vw',
  '(min-width: 96rem) 580px, (min-width: 64rem) 37vw, (min-width: 48rem) 46vw, 92vw',
];
/** Parallax speed per position: the anchor tile still, the others leading or lagging a little. */
const speeds = ['0', '-0.06', '0.02', '-0.05'];
---

<Section
  id="work"
  index="03"
  label={copy.label}
  title={copy.heading}
  link={{ href: routes.work, text: copy.allLink }}
  accent="magenta"
  class="work"
>
  <ul class="work-grid" role="list">
    {featured.map((item, i) => {
      const category = serviceBySlug(item.service)?.text.el.short;
      return (
        <li class={`work-item work-pos-${i % 4}`} data-reveal="depth">
          <div class="work-plx" data-parallax={speeds[i % 4] ?? '0'}>
            <a href={routes.work} class="work-link" data-tilt>
              <div class="media media-halftone work-media">
                <Photo image={item.image} alt={item.text.el.alt} sizes={sizes[i % 4] ?? '92vw'} />
                {item.standIn && <span class="work-chip">{t('standInLabel')}</span>}
              </div>
              <div class="work-cap">
                <p class="work-meta">
                  <span class="work-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {category && <span class="label">{capsEl(category)}</span>}
                </p>
                <h3 class="h3 work-title">
                  <span>{item.text.el.title}</span>
                  <Icon name="arrow-up-right" size={22} class="work-title-arrow" />
                </h3>
              </div>
            </a>
          </div>
        </li>
      );
    })}
  </ul>

  <a href={routes.work} class="btn btn-secondary work-all-end">
    <span>{copy.allLink}</span>
    <Icon name="arrow-right" size={20} />
  </a>
</Section>

<style>
  @layer components {
    /* Phones: besides the link under the heading, a full-width button closes the set. */
    .work-all-end {
      width: 100%;
      margin-top: clamp(2.5rem, 6vw, 3.5rem);
    }

    .work-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem var(--grid-gap);
    }
    .work-link {
      display: block;
      text-decoration: none;
      color: var(--color-key);
    }
    .work-media {
      aspect-ratio: var(--ar, 4 / 3);
    }
    .work-media :global(img) {
      position: absolute;
      inset: 0;
    }
    .work-chip {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 1;
      padding: 0.3rem 0.6rem;
      background-color: var(--color-yellow);
      color: var(--ink-fixed);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 720;
      line-height: 1.3;
    }

    .work-cap {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-top: 1rem;
    }
    .work-meta {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
    }
    /* A long category (“BANNERS, ΑΦΙΣΕΣ & ΜΟΥΣΑΜΑΔΕΣ”) wraps into balanced lines that hang beside
       the number; below 64rem, where the narrower tiles make it wrap, the lines get air. */
    .work-meta .label {
      min-width: 0;
      text-wrap: balance;
    }
    @media (max-width: 63.99rem) {
      .work-meta .label {
        line-height: 1.45;
      }
    }
    .work-num {
      font-family: var(--font-display);
      font-size: var(--text-label);
      font-weight: 750;
      letter-spacing: 0.12em;
      color: var(--color-muted);
      font-variant-numeric: tabular-nums;
    }
    .work-title {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .work-title > span {
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 0 2px;
      transition: background-size var(--dur-base) var(--ease-out);
    }
    .work-title :global(.work-title-arrow) {
      flex: none;
      margin-top: 0.1em;
      opacity: 0;
      transform: translate(-6px, 6px);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-out);
    }
    .work-link:focus-visible .work-title > span {
      background-size: 100% 2px;
    }
    .work-link:focus-visible .work-title :global(.work-title-arrow) {
      opacity: 1;
      transform: none;
    }
    .work-link:focus-visible .work-num {
      color: var(--color-key);
    }
    /* Hover only where the pointer hovers: a tap must not leave the underline drawn. */
    @media (hover: hover) {
      .work-link:hover .work-title > span {
        background-size: 100% 2px;
      }
      .work-link:hover .work-title :global(.work-title-arrow) {
        opacity: 1;
        transform: none;
      }
      .work-link:hover .work-num {
        color: var(--color-key);
      }
    }
    .work-link:focus-visible {
      outline-offset: 6px;
    }
    /* Touch screens have no hover to reveal the arrow, so it shows at rest: the tile reads as a
       link there too. */
    @media (hover: none) {
      .work-title :global(.work-title-arrow) {
        opacity: 1;
        transform: none;
      }
    }

    .work-pos-0 {
      --ar: 4 / 3;
    }
    .work-pos-1 {
      --ar: 1 / 1;
      width: 82%;
      margin-left: auto;
    }
    .work-pos-2 {
      --ar: 4 / 5;
      width: 82%;
    }
    .work-pos-3 {
      --ar: 4 / 3;
    }

    @media (min-width: 48rem) {
      .work-all-end {
        display: none;
      }
      .work-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: clamp(2.5rem, 5vw, 4rem);
      }
      .work-pos-1,
      .work-pos-2 {
        width: auto;
        margin-left: 0;
      }
      .work-pos-1,
      .work-pos-3 {
        margin-top: clamp(3rem, 8vw, 6rem);
      }
    }

    @media (min-width: 64rem) {
      .work-grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
      }
      .work-pos-0 {
        grid-column: 1 / span 7;
      }
      .work-pos-1 {
        grid-column: 9 / span 4;
        align-self: end;
        margin-top: 0;
      }
      .work-pos-2 {
        grid-column: 2 / span 4;
      }
      .work-pos-3 {
        grid-column: 7 / span 5;
        margin-top: clamp(4rem, 8vw, 8rem);
      }
    }
  }
</style>
