---
/**
 * The process poster: a press sheet with crop and registration marks, built from four plates
 * (Y, M, C, K) that overprint with multiply. Decorative. In its default state all four plates are
 * printed; src/scripts/process.ts takes plates away and prints them back as the steps scroll by.
 * Arch geometry comes from the logo (logo-paths.ts), not redrawn.
 */
import { ARCH } from '~/components/logo-paths';
import { ownerCopy, site } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { capsEl } from '~/lib/text';

// The logo arch scaled into the poster; the cyan arch is the next logo plate to the right.
const scale = 0.66;
const round = (n: number) => Number(n.toFixed(2));
const archY = round(352 - 248 * scale);
const archM = `translate(${round(36 - 701 * scale)} ${archY}) scale(${scale})`;
const archC = `translate(${round(36 - 701 * scale + 120 * scale)} ${archY}) scale(${scale})`;

// Trim box 28..372 × 28..532; crop marks sit in the margin, 6 units from the trim.
const cropMarks = [
  'M6 28H22M28 6V22',
  'M378 28H394M372 6V22',
  'M6 532H22M28 538V554',
  'M378 532H394M372 538V554',
].join('');

const regMark = (cx: number, cy: number) => `M${cx - 8} ${cy}H${cx + 8}M${cx} ${cy - 8}V${cy + 8}`;
---

<svg
  class="pp-svg"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 560"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id="pp-bleed">
      <rect x="20" y="20" width="360" height="520"></rect>
    </clipPath>
    {/* Halftone dots, sized for the arch's scaled user space (about 7 poster units pitch). */}
    <pattern id="pp-dots" width="11" height="11" patternUnits="userSpaceOnUse">
      <circle class="pp-c" cx="5.5" cy="5.5" r="3.4"></circle>
    </pattern>
  </defs>

  <rect class="pp-sheet" width="400" height="560"></rect>

  {/* Sheet furniture: printed on every plate, so it is always there. */}
  <g class="pp-furniture">
    <path d={cropMarks}></path>
    <circle cx="200" cy="12" r="4.5"></circle>
    <path d={regMark(200, 12)}></path>
    <circle cx="200" cy="548" r="4.5"></circle>
    <path d={regMark(200, 548)}></path>
  </g>

  <g class="pp-plate" data-pp-plate="y">
    <g clip-path="url(#pp-bleed)">
      <circle class="pp-y" cx="254" cy="186" r="114"></circle>
      <rect class="pp-y" x="40" y="58" width="34" height="34"></rect>
    </g>
    <rect class="pp-y" x="300" y="543" width="10" height="10"></rect>
  </g>

  <g class="pp-plate" data-pp-plate="m">
    <g clip-path="url(#pp-bleed)">
      <path class="pp-m" d={ARCH} transform={archM}></path>
    </g>
    <rect class="pp-m" x="314" y="543" width="10" height="10"></rect>
  </g>

  <g class="pp-plate" data-pp-plate="c">
    <g clip-path="url(#pp-bleed)">
      <path d={ARCH} transform={archC} fill="url(#pp-dots)"></path>
    </g>
    <rect class="pp-c" x="328" y="543" width="10" height="10"></rect>
  </g>

  <g class="pp-plate" data-pp-plate="k">
    <g clip-path="url(#pp-bleed)">
      <text class="pp-kicker" x="40" y="404">
        {capsEl(homeText.el.process.posterKicker)}
      </text>
      <path class="pp-rule" d="M40 418H360"></path>
      <text
        class="pp-word"
        x="40"
        y="478"
        textLength="320"
        lengthAdjust="spacingAndGlyphs"
        set:text={site.name}
      />
      <text class="pp-line" x="40" y="506">
        {ownerCopy.el.headline}
      </text>
    </g>
    <rect class="pp-k" x="342" y="543" width="10" height="10"></rect>
  </g>
</svg>

<style>
  @layer components {
    .pp-svg {
      display: block;
      width: 100%;
      height: auto;
      isolation: isolate;
      overflow: visible;
      box-shadow: 0 1px 0 var(--color-line);
    }
    .pp-sheet {
      fill: var(--color-paper);
    }
    .pp-furniture {
      fill: none;
      stroke: var(--color-key);
      stroke-width: 0.75;
    }
    .pp-plate {
      mix-blend-mode: multiply;
    }
    .pp-y {
      fill: var(--color-yellow);
    }
    .pp-m {
      fill: var(--color-magenta);
    }
    .pp-c {
      fill: var(--color-cyan);
    }
    .pp-k,
    .pp-kicker,
    .pp-word,
    .pp-line {
      fill: var(--color-key);
    }
    .pp-rule {
      stroke: var(--color-key);
      stroke-width: 1.2;
    }
    .pp-kicker {
      font-family: var(--font-display);
      font-size: 10.5px;
      font-weight: 750;
      letter-spacing: 2.4px;
    }
    .pp-word {
      font-family: var(--font-display);
      font-size: 54px;
      font-weight: 900;
      letter-spacing: -1px;
    }
    .pp-line {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 600;
    }

    /* Scroll-driven printing (process.ts): a plate's offset follows --reg (0 = in register). */
    .pp-plate[data-pp-plate='y'] {
      --dx: -12px;
      --dy: 9px;
    }
    .pp-plate[data-pp-plate='m'] {
      --dx: 11px;
      --dy: -8px;
    }
    .pp-plate[data-pp-plate='c'] {
      --dx: -9px;
      --dy: -11px;
    }
    .pp-plate[data-pp-plate='k'] {
      --dx: 8px;
      --dy: 11px;
    }
    :global(.process.is-enhanced) .pp-plate {
      transform: translate(calc(var(--reg, 0) * var(--dx)), calc(var(--reg, 0) * var(--dy)));
    }
  }
</style>
