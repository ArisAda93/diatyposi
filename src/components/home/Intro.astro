---
/** Home intro: the owner's paragraph set large across columns 4–11, a red label on the left. */
import Icon from '~/components/Icon.astro';
import RegMark from '~/components/RegMark.astro';
import { ownerCopy, routes } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { capsEl } from '~/lib/text';

const copy = homeText.el.intro;
---

<section class="section intro" aria-labelledby="intro-title">
  <div class="wrap grid-12 gap-y-6">
    <div class="col-span-12 flex items-center gap-4 lg:col-span-3 lg:flex-col lg:items-start">
      <h2 id="intro-title" class="label">
        {capsEl(copy.label)}
      </h2>
      <span class="hidden lg:block" aria-hidden="true">
        <RegMark size={28} class="mt-6 text-key" />
      </span>
    </div>
    <div class="col-span-12 lg:col-span-8 lg:col-start-4">
      <p class="intro-text">{ownerCopy.el.intro}</p>
      <a href={routes.about} class="link intro-link">
        <span>{copy.aboutLink}</span>
        <Icon name="arrow-right" size={20} />
      </a>
    </div>
  </div>
</section>

<style>
  @layer components {
    .intro {
      padding-top: clamp(3rem, 1.5rem + 6vw, 7rem);
    }
    .intro-text {
      max-width: 34ch;
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 1rem + 2vw, 2.75rem);
      font-weight: 620;
      line-height: 1.24;
      letter-spacing: -0.018em;
    }
    .intro-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
      font-family: var(--font-display);
      font-weight: 700;
    }
    .intro-link :global(svg) {
      transition: transform var(--dur-base) var(--ease-out);
    }
    @media (prefers-reduced-motion: no-preference) {
      .intro-link:hover :global(svg) {
        transform: translateX(3px);
      }
    }
  }
</style>
