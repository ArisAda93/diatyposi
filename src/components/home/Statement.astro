---
/**
 * Home statement: the `ink` Section (Section.astro; full-bleed, opaque, no index) with the
 * owner's closing line in display type over a halftone print of the arches (decorative;
 * geometry from logo-paths.ts).
 *
 * With JS, src/scripts/halftone-field.ts draws an interactive halftone field on the canvas (dots
 * print in on scroll, swell around the pointer, ripple on touch) and sets `.is-field`, which hides
 * the static SVG print. Without JS the SVG print shows.
 *
 * Solid ink, opaque, so it paints over the living background (no `data-bg-accent`); in the dark
 * theme the ink is darker than the page, with hairline edges (Section.astro). “ΔΙΑΤΥΠΩΣΗ —” is
 * the section's label, on the head's C/M/Y/K strip, and the rest of the closing line is the h2.
 * The script reads `.statement-text` (keep the class) and finds the section by `data-statement`.
 */
import Section from '~/components/Section.astro';
import { ARCH, ARCH_PLATES } from '~/components/logo-paths';
import { ownerCopy, site } from '~/data/site';

// “ΔΙΑΤΥΠΩΣΗ —” is set as the label, the rest large. The text stays verbatim.
const closing = ownerCopy.el.closing;
const sep = ' — ';
const at = closing.indexOf(sep);
const brand = at >= 0 ? closing.slice(0, at + sep.length - 1) : site.name;
const line = at >= 0 ? closing.slice(at + sep.length) : closing;
---

<Section id="statement" label={brand} variant="ink" class="statement" data-statement>
  <h2 slot="title" id="statement-title" class="statement-text">
    <span class="display-l statement-line">{line}</span>
  </h2>

  <svg
    class="statement-arches"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="690 50 840 205"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <pattern id="st-dots" width="9" height="9" patternUnits="userSpaceOnUse">
        <circle cx="4.5" cy="4.5" r="2"></circle>
      </pattern>
      <linearGradient id="st-fade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0.25"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="1"></stop>
      </linearGradient>
      <mask id="st-mask" maskContentUnits="objectBoundingBox">
        <rect width="1" height="1" fill="url(#st-fade)"></rect>
      </mask>
    </defs>
    <g mask="url(#st-mask)" fill="url(#st-dots)">
      {ARCH_PLATES.map((p) => (
        <path d={ARCH} transform={`translate(${p.x} 0)`} />
      ))}
    </g>
  </svg>
  <canvas class="statement-field" aria-hidden="true" data-statement-field></canvas>
</Section>

<style>
  @layer components {
    /* Decorative layers behind the text, inside the isolated ink section. */
    .statement-arches {
      position: absolute;
      right: 0;
      bottom: -6%;
      z-index: -1;
      width: min(100%, max(22rem, 72%));
      height: auto;
      color: var(--color-paper);
      opacity: 0.16;
      pointer-events: none;
    }
    .statement-arches circle {
      fill: currentColor;
    }
    :global(.statement.is-field) .statement-arches {
      display: none;
    }
    .statement-field {
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .statement-line {
      display: block;
      max-width: 17ch;
      color: var(--color-paper);
      text-wrap: balance;
    }
    @media (min-width: 64rem) {
      .statement-line {
        font-size: clamp(3.5rem, 1.5rem + 4.2vw, 6rem);
      }
    }
  }
</style>

<script>
  import { initHalftoneField } from '~/scripts/halftone-field';

  document.querySelectorAll<HTMLElement>('[data-statement]').forEach(initHalftoneField);
</script>
