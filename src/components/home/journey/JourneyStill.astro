---
/**
 * One step of “Μία ιδέα. Παντού.” as a still (phones and tablets, reduced motion, no JS): the
 * step's line drawing (JourneyArt, still mode) with the real product photo on top, drawn to the
 * same composition. Decorative (the caller wraps it in `aria-hidden`; the photo's alt is empty).
 *
 * The still is its own square sheet of paper (paper colour and grain, opaque), so the living
 * background's ink lines never run through the drawing or under the photo: a calm, flat square at
 * any pixel density. By default the photo simply shows; in light theme its edges fade into the
 * paper over 7 % of each side (as the desktop stage's sheet does), in dark theme they stay crisp.
 *
 * With motion allowed and the desktop live stage off, src/scripts/journey-stills.ts plays the
 * still in three beats: `is-reveal` (a blank sheet: the photo is off and the drawing waits),
 * `is-drawn` (the sketch draws itself in; JourneyArt.astro's still rules) and, once the still is
 * all in view and the sketch has held, the print: the script prints the photo over the sketch on
 * a WebGL press in `[data-journey-press]` (under the drawing, so the sketch's lines stay on top of
 * the first inks) while `is-pressing` is set, then `is-printed` and `is-pressed` hand over to the
 * picture with a short fade and the press canvas goes. Without WebGL, `is-printed` alone fades the
 * photo in while the sheet settles into register from slightly enlarged and off-centre (opacity
 * and transform only). Only the way in is animated; a reset to the blank sheet (off screen) is
 * immediate.
 *
 * Photos: src/assets/journey/{step}.jpg, square (2048 px from scripts/journey-images.mjs),
 * composed to match the drawing.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import JourneyArt from './JourneyArt.astro';
import type { JourneyStepId } from '~/scripts/idea-journey';

interface Props {
  step: JourneyStepId;
}

const { step } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/journey/*.jpg', {
  eager: true,
});
const photo = photos[`/src/assets/journey/${step}.jpg`]?.default;
if (!photo) {
  throw new Error(
    `Journey photo "${step}.jpg" not found in src/assets/journey/. ` +
      'Each step needs a square photo named after its id.',
  );
}

// The still is the page column's width (at most 26rem) below 48rem, and the 5 ⁄ 12 column (at most
// 26rem) from 48rem; short viewports make it smaller (IdeaJourney.astro), never larger. Widths
// cover 1×, 2× and 3× screens: 360 px at 2× takes 720, 416 px (26rem) at 3× takes 1280.
const sizes = '(min-width: 48rem) min(26rem, 40vw), min(26rem, calc(100vw - 2rem))';
// A smaller source keeps its own width as the largest entry, so no screen gets less than it.
const widths = [
  ...new Set([
    ...[360, 540, 720, 900, 1080].filter((w) => w < photo.width),
    Math.min(photo.width, 1280),
  ]),
];
---

<div class="ijs" data-journey-still>
  <div class="ijs-press" data-journey-press></div>
  <JourneyArt mode="still" step={step} />
  <div class="ijs-print">
    <Picture
      src={photo}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="ijs-photo"
    />
  </div>
</div>

<style>
  @layer components {
    .ijs {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      /* Its own sheet: the page's paper and grain, opaque (see the header). */
      background-color: var(--color-paper);
      background-image: var(--grain);
      background-size: 160px 160px;
    }
    /* The press canvas (journey-stills.ts) lies under the drawing, which is positioned so it paints
       over it; the photo lies over both. */
    .ijs-press {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .ijs-press :global(canvas) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    .ijs > :global(.ij-art) {
      position: relative;
    }
    .ijs-print {
      position: absolute;
      inset: 0;
    }
    .ijs-print :global(.ijs-photo) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Light theme: the photo's backdrop fades into the paper over the outer 7 % of each side, as
       the desktop stage's sheet does, so no square edge shows. Dark theme keeps crisp edges. */
    .ijs-print :global(.ijs-photo) {
      --ijs-fade-x: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
      --ijs-fade-y: linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: var(--ijs-fade-x), var(--ijs-fade-y);
      mask-image: var(--ijs-fade-x), var(--ijs-fade-y);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    @media not print {
      :global(html[data-theme='dark']) .ijs-print :global(.ijs-photo) {
        -webkit-mask-image: none;
        mask-image: none;
      }
    }

    /* Printing (journey-stills.ts). Without `is-reveal` none of this applies; screen only, so a
       printed page always carries the photos. The hidden state has no transition (adding
       `is-reveal`, or a reset, is immediate); only `is-printed` animates. */
    @media screen and (prefers-reduced-motion: no-preference) {
      .ijs.is-reveal .ijs-print {
        opacity: 0;
      }
      .ijs.is-reveal .ijs-print :global(.ijs-photo) {
        transform: translate(1.5%, -1%) scale(1.04);
      }
      /* Without the press: a slow fade while the sheet is pulled into the lay, a gentle settle
         with a barely visible overshoot. */
      .ijs.is-reveal.is-printed .ijs-print {
        opacity: 1;
        transition: opacity 0.9s var(--ease-out) 0.05s;
      }
      .ijs.is-reveal.is-printed .ijs-print :global(.ijs-photo) {
        transform: none;
        transition: transform 1.2s cubic-bezier(0.2, 1.2, 0.4, 1);
      }
      /* After the press: the press already put the sheet in register, so the picture only takes
         over from the canvas (the same image at that point) in a short fade. */
      .ijs.is-reveal.is-printed.is-pressed .ijs-print {
        transition: opacity 0.24s linear;
      }
      .ijs.is-reveal.is-printed.is-pressed .ijs-print :global(.ijs-photo) {
        transition: none;
      }
    }
    @media print {
      .ijs-press {
        display: none;
      }
    }
  }
</style>
