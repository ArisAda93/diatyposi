---
/**
 * One step of “Μία ιδέα. Παντού.” as a still (phones and tablets, reduced motion, no JS): the
 * step's line drawing (JourneyArt, still mode) with the real product photo on top, drawn to the
 * same composition. Decorative (the caller wraps it in `aria-hidden`; the photo's alt is empty).
 *
 * The still is its own square sheet of paper (paper colour and grain, opaque), so the living
 * background's ink lines never run through the drawing or under the photo: a calm, flat square at
 * any pixel density. By default the photo simply shows; in light theme its edges fade into the
 * paper over 7 % of each side (as the desktop stage's sheet does), in dark theme they stay crisp.
 *
 * With motion allowed and the desktop live stage off, src/scripts/journey-stills.ts adds
 * `is-reveal` (the photo is off and the sketch shows) and, once the still is well in view,
 * `is-printed`: the photo prints over the sketch by itself, fading in while the sheet settles into
 * register from slightly enlarged and off-centre. Opacity and transform only, so the compositor
 * runs it; only the way in is animated, a reset to the sketch (off screen) is immediate.
 *
 * Photos: src/assets/journey/{step}.jpg, square (1024 px), composed to match the drawing.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import JourneyArt from './JourneyArt.astro';
import type { JourneyStepId } from '~/scripts/idea-journey';

interface Props {
  step: JourneyStepId;
}

const { step } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/journey/*.jpg', {
  eager: true,
});
const photo = photos[`/src/assets/journey/${step}.jpg`]?.default;
if (!photo) {
  throw new Error(
    `Journey photo "${step}.jpg" not found in src/assets/journey/. ` +
      'Each step needs a square photo named after its id.',
  );
}

// The still is the page column's width (at most 26rem) below 48rem, and the 5 ⁄ 12 column (at most
// 26rem) from 48rem; short viewports make it smaller (IdeaJourney.astro), never larger. Widths
// cover 1×, 2× and 3× screens: 360 px at 2× takes 720, 390 px at 3× takes the full 1024.
const sizes = '(min-width: 48rem) min(26rem, 40vw), min(26rem, calc(100vw - 2rem))';
const widths = [360, 540, 720, 900, 1024].filter((w) => w <= photo.width);
---

<div class="ijs" data-journey-still>
  <JourneyArt mode="still" step={step} />
  <div class="ijs-print">
    <Picture
      src={photo}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths.length ? widths : [photo.width]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="ijs-photo"
    />
  </div>
</div>

<style>
  @layer components {
    .ijs {
      position: relative;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      /* Its own sheet: the page's paper and grain, opaque (see the header). */
      background-color: var(--color-paper);
      background-image: var(--grain);
      background-size: 160px 160px;
    }
    .ijs-print {
      position: absolute;
      inset: 0;
    }
    .ijs-print :global(.ijs-photo) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Light theme: the photo's backdrop fades into the paper over the outer 7 % of each side, as
       the desktop stage's sheet does, so no square edge shows. Dark theme keeps crisp edges. */
    .ijs-print :global(.ijs-photo) {
      --ijs-fade-x: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
      --ijs-fade-y: linear-gradient(to bottom, transparent, #000 7%, #000 93%, transparent);
      -webkit-mask-image: var(--ijs-fade-x), var(--ijs-fade-y);
      mask-image: var(--ijs-fade-x), var(--ijs-fade-y);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    @media not print {
      :global(html[data-theme='dark']) .ijs-print :global(.ijs-photo) {
        -webkit-mask-image: none;
        mask-image: none;
      }
    }

    /* Printing (journey-stills.ts). Without `is-reveal` none of this applies; screen only, so a
       printed page always carries the photos. The hidden state has no transition (adding
       `is-reveal`, or a reset, is immediate); only `is-printed` animates. */
    @media screen and (prefers-reduced-motion: no-preference) {
      .ijs.is-reveal .ijs-print {
        opacity: 0;
      }
      .ijs.is-reveal .ijs-print :global(.ijs-photo) {
        transform: translate(1.5%, -1%) scale(1.04);
      }
      .ijs.is-reveal.is-printed .ijs-print {
        opacity: 1;
        transition: opacity 0.8s var(--ease-out) 0.08s;
      }
      /* The sheet pulled into the lay: a gentle settle with a barely visible overshoot. */
      .ijs.is-reveal.is-printed .ijs-print :global(.ijs-photo) {
        transform: none;
        transition: transform 1.2s cubic-bezier(0.2, 1.2, 0.4, 1);
      }
    }
  }
</style>
