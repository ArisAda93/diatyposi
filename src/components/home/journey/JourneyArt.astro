---
/**
 * The “Μία ιδέα. Παντού.” illustrations: press-room line art (key hairlines on paper) and one
 * sample brand mark printed in C, M, Y and K plates that overprint with multiply. Decorative.
 *
 * mode="stage": one SVG with every object and one mark (desktop sticky stage). An ancestor's
 *   `data-stage` (a step id, or `blank`) picks what shows; CSS transitions draw the sketch, print
 *   the plates (Y → M → C → K), move and scale the same mark onto each object and draw it in.
 * mode="still": one step in its final state (phones, reduced motion, no JS): the sketch for
 *   `idea`, the printed mark on its object for every other step. Nothing animates.
 *
 * The mark is drawn around (0, 0); MARK_AT places it on each object in the 600 × 600 view box.
 */
import { homeText } from '~/i18n/pages/home';
import { JOURNEY_STEPS, type JourneyStepId } from '~/scripts/idea-journey';

interface Props {
  mode: 'stage' | 'still';
  /** The step to draw (still mode only). */
  step?: JourneyStepId;
}

const { mode, step = 'idea' } = Astro.props;
const name = homeText.el.journey.sampleName;

const MARK_AT: Record<JourneyStepId, { x: number; y: number; s: number }> = {
  idea: { x: 300, y: 292, s: 1.7 },
  mark: { x: 300, y: 292, s: 1.7 },
  card: { x: 228, y: 306, s: 0.6 },
  shirt: { x: 300, y: 262, s: 0.56 },
  sign: { x: 300, y: 214, s: 0.42 },
  gift: { x: 290, y: 320, s: 0.6 },
  social: { x: 300, y: 258, s: 0.62 },
};

const placeCss = (id: JourneyStepId): string => {
  const { x, y, s } = MARK_AT[id];
  return `translate(${x}px, ${y}px) scale(${s})`;
};
const placeAttr = (id: JourneyStepId): string => {
  const { x, y, s } = MARK_AT[id];
  return `translate(${x} ${y}) scale(${s})`;
};

const stage = mode === 'stage';
const show = (id: JourneyStepId): boolean => stage || step === id;
const showSketch = stage || step === 'idea';
const showPlates = stage || step !== 'idea';
/** Stage mode: one custom property per placement, picked by the data-stage rules below. */
const markVars = stage ? JOURNEY_STEPS.map(({ id }) => `--at-${id}:${placeCss(id)}`).join(';') : '';

// Sketchbook spiral and press-sheet furniture.
const rings = Array.from({ length: 11 }, (_, i) => `M${150 + i * 30} 98V118`).join('');
const cropMarks =
  'M84 100H100M110 74V90M500 100H516M490 74V90M84 500H100M110 510V526M500 500H516M490 510V526';
/** Registration target: a small circle and a cross. */
const target = (cx: number, cy: number): string => {
  const ring = `M${cx - 6} ${cy}A6 6 0 1 0 ${cx + 6} ${cy}A6 6 0 1 0 ${cx - 6} ${cy}`;
  return `${ring}M${cx - 11} ${cy}H${cx + 11}M${cx} ${cy - 11}V${cy + 11}`;
};
const colourBar = [
  { x: 132, cls: 'ij-c' },
  { x: 148, cls: 'ij-m' },
  { x: 164, cls: 'ij-y' },
  { x: 180, cls: 'ij-k' },
  { x: 196, cls: 'ij-k ij-t60' },
  { x: 212, cls: 'ij-k ij-t35' },
  { x: 228, cls: 'ij-k ij-t15' },
];
const awningStripes = Array.from({ length: 7 }, (_, i) => `M${174 + i * 50} 266V300`).join('');

// The mark: Y disc, M arch, C square, K wordmark.
const ARCH_M = 'M-46 22A46 46 0 0 1 46 22H22A22 22 0 0 0 -22 22Z';
const plates = [
  { id: 'y', ox: -10, oy: 8, delay: 0 },
  { id: 'm', ox: 9, oy: -7, delay: 0.18 },
  { id: 'c', ox: -7, oy: -9, delay: 0.36 },
  { id: 'k', ox: 6, oy: 9, delay: 0.54 },
] as const;
const plateStyle = (p: (typeof plates)[number]): string | undefined =>
  stage ? `--ox:${p.ox}px;--oy:${p.oy}px;--pd:${p.delay}s` : undefined;
const sketchDelay = (seconds: number): string | undefined =>
  stage ? `--d:${seconds}s` : undefined;
---

<svg
  class:list={['ij-art', `ij-art-${mode}`]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 600 600"
  aria-hidden="true"
  focusable="false"
>
  {
    show('idea') && (
      <g class="ij-obj ij-obj-idea">
        <g transform="rotate(-2 300 300)">
          <rect class="ij-paper" x="118" y="108" width="364" height="384" />
          <path class="ij-line ij-draw" pathLength="1" d="M118 108H482V492H118Z" />
          <path class="ij-line ij-hair ij-draw" pathLength="1" d={rings} />
        </g>
        <g transform="translate(436 500) rotate(-24)">
          <rect class="ij-paper" x="-64" y="-7" width="120" height="14" />
          <rect class="ij-tint" x="56" y="-7" width="14" height="14" />
          <path class="ij-ink" d="M-80 -2.2L-86 0L-80 2.2Z" />
          <path
            class="ij-line ij-draw"
            pathLength="1"
            d="M-64 -7H70V7H-64ZM56 -7V7M-64 -7L-86 0L-64 7"
          />
          <path class="ij-line ij-hair ij-draw" pathLength="1" d="M-64 0H56" />
        </g>
      </g>
    )
  }

  {
    show('mark') && (
      <g class="ij-obj ij-obj-mark">
        <rect class="ij-paper" x="110" y="100" width="380" height="400" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d="M110 100H490V500H110Z" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d={cropMarks} />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d={`${target(300, 82)}${target(300, 518)}`}
        />
        {colourBar.map((patch) => (
          <rect class={patch.cls} x={patch.x} y="466" width="14" height="10" />
        ))}
      </g>
    )
  }

  {
    show('card') && (
      <g class="ij-obj ij-obj-card">
        <g transform="rotate(8 330 300)">
          <rect class="ij-tint" x="150" y="200" width="340" height="200" />
          <path class="ij-line ij-hair ij-draw" pathLength="1" d="M150 200H490V400H150Z" />
        </g>
        <rect class="ij-paper" x="130" y="190" width="340" height="220" />
        <path class="ij-line ij-draw" pathLength="1" d="M130 190H470V410H130Z" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d="M300 236V364" />
        <path class="ij-line ij-bold ij-draw" pathLength="1" d="M318 266H440" />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M318 284H404M318 332H446M318 348H430M318 364H392"
        />
      </g>
    )
  }

  {
    show('shirt') && (
      <g class="ij-obj ij-obj-shirt">
        <path
          class="ij-paper"
          d="M262 128C275 150 325 150 338 128L410 152L470 228L426 258L396 232V500H204V232L174 258L130 228L190 152Z"
        />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M262 128C275 150 325 150 338 128L410 152L470 228L426 258L396 232V500H204V232L174 258L130 228L190 152Z"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M254 131C268 162 332 162 346 131M137 219L181 249M463 219L419 249M204 486H396"
        />
      </g>
    )
  }

  {
    show('sign') && (
      <g class="ij-obj ij-obj-sign">
        <rect class="ij-tint" x="100" y="132" width="400" height="390" />
        <rect class="ij-paper" x="124" y="156" width="352" height="100" />
        <path class="ij-paper" d="M124 266H476L462 300H138Z" />
        <rect class="ij-paper" x="136" y="318" width="196" height="184" />
        <rect class="ij-paper" x="360" y="318" width="104" height="204" />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M64 522H536M100 522V132H500V522M88 120H512V132H88Z"
        />
        <path class="ij-line ij-draw" pathLength="1" d="M124 156H476V256H124Z" />
        <path class="ij-line ij-draw" pathLength="1" d="M124 266H476L462 300H138Z" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d={awningStripes} />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M136 318H332V502H136ZM128 502H340M234 318V502"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M156 470L204 350M172 474L212 374M254 470L302 350"
        />
        <path class="ij-line ij-draw" pathLength="1" d="M360 522V318H464V522M376 446V470" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d="M374 332H450V420H374Z" />
      </g>
    )
  }

  {
    show('gift') && (
      <g class="ij-obj ij-obj-gift">
        <path class="ij-paper" d="M190 214V430A100 20 0 0 0 390 430V214Z" />
        <path class="ij-tint" d="M190 214A100 20 0 1 0 390 214A100 20 0 1 0 190 214Z" />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M190 214V430A100 20 0 0 0 390 430V214M190 214A100 20 0 1 0 390 214A100 20 0 1 0 190 214"
        />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M390 252C446 252 458 276 458 314C458 356 432 380 390 384M390 278C424 278 434 292 434 315C434 340 420 356 390 358"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M202 216A88 15 0 1 0 378 216A88 15 0 1 0 202 216M150 462H430"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M262 176C250 154 274 142 262 118M300 180C288 158 312 146 300 122M338 176C326 154 350 142 338 118"
        />
      </g>
    )
  }

  {
    show('social') && (
      <g class="ij-obj ij-obj-social">
        <path
          class="ij-paper"
          d="M230 84H370A26 26 0 0 1 396 110V490A26 26 0 0 1 370 516H230A26 26 0 0 1 204 490V110A26 26 0 0 1 230 84Z"
        />
        <rect class="ij-tint" x="216" y="170" width="168" height="168" />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M230 84H370A26 26 0 0 1 396 110V490A26 26 0 0 1 370 516H230A26 26 0 0 1 204 490V110A26 26 0 0 1 230 84Z"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M216 112V488A14 14 0 0 0 230 502H370A14 14 0 0 0 384 488V112A14 14 0 0 0 370 98H230A14 14 0 0 0 216 112Z"
        />
        <path class="ij-line ij-draw" pathLength="1" d="M284 91H316" />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M224 146A12 12 0 1 0 248 146A12 12 0 1 0 224 146M258 153H300M216 170H384M216 338H384"
        />
        <path class="ij-line ij-bold ij-draw" pathLength="1" d="M258 141H330M272 492H328" />
        <path
          class="ij-m ij-multiply"
          d="M232 372C219 363 220 351 227 351C230 351 232 354 232 356C232 354 234 351 237 351C244 351 245 363 232 372Z"
        />
        <path
          class="ij-line ij-hair ij-draw"
          pathLength="1"
          d="M232 372C219 363 220 351 227 351C230 351 232 354 232 356C232 354 234 351 237 351C244 351 245 363 232 372ZM254 354H274V367H264L258 373V367H254ZM222 392H370M222 406H346M222 420H300"
        />
      </g>
    )
  }

  <g
    class="ij-mark"
    style={stage ? markVars : undefined}
    transform={stage ? undefined : placeAttr(step)}
  >
    {
      showSketch && (
        <g class="ij-sketch">
          <path class="ij-line ij-hair ij-guide" d="M-104 -28H104M0 -100V44" />
          <path
            class="ij-line ij-draw"
            pathLength="1"
            style={sketchDelay(0)}
            d="M-52 -42A36 36 0 1 1 20 -42A36 36 0 1 1 -52 -42M-49 -48A35 37 -8 0 1 18 -35"
          />
          <path
            class="ij-line ij-draw"
            pathLength="1"
            style={sketchDelay(0.35)}
            d="M-20 -56H49M44 -61V7M50 2H-19M-14 8V-61"
          />
          <path
            class="ij-line ij-draw"
            pathLength="1"
            style={sketchDelay(0.7)}
            d="M-46 22A46 46 0 0 1 46 22M22 22A22 22 0 0 0 -22 22M-52 22H-18M18 22H52"
          />
          <text class="ij-sketch-word" x="0" y="58" text-anchor="middle">
            {name}
          </text>
          <path
            class="ij-line ij-draw"
            pathLength="1"
            style={sketchDelay(1.1)}
            d="M-74 70C-30 75 30 66 76 70"
          />
        </g>
      )
    }
    {
      showPlates &&
        plates.map((p) => (
          <g class={`ij-plate ij-plate-${p.id}`} style={plateStyle(p)}>
            {p.id === 'y' && <circle class="ij-y" cx="-16" cy="-42" r="36" />}
            {p.id === 'm' && <path class="ij-m" d={ARCH_M} />}
            {p.id === 'c' && <rect class="ij-c" x="-14" y="-56" width="58" height="58" />}
            {p.id === 'k' && (
              <text class="ij-k ij-word" x="0" y="58" text-anchor="middle">
                {name}
              </text>
            )}
          </g>
        ))
    }
  </g>
</svg>

<style>
  @layer components {
    .ij-art {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      isolation: isolate;
    }

    /* Line art: key hairlines on paper. Stills are drawn smaller, so their lines are heavier. */
    .ij-art-still {
      --sw: 2;
    }
    .ij-line {
      fill: none;
      stroke: var(--color-key);
      stroke-width: var(--sw, 1.5);
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .ij-hair {
      stroke-width: calc(var(--sw, 1.5) * 0.66);
    }
    .ij-bold {
      stroke-width: calc(var(--sw, 1.5) * 2.4);
    }
    .ij-paper {
      fill: var(--color-paper);
    }
    .ij-tint {
      fill: var(--color-paper-2);
    }
    .ij-ink {
      fill: var(--color-key);
    }

    /* Inks */
    .ij-c {
      fill: var(--color-cyan);
    }
    .ij-m {
      fill: var(--color-magenta);
    }
    .ij-y {
      fill: var(--color-yellow);
    }
    .ij-k {
      fill: var(--color-key);
    }
    .ij-t60 {
      opacity: 0.6;
    }
    .ij-t35 {
      opacity: 0.35;
    }
    .ij-t15 {
      opacity: 0.15;
    }
    .ij-plate,
    .ij-multiply {
      mix-blend-mode: multiply;
    }
    .ij-word {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.3px;
    }

    /* The pencil sketch */
    .ij-sketch .ij-line {
      stroke: var(--color-muted);
    }
    .ij-guide {
      stroke-dasharray: 2 5;
      opacity: 0.55;
    }
    .ij-sketch-word {
      font-family: var(--font-voice);
      font-size: 20px;
      font-weight: 330;
      fill: var(--color-muted);
    }

    /* ---------------------------------------------------------------------------------------- */
    /* Stage: everything follows the ancestor's data-stage                                      */
    /* ---------------------------------------------------------------------------------------- */

    /* Lines draw in along their length (pathLength 1): dash 1, gap 2, offset 1.5 = not drawn. */
    .ij-art-stage .ij-draw {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1.5;
    }

    /* Objects: hidden until their step; then they fade in and their lines draw. */
    .ij-art-stage .ij-obj {
      opacity: 0;
      transition: opacity 0.3s linear;
    }
    .ij-art-stage .ij-obj .ij-draw {
      transition: stroke-dashoffset 0.4s var(--ease-out);
    }
    :global([data-stage='idea']) .ij-art-stage .ij-obj-idea,
    :global([data-stage='mark']) .ij-art-stage .ij-obj-mark,
    :global([data-stage='card']) .ij-art-stage .ij-obj-card,
    :global([data-stage='shirt']) .ij-art-stage .ij-obj-shirt,
    :global([data-stage='sign']) .ij-art-stage .ij-obj-sign,
    :global([data-stage='gift']) .ij-art-stage .ij-obj-gift,
    :global([data-stage='social']) .ij-art-stage .ij-obj-social {
      opacity: 1;
      transition: opacity 0.35s linear 0.2s;
    }
    :global([data-stage='idea']) .ij-art-stage .ij-obj-idea .ij-draw,
    :global([data-stage='mark']) .ij-art-stage .ij-obj-mark .ij-draw,
    :global([data-stage='card']) .ij-art-stage .ij-obj-card .ij-draw,
    :global([data-stage='shirt']) .ij-art-stage .ij-obj-shirt .ij-draw,
    :global([data-stage='sign']) .ij-art-stage .ij-obj-sign .ij-draw,
    :global([data-stage='gift']) .ij-art-stage .ij-obj-gift .ij-draw,
    :global([data-stage='social']) .ij-art-stage .ij-obj-social .ij-draw {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.1s var(--ease-out) 0.2s;
    }

    /* The one mark travels from object to object. */
    .ij-art-stage .ij-mark {
      transform: var(--at-idea);
      transition: transform 0.9s var(--ease-in-out);
    }
    :global([data-stage='mark']) .ij-art-stage .ij-mark {
      transform: var(--at-mark);
    }
    :global([data-stage='card']) .ij-art-stage .ij-mark {
      transform: var(--at-card);
    }
    :global([data-stage='shirt']) .ij-art-stage .ij-mark {
      transform: var(--at-shirt);
    }
    :global([data-stage='sign']) .ij-art-stage .ij-mark {
      transform: var(--at-sign);
    }
    :global([data-stage='gift']) .ij-art-stage .ij-mark {
      transform: var(--at-gift);
    }
    :global([data-stage='social']) .ij-art-stage .ij-mark {
      transform: var(--at-social);
    }

    /* Sketch: drawn stroke by stroke on the idea step, then it fades under the printed plates. */
    .ij-art-stage .ij-sketch {
      opacity: 0;
      transition: opacity 0.8s linear 0.35s;
    }
    .ij-art-stage .ij-sketch .ij-draw {
      transition: stroke-dashoffset 0.4s var(--ease-out) 1.1s;
    }
    .ij-art-stage .ij-sketch-word {
      opacity: 0;
      transition: opacity 0.3s linear;
    }
    :global([data-stage='idea']) .ij-art-stage .ij-sketch {
      opacity: 1;
      transition: opacity 0.2s linear;
    }
    :global([data-stage='idea']) .ij-art-stage .ij-sketch .ij-draw {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.2s var(--ease-in-out) var(--d, 0s);
    }
    :global([data-stage='idea']) .ij-art-stage .ij-sketch-word {
      opacity: 1;
      transition: opacity 0.6s linear 1s;
    }

    /* Plates: off and out of register on the sketch, printed Y → M → C → K on every later step. */
    .ij-art-stage .ij-plate {
      opacity: 0;
      transform: translate(var(--ox, 0), var(--oy, 0));
      transition:
        opacity 0.2s linear,
        transform 0.3s var(--ease-out);
    }
    :global([data-stage]:not([data-stage='idea']):not([data-stage='blank']))
      .ij-art-stage
      .ij-plate {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s linear var(--pd, 0s),
        transform 0.7s var(--ease-snap) var(--pd, 0s);
    }
  }
</style>
