---
/**
 * The “Μία ιδέα. Παντού.” illustrations: press-room line art (key hairlines on paper) and one
 * sample brand mark printed in C, M, Y and K plates that overprint like inks
 * (`mix-blend-mode: var(--blend-ink)`: multiply on light paper, screen on dark). Decorative.
 *
 * mode="stage": one SVG with every object and one mark (desktop sticky stage), driven frame by
 *   frame by src/scripts/idea-journey.ts: each object's `--draw` (0…1) draws its strokes in or
 *   out and fades its fills; the sketch's `--sk` draws its strokes in turn; the plates and the
 *   mark get inline transforms and opacity. Until the script runs the stage is blank paper.
 * mode="still": one step in its final state (phones, reduced motion, no JS): the sketch for
 *   `idea`, the printed mark on its object for every other step. Nothing animates.
 *
 * Objects are drawn to real proportions: a 9 × 12 sketchbook, an 85 × 55 business card, a
 * T-shirt, a shop front, a mug and a generic 9 : 19.5 phone with a square post. The mark is drawn
 * around (0, 0); MARK_AT (src/scripts/idea-journey.ts) places it on each object in the 600 × 600
 * view box.
 */
import { homeText } from '~/i18n/pages/home';
import { MARK_AT, MARK_PLATES, type JourneyStepId } from '~/scripts/idea-journey';

interface Props {
  mode: 'stage' | 'still';
  /** The step to draw (still mode only). */
  step?: JourneyStepId;
}

const { mode, step = 'idea' } = Astro.props;
const name = homeText.el.journey.sampleName;

const stage = mode === 'stage';
const show = (id: JourneyStepId): boolean => stage || step === id;
const showSketch = stage || step === 'idea';
const showPlates = stage || step !== 'idea';

const placeAttr = (id: JourneyStepId): string => {
  const { x, y, s } = MARK_AT[id];
  return `translate(${x} ${y}) scale(${s})`;
};
/** Stage mode starts on the sketch's place; the script takes over from the first frame. */
const start = MARK_AT.idea;
const stageStart = `transform:translate(${start.x}px, ${start.y}px) scale(${start.s})`;

// Sketchbook spiral and press-sheet furniture.
const rings = Array.from({ length: 11 }, (_, i) => `M${150 + i * 30} 54V74`).join('');
const cropMarks =
  'M84 100H100M110 74V90M500 100H516M490 74V90M84 500H100M110 510V526M500 500H516M490 510V526';
/** Registration target: a small circle and a cross. */
const target = (cx: number, cy: number): string => {
  const ring = `M${cx - 6} ${cy}A6 6 0 1 0 ${cx + 6} ${cy}A6 6 0 1 0 ${cx - 6} ${cy}`;
  return `${ring}M${cx - 11} ${cy}H${cx + 11}M${cx} ${cy - 11}V${cy + 11}`;
};
const colourBar = [
  { x: 132, cls: 'ij-c' },
  { x: 148, cls: 'ij-m' },
  { x: 164, cls: 'ij-y' },
  { x: 180, cls: 'ij-k' },
  { x: 196, cls: 'ij-k ij-t60' },
  { x: 212, cls: 'ij-k ij-t35' },
  { x: 228, cls: 'ij-k ij-t15' },
];
const awningStripes = Array.from({ length: 7 }, (_, i) => `M${174 + i * 50} 266V300`).join('');

// T-shirt: 228 wide at the hem, 352 from shoulder to hem (about 0.65, as a real tee).
const SHIRT =
  'M255 126C270 152 330 152 345 126L406 148L476 222L436 256L414 236V500H186V236L164 256L124 222L194 148Z';
// Mug: 180 wide, 214 tall (about 8 × 9.5 cm).
const MUG_BODY = 'M200 200V414A90 18 0 0 0 380 414V200';
const MUG_TOP = 'M200 200A90 18 0 1 0 380 200A90 18 0 1 0 200 200';
// Phone: 180 × 390 (9 : 19.5), corners 24 (13 % of the width), a 6-unit bezel.
const PHONE =
  'M234 105H366A24 24 0 0 1 390 129V471A24 24 0 0 1 366 495H234A24 24 0 0 1 210 471V129A24 24 0 0 1 234 105Z';
const SCREEN =
  'M234 111H366A18 18 0 0 1 384 129V471A18 18 0 0 1 366 489H234A18 18 0 0 1 216 471V129A18 18 0 0 1 234 111Z';
const HEART =
  'M228 357C220 351.5 219.5 343 224.5 343C226.5 343 228 345 228 346.5C228 345 229.5 343 231.5 343C236.5 343 236 351.5 228 357Z';

// The mark: Y disc, M arch, C square, K wordmark (offsets in MARK_PLATES, print order).
const ARCH_M = 'M-46 22A46 46 0 0 1 46 22H22A22 22 0 0 0 -22 22Z';
/** Stage mode: each sketch stroke starts a fifth of the sketch later than the one before. */
const sketchStroke = (k: number): string | undefined => (stage ? `--k:${k}` : undefined);
---

<svg
  class:list={['ij-art', `ij-art-${mode}`]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 600 600"
  aria-hidden="true"
  focusable="false"
>
  {show('idea') && (
    <g class="ij-obj ij-obj-idea" data-journey-obj="idea">
      <g transform="rotate(-2 300 312)">
        <rect class="ij-paper" x="114" y="64" width="372" height="496" />
        <path class="ij-line ij-draw" pathLength="1" d="M114 64H486V560H114Z" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d={rings} />
      </g>
      <g transform="translate(436 512) rotate(-24)">
        <rect class="ij-paper" x="-64" y="-7" width="120" height="14" />
        <rect class="ij-tint" x="56" y="-7" width="14" height="14" />
        <path class="ij-ink" d="M-80 -2.2L-86 0L-80 2.2Z" />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          d="M-64 -7H70V7H-64ZM56 -7V7M-64 -7L-86 0L-64 7"
        />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d="M-64 0H56" />
      </g>
    </g>
  )}

  {show('mark') && (
    <g class="ij-obj ij-obj-mark" data-journey-obj="mark">
      <rect class="ij-paper" x="110" y="100" width="380" height="400" />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d="M110 100H490V500H110Z" />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d={cropMarks} />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d={`${target(300, 82)}${target(300, 518)}`}
      />
      {colourBar.map((patch) => (
        <rect class={patch.cls} x={patch.x} y="466" width="14" height="10" />
      ))}
    </g>
  )}

  {show('card') && (
    <g class="ij-obj ij-obj-card" data-journey-obj="card">
      <g transform="rotate(8 330 300)">
        <rect class="ij-tint" x="150" y="190" width="340" height="220" />
        <path class="ij-line ij-hair ij-draw" pathLength="1" d="M150 190H490V410H150Z" />
      </g>
      <rect class="ij-paper" x="130" y="190" width="340" height="220" />
      <path class="ij-line ij-draw" pathLength="1" d="M130 190H470V410H130Z" />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d="M300 236V364" />
      <path class="ij-line ij-bold ij-draw" pathLength="1" d="M318 266H440" />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M318 284H404M318 332H446M318 348H430M318 364H392"
      />
    </g>
  )}

  {show('shirt') && (
    <g class="ij-obj ij-obj-shirt" data-journey-obj="shirt">
      <path class="ij-paper" d={SHIRT} />
      <path class="ij-line ij-draw" pathLength="1" d={SHIRT} />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M247 129C263 166 337 166 353 129M131 215L171 249M469 215L429 249M186 486H414"
      />
    </g>
  )}

  {show('sign') && (
    <g class="ij-obj ij-obj-sign" data-journey-obj="sign">
      <rect class="ij-tint" x="100" y="132" width="400" height="390" />
      <rect class="ij-paper" x="124" y="156" width="352" height="100" />
      <path class="ij-paper" d="M124 266H476L462 300H138Z" />
      <rect class="ij-paper" x="136" y="318" width="196" height="184" />
      <rect class="ij-paper" x="360" y="318" width="104" height="204" />
      <path
        class="ij-line ij-draw"
        pathLength="1"
        d="M64 522H536M100 522V132H500V522M88 120H512V132H88Z"
      />
      <path class="ij-line ij-draw" pathLength="1" d="M124 156H476V256H124Z" />
      <path class="ij-line ij-draw" pathLength="1" d="M124 266H476L462 300H138Z" />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d={awningStripes} />
      <path
        class="ij-line ij-draw"
        pathLength="1"
        d="M136 318H332V502H136ZM128 502H340M234 318V502"
      />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M156 470L204 350M172 474L212 374M254 470L302 350"
      />
      <path class="ij-line ij-draw" pathLength="1" d="M360 522V318H464V522M376 446V470" />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d="M374 332H450V420H374Z" />
    </g>
  )}

  {show('gift') && (
    <g class="ij-obj ij-obj-gift" data-journey-obj="gift">
      <path class="ij-paper" d={`${MUG_BODY}Z`} />
      <path class="ij-tint" d={`${MUG_TOP}Z`} />
      <path class="ij-line ij-draw" pathLength="1" d={`${MUG_BODY}${MUG_TOP}`} />
      <path
        class="ij-line ij-draw"
        pathLength="1"
        d="M380 240C436 240 448 266 448 304C448 346 422 370 380 374M380 266C414 266 424 280 424 303C424 328 410 344 380 346"
      />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M211 202A79 13 0 1 0 369 202A79 13 0 1 0 211 202M140 446H440"
      />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M252 166C240 144 264 132 252 108M290 170C278 148 302 136 290 112M328 166C316 144 340 132 328 108"
      />
    </g>
  )}

  {show('social') && (
    <g class="ij-obj ij-obj-social" data-journey-obj="social">
      <path class="ij-paper" d={PHONE} />
      <rect class="ij-tint" x="216" y="166" width="168" height="168" />
      <path class="ij-line ij-draw" pathLength="1" d={PHONE} />
      <path class="ij-line ij-hair ij-draw" pathLength="1" d={SCREEN} />
      <circle class="ij-ink" cx="300" cy="122" r="3.5" />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M393 186V230M393 246V274M226 122H240M360 122H374"
      />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d="M223 149A9 9 0 1 0 241 149A9 9 0 1 0 223 149M250 155H282M216 166H384M216 334H384"
      />
      <path class="ij-line ij-bold ij-draw" pathLength="1" d="M250 144H302M282 478H318" />
      <path class="ij-m ij-overprint" d={HEART} />
      <path
        class="ij-line ij-hair ij-draw"
        pathLength="1"
        d={`${HEART}M243 343H258V352H250L246 356V352H243ZM222 374H372M222 386H342M222 398H296M216 458H384`}
      />
    </g>
  )}

  <g
    class="ij-mark"
    data-journey-mark={stage ? '' : undefined}
    style={stage ? stageStart : undefined}
    transform={stage ? undefined : placeAttr(step)}
  >
    {stage && <circle class="ij-mark-hit" cx="0" cy="-8" r="96" />}
    {showSketch && (
      <g class="ij-sketch" data-journey-sketch={stage ? '' : undefined}>
        <path class="ij-line ij-hair ij-guide" d="M-104 -28H104M0 -100V44" />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          style={sketchStroke(0)}
          d="M-52 -42A36 36 0 1 1 20 -42A36 36 0 1 1 -52 -42M-49 -48A35 37 -8 0 1 18 -35"
        />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          style={sketchStroke(0.2)}
          d="M-20 -56H49M44 -61V7M50 2H-19M-14 8V-61"
        />
        <path
          class="ij-line ij-draw"
          pathLength="1"
          style={sketchStroke(0.4)}
          d="M-46 22A46 46 0 0 1 46 22M22 22A22 22 0 0 0 -22 22M-52 22H-18M18 22H52"
        />
        <text class="ij-sketch-word" x="0" y="58" text-anchor="middle">
          {name}
        </text>
        <path
          class="ij-line ij-draw"
          pathLength="1"
          style={sketchStroke(0.6)}
          d="M-74 70C-30 75 30 66 76 70"
        />
      </g>
    )}
    {showPlates &&
      MARK_PLATES.map((p) => (
        <g class={`ij-plate ij-plate-${p.id}`} data-journey-plate={stage ? p.id : undefined}>
          {p.id === 'y' && <circle class="ij-y" cx="-16" cy="-42" r="36" />}
          {p.id === 'm' && <path class="ij-m" d={ARCH_M} />}
          {p.id === 'c' && <rect class="ij-c" x="-14" y="-56" width="58" height="58" />}
          {p.id === 'k' && (
            <text class="ij-k ij-word" x="0" y="58" text-anchor="middle">
              {name}
            </text>
          )}
        </g>
      ))}
  </g>
</svg>

<style>
  @layer components {
    .ij-art {
      /* Object surfaces: paper and its shade in light mode; in dark mode the objects are raised
         a step above the page, so they read as objects and not as holes. */
      --ij-surface: var(--color-paper);
      --ij-shade: var(--color-paper-2);
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      isolation: isolate;
    }
    @media not print {
      :global(html[data-theme='dark']) .ij-art {
        --ij-surface: color-mix(in srgb, var(--color-key) 8%, var(--color-paper-2));
        --ij-shade: var(--color-paper-2);
      }
    }

    /* Line art: key hairlines on paper. Stills are drawn smaller, so their lines are heavier. */
    .ij-art-still {
      --sw: 2;
    }
    .ij-line {
      fill: none;
      stroke: var(--color-key);
      stroke-width: var(--sw, 1.5);
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .ij-hair {
      stroke-width: calc(var(--sw, 1.5) * 0.66);
    }
    .ij-bold {
      stroke-width: calc(var(--sw, 1.5) * 2.4);
    }
    .ij-paper {
      fill: var(--ij-surface);
    }
    .ij-tint {
      fill: var(--ij-shade);
    }
    .ij-ink {
      fill: var(--color-key);
    }

    /* Inks */
    .ij-c {
      fill: var(--color-cyan);
    }
    .ij-m {
      fill: var(--color-magenta);
    }
    .ij-y {
      fill: var(--color-yellow);
    }
    .ij-k {
      fill: var(--color-key);
    }
    .ij-t60 {
      opacity: 0.6;
    }
    .ij-t35 {
      opacity: 0.35;
    }
    .ij-t15 {
      opacity: 0.15;
    }
    .ij-plate,
    .ij-overprint {
      mix-blend-mode: var(--blend-ink);
    }
    .ij-word {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.3px;
    }

    /* The pencil sketch */
    .ij-sketch .ij-line {
      stroke: var(--color-muted);
    }
    .ij-guide {
      stroke-dasharray: 2 5;
      opacity: 0.55;
    }
    .ij-sketch-word {
      font-family: var(--font-voice);
      font-size: 20px;
      font-weight: 330;
      fill: var(--color-muted);
    }

    /* ---------------------------------------------------------------------------------------- */
    /* Stage: idea-journey.ts writes the frame                                                   */
    /* ---------------------------------------------------------------------------------------- */

    /* Lines draw along their length (pathLength 1, dash 1, gap 2): offset 1 − draw. Drawing out
       runs the same way back, so the strokes retract. An object is hidden at draw 0, so no
       round cap is left behind as a dot. */
    .ij-art-stage .ij-obj {
      opacity: min(1, calc(var(--draw, 0) * 20));
    }
    .ij-art-stage .ij-obj .ij-draw {
      stroke-dasharray: 1 2;
      stroke-dashoffset: calc(1 - var(--draw, 0));
    }
    /* Fills arrive in the second half of the draw-in and leave in the first half of the
       draw-out. */
    .ij-art-stage .ij-obj :is(.ij-paper, .ij-tint, .ij-ink, .ij-c, .ij-m, .ij-y, .ij-k) {
      fill-opacity: clamp(0, calc(var(--draw, 0) * 2 - 0.8), 1);
    }

    /* The sketch: four strokes in turn, each over 40 % of the sketch (`--k` is its start). */
    .ij-art-stage .ij-sketch {
      opacity: 0;
    }
    .ij-art-stage .ij-sketch .ij-draw {
      --sd: clamp(0, calc((var(--sk, 0) - var(--k, 0)) * 2.5), 1);
      stroke-dasharray: 1 2;
      stroke-dashoffset: calc(1 - var(--sd));
      opacity: min(1, calc(var(--sd) * 20));
    }
    .ij-art-stage .ij-sketch-word {
      opacity: clamp(0, calc((var(--sk, 0) - 0.7) * 3.4), 1);
    }

    /* Plates: off until the mark is printed. */
    .ij-art-stage .ij-plate {
      opacity: 0;
    }
    /* A wide, invisible target for hovering the mark (fine pointers; the plates split). */
    .ij-mark-hit {
      fill: none;
      pointer-events: all;
    }
  }
</style>
