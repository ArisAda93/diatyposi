---
/**
 * Home values strip: the owner's “Για εμάς…” paragraph on the left; on the right the four values,
 * each paired with a colour-bar patch (C, M, Y, K) in display type.
 *
 * Alive: each patch prints in as its row scrolls into view, the solid and its two tints arriving
 * out of register and settling (CSS scroll-driven, where supported; the motion layer also prints
 * the strip in through its halftone screen). Hovering a row washes it in its ink, the tints split
 * and snap back into register, and the plate letter darkens. All of it rests under reduced motion.
 */
import { ownerCopy } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { capsEl } from '~/lib/text';

const inks = [
  { id: 'cyan', code: 'C' },
  { id: 'magenta', code: 'M' },
  { id: 'yellow', code: 'Y' },
  { id: 'key', code: 'K' },
] as const;
const rows = ownerCopy.el.values.map((value, i) => ({ value, ink: inks[i] ?? inks[3] }));
---

<section class="section values" aria-labelledby="values-title" data-bg-accent="yellow">
  <div class="wrap grid-12 gap-y-12">
    <div class="values-intro col-span-12 lg:col-span-5">
      <h2 id="values-title" class="label">
        {capsEl(homeText.el.values.label)}
      </h2>
      <p class="values-text">{ownerCopy.el.partnership}</p>
    </div>

    <ul class="values-list col-span-12 lg:col-span-6 lg:col-start-7" role="list">
      {rows.map(({ value, ink }) => (
        <li class="value-row" style={`--ink:var(--color-${ink.id})`} data-reveal="depth">
          <span class="value-bar" aria-hidden="true" data-halftone="fine">
            <span />
            <span />
            <span />
          </span>
          <span class="value-name">{value}</span>
          <span class="value-code" aria-hidden="true">
            {ink.code}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @layer components {
    .values-text {
      max-width: 38ch;
      margin-top: 1.75rem;
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
    }
    @media (min-width: 64rem) {
      /* The paragraph stays in view beside the rows while they pass. */
      .values-intro {
        position: sticky;
        top: calc(var(--header-h) + 2.5rem);
        align-self: start;
      }
    }

    .values-list {
      border-top: 2px solid var(--color-key);
    }
    .value-row {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(1rem, 2.5vw, 2rem);
      padding-block: clamp(1.125rem, 2vw, 1.625rem);
      padding-inline: 0 0.75rem;
      border-bottom: 1px solid var(--color-line);
    }
    /* Ink wash that runs in from the left on hover. */
    .value-row::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: color-mix(in srgb, var(--ink) 14%, transparent);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform var(--dur-slow) var(--ease-out);
      pointer-events: none;
    }
    .value-row:hover::before {
      transform: scaleX(1);
    }

    /* A strip of the press colour bar: solid patch, then two tints of the same ink. */
    .value-bar {
      display: flex;
      gap: 2px;
      height: clamp(2.25rem, 3.5vw, 3.25rem);
    }
    .value-bar > span {
      width: clamp(0.5rem, 0.9vw, 0.875rem);
      background-color: color-mix(in srgb, var(--ink) 30%, transparent);
    }
    .value-bar > span:nth-child(2) {
      background-color: color-mix(in srgb, var(--ink) 60%, transparent);
    }
    .value-bar > span:first-child {
      width: clamp(2rem, 3.5vw, 3.25rem);
      background-color: var(--ink);
    }

    .value-name {
      font-family: var(--font-display);
      font-size: clamp(1.625rem, 1rem + 2.4vw, 3.25rem);
      font-weight: 820;
      line-height: 1.05;
      letter-spacing: -0.03em;
      text-wrap: balance;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .value-code {
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      transition: color var(--dur-fast) linear;
    }
    .value-row:hover .value-code {
      color: var(--color-key);
    }

    @media (prefers-reduced-motion: no-preference) {
      .value-row:hover .value-name {
        transform: translateX(0.375rem);
      }
      /* The tints split off the solid and snap back into register (individual `translate`, so it
         composes with the print-in below, which uses `transform`). */
      .value-row:hover .value-bar > span:nth-child(2) {
        animation: value-split-a 620ms var(--ease-snap);
      }
      .value-row:hover .value-bar > span:nth-child(3) {
        animation: value-split-b 620ms var(--ease-snap);
      }
    }

    /* Print-in as the row enters the viewport: each plate lands out of register, then settles. */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .value-bar > span {
          animation: value-print linear both;
          animation-timeline: view();
          animation-range: entry 0% cover 30%;
        }
        .value-bar > span:nth-child(2) {
          --vx: 10px;
          --vy: -6px;
        }
        .value-bar > span:nth-child(3) {
          --vx: 18px;
          --vy: 6px;
        }
        .value-bar > span:first-child {
          --vx: -8px;
          --vy: 4px;
        }
      }
    }
  }

  @keyframes value-print {
    from {
      opacity: 0;
      transform: translate(var(--vx, 0), var(--vy, 0));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes value-split-a {
    0%,
    100% {
      translate: 0 0;
    }
    35% {
      translate: 4px -3px;
    }
  }
  @keyframes value-split-b {
    0%,
    100% {
      translate: 0 0;
    }
    35% {
      translate: 8px 3px;
    }
  }
</style>
