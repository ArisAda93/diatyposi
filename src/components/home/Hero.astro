---
/**
 * Home hero: one composed press sheet that starts at the very top of the page, with the header
 * lying over it as part of the composition (Header.astro, `overHero`). It has no background of its
 * own, so the site-wide living background shows through (cyan accent while it holds the centre).
 *
 * - The copy is one block: the red label, the owner's headline (painted at first paint, the LCP
 *   element), a registration hairline that ties it to the owner's intro (set as its lead), the two
 *   actions and a quiet link to the company page. Desktop: a left column, vertically centred.
 *   Below 64rem: under the art.
 * - The art box (decorative, aria-hidden) holds the logo arches as SVG: the static composition,
 *   shown at first paint, without JS, with reduced motion and without WebGL. Its aspect ratio is
 *   the box every pose of the live scene fits in (hero-scene/choreography.ts ART, 900 × 620
 *   raster units, the 840-wide mark centred in it), so the mark, the ring and the wave are never
 *   cropped and never reach the copy. Desktop: the right column, bleeding into the gutter.
 *   Below 64rem: above the copy, capped by the screen height.
 * - The stage (decorative, aria-hidden) fills the hero; src/scripts/hero.ts inserts the scene's
 *   canvas there after first paint (src/scripts/hero-scene/). Its first frame draws the arches
 *   exactly where the SVG has them, then it fades in over it. On scroll the plates fade out in
 *   the art column while the header logo's arches pulse in register (the rules are below); the
 *   site-wide ink lines of the living background stay behind the page throughout.
 * - Dark theme: the scene screens light inks on black (hero-scene/theme.ts); the SVG mark, the
 *   ghosts and the rules follow the tokens, and overprint uses `--blend-ink` (screen in dark).
 * - The sheet's crop-marked trim recedes slightly on scroll (`data-parallax`). The foot carries
 *   the colour bar, the scroll cue and a registration mark.
 *
 * The CSS describes the composed state. Intro start states apply only under `html.hero-intro`
 * (set before first paint by BaseLayout) and while `.hero.is-intro` / `.is-intro-svg` are set
 * by the script.
 */
import Logo from '~/components/Logo.astro';
import Icon from '~/components/Icon.astro';
import ColorBar from '~/components/ColorBar.astro';
import RegMark from '~/components/RegMark.astro';
import { ownerCopy, routes, site } from '~/data/site';
import { t } from '~/i18n/ui';
import { heroText } from '~/i18n/pages/hero';
import { capsEl } from '~/lib/text';

// Two lines, broken after “σας…”.
const headline = ownerCopy.el.headline;
const cut = headline.indexOf('… ');
const lines = cut >= 0 ? [headline.slice(0, cut + 1), headline.slice(cut + 2)] : [headline];
const ghosts = ['c', 'm', 'y'] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero data-bg-accent="cyan">
  <div class="hero-trim crop-frame" aria-hidden="true" data-parallax="0.1"></div>
  <div class="hero-stage" aria-hidden="true" data-hero-stage data-motion="off"></div>

  <div class="wrap hero-inner">
    <div class="hero-grid">
      <div class="hero-art" aria-hidden="true" data-hero-art data-motion="off">
        <div class="hero-mark" data-hero-mark>
          <Logo variant="mark" id="hero-mark" />
        </div>
      </div>

      <div class="hero-copy" data-hero-copy>
        <span class="hero-sentinel" aria-hidden="true" data-hero-sentinel></span>
        <p class="label hero-label">{site.descriptorCaps.el}</p>
        <div class="hero-headline" data-motion="off">
          <h1 id="hero-title" class="display-xl hero-title hero-h1">
            {lines.map((line, i) => (
              <>
                {i > 0 && ' '}
                <span class="hero-line">{line}</span>
              </>
            ))}
          </h1>
          <div class="hero-ghosts" aria-hidden="true">
            {ghosts.map((g) => (
              <div class={`display-xl hero-title hero-ghost hero-ghost-${g}`}>
                {lines.map((line) => (
                  <span class="hero-line">{line}</span>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="hero-rule" aria-hidden="true">
          <RegMark size={14} />
          <span class="hero-rule-line"></span>
        </div>
        <p class="hero-lead">{ownerCopy.el.intro}</p>
        <div class="hero-actions">
          <a href={routes.quote} class="btn btn-primary">
            <span>{t('requestQuote')}</span>
            <Icon name="arrow-right" size={20} />
          </a>
          <a href={routes.services} class="btn btn-secondary">
            {t('ourServices')}
          </a>
        </div>
        <a href={routes.about} class="hero-about">
          <span class="link">{heroText.el.aboutLink}</span>
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>

    <div class="hero-foot" aria-hidden="true">
      <ColorBar tints={4} />
      <span class="hero-foot-rule"></span>
      <span class="hero-cue">
        <span class="hero-cue-label">{capsEl(heroText.el.scrollCue)}</span>
        <span class="hero-cue-track">
          <span class="hero-cue-drop"></span>
        </span>
      </span>
      <RegMark size={22} />
    </div>
  </div>
</section>

<script>
  import { initHero } from '~/scripts/hero';

  initHero();
</script>

<style>
  @layer components {
    .hero {
      position: relative;
      display: flex;
      min-height: 100vh;
      min-height: 100svh;
      overflow: clip;
    }

    /* Decorative layer for the scene canvas (inserted by the script). */
    .hero-stage {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-trim {
      display: none;
    }
    /*
     * The canvas scrolls with the hero and sits under the header (z-index 40): the plates never
     * draw over the nav. Its blend keeps paper, background, grain and text untouched: multiply on
     * a white canvas in light, screen on a black canvas in dark. The scene sets the same mode
     * inline, together with its own blend state, so the two always switch in the same frame.
     * Nothing between it and the root may create a stacking context, or the blend breaks.
     */
    .hero-stage :global(.hero-canvas) {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
      mix-blend-mode: var(--blend-ink, multiply);
      pointer-events: none;
    }
    .hero[data-docked] .hero-stage :global(.hero-canvas) {
      visibility: hidden;
    }

    /*
     * Hand-off (hero-scene/scene.ts): the header logo's arches are always shown. While the hero
     * plates fade out in the art column, they pulse out of register and snap back into it:
     * --dock-reg is 0 at the top, rises mid hand-off and returns to 0 (with the small overshoot of
     * --ease-snap) as the hero plates finish fading (choreography.ts registrationPulse). Offsets
     * are in the logo's SVG units (about 4 px); the key plate stays put, as on press. Only with
     * the live scene (data-scene), never under reduced motion. `transform` composes with the
     * motion layer's `translate` on the same plates.
     */
    @media (prefers-reduced-motion: no-preference) {
      :global(.site-header[data-scene] .site-header-logo .logo-plate-c) {
        transform: translate(calc(var(--dock-reg, 0) * -48px), calc(var(--dock-reg, 0) * -20px));
      }
      :global(.site-header[data-scene] .site-header-logo .logo-plate-m) {
        transform: translate(calc(var(--dock-reg, 0) * 40px), calc(var(--dock-reg, 0) * -30px));
      }
      :global(.site-header[data-scene] .site-header-logo .logo-plate-y) {
        transform: translate(calc(var(--dock-reg, 0) * -18px), calc(var(--dock-reg, 0) * 42px));
      }
    }

    .hero-inner {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-height: 100svh;
      padding-top: calc(var(--header-h) + clamp(0.25rem, 1svh, 0.75rem));
      /* Clear of the mobile call/Viber bar. */
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }

    /* Mobile and tablet: art on top, copy right under it. */
    .hero-grid {
      display: grid;
      flex: 1;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      row-gap: clamp(0.75rem, 2svh, 1.25rem);
    }

    /*
     * Art box: 900 × 620 raster units (choreography.ts ART), the 840-wide mark centred in it.
     * Every pose of the scene stays inside it. Phones: at the right, at most a quarter of the
     * screen below the header tall, so the label, headline, intro and first action fit above the
     * call bar, and short landscape screens never cut a pose.
     */
    .hero-art {
      display: flex;
      align-items: center;
      justify-content: center;
      justify-self: end;
      width: min(100%, (100svh - var(--header-h)) * 0.25 * 900 / 620);
      aspect-ratio: 900 / 620;
    }
    .hero-mark {
      width: calc(100% * 840 / 900);
    }
    .hero-mark :global(svg) {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .hero[data-scene='live'] .hero-mark {
      visibility: hidden;
    }

    /* SVG plate offsets for the CSS intro, in print order Y, M, C, K. */
    .hero-mark :global(.logo-plate[data-plate='y']) {
      --pi: 0;
      --dx: 34px;
      --dy: 24px;
    }
    .hero-mark :global(.logo-plate[data-plate='m']) {
      --pi: 1;
      --dx: -28px;
      --dy: 18px;
    }
    .hero-mark :global(.logo-plate[data-plate='c']) {
      --pi: 2;
      --dx: -36px;
      --dy: -20px;
    }
    .hero-mark :global(.logo-plate[data-plate='k']) {
      --pi: 3;
      --dx: 24px;
      --dy: -26px;
    }

    .hero-copy {
      position: relative;
      max-width: 46rem;
    }
    .hero-sentinel {
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }
    .hero-label {
      margin-bottom: clamp(0.875rem, 2.2svh, 1.5rem);
    }
    .hero-headline {
      position: relative;
    }
    .hero .hero-title {
      margin: 0;
      font-size: clamp(2.5rem, 0.6rem + 6.6vw, 7.25rem);
      text-wrap: balance;
    }
    .hero-h1 {
      position: relative;
      z-index: 1;
      color: var(--color-key);
    }
    .hero-line {
      display: block;
    }
    /* Narrow phones (under 400 px): the longer line (about 8.6 em) still fits the column at
       16 px gutters, with a little room to spare, so the headline keeps its two lines down to
       360 px. */
    @media (max-width: 24.99rem) {
      .hero .hero-title {
        font-size: clamp(2.25rem, 10.25vw, 2.5rem);
      }
    }

    /* C/M/Y ghost copies of the headline, only shown during the intro. */
    .hero-ghosts {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: none;
      pointer-events: none;
      user-select: none;
    }
    .hero .hero-ghost {
      position: absolute;
      inset: 0;
      mix-blend-mode: var(--blend-ink, multiply);
    }
    .hero-ghost-c {
      --gx: -0.06em;
      --gy: -0.035em;
      color: var(--color-cyan);
    }
    .hero-ghost-m {
      --gx: 0.055em;
      --gy: -0.015em;
      color: var(--color-magenta);
    }
    .hero-ghost-y {
      --gx: 0.02em;
      --gy: 0.05em;
      color: var(--color-yellow);
    }

    /* Registration hairline: ties the headline to its lead, like a register line on the sheet. */
    .hero-rule {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      max-width: 34rem;
      margin-top: clamp(1.25rem, 3svh, 2rem);
      color: var(--color-key);
    }
    .hero-rule :global(svg) {
      flex: none;
    }
    .hero-rule-line {
      flex: 1;
      height: 1px;
      background-color: var(--color-key);
    }
    .hero-lead {
      max-width: 44ch;
      margin-top: clamp(0.875rem, 2svh, 1.25rem);
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
      color: var(--color-key);
      text-wrap: pretty;
    }

    .hero-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: clamp(1.5rem, 3.5svh, 2.25rem);
    }

    .hero-about {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-top: clamp(0.5rem, 1.5svh, 1rem);
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-key);
      text-decoration: none;
    }
    .hero-about :global(svg) {
      transition: transform var(--dur-base) var(--ease-out);
    }

    .hero-foot {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: clamp(1.5rem, 4svh, 3rem);
      color: var(--color-key);
    }
    .hero-foot-rule {
      flex: 1;
      height: 1px;
      background-color: var(--color-line);
    }
    .hero-cue {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
    }
    .hero-cue-label {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 750;
      line-height: 1;
      letter-spacing: 0.24em;
      color: var(--color-muted);
    }
    .hero-cue-track {
      position: relative;
      width: 1px;
      height: 2rem;
      overflow: hidden;
      background-color: var(--color-line);
    }
    .hero-cue-drop {
      position: absolute;
      top: 0;
      left: -1px;
      width: 3px;
      height: 0.75rem;
      background-color: var(--color-key);
      animation: hero-cue 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
    .hero[data-offscreen] .hero-cue-drop {
      animation-play-state: paused;
    }

    /* Intro start state: pre-paint class from BaseLayout. */
    :global(html.hero-intro) .hero-mark :global(.logo-plate) {
      opacity: 0;
    }
    :global(html.hero-intro) .hero-ghosts,
    .hero.is-intro .hero-ghosts {
      display: block;
    }
    :global(html.hero-intro) .hero .hero-ghost {
      transform: translate(var(--gx), var(--gy));
    }
    /* Ghosts converge on the key headline and fade (both intros). */
    .hero.is-intro .hero-ghost {
      animation: hero-ghost-in 1.5s both;
    }
    /* SVG intro (no WebGL, or the scene was late): plates print in, out of register, then snap. */
    .hero.is-intro-svg .hero-mark :global(.logo-plate) {
      mix-blend-mode: var(--blend-ink, multiply);
      animation: hero-plate-in 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--pi, 0) * 110ms);
    }

    @media (min-width: 40rem) {
      .hero-actions {
        flex-direction: row;
        flex-wrap: wrap;
      }
      /* Tablets and landscape phones: larger, capped by width and by the screen height. */
      .hero-art {
        width: min(100%, 36rem, (100svh - var(--header-h)) * 0.45 * 900 / 620);
      }
      /* Crop marks at the four corners of the sheet, under the header band. */
      .hero-trim {
        --m: clamp(8px, 1.2vw, 16px);
        --g: clamp(4px, 0.5vw, 7px);
        position: absolute;
        display: block;
        top: calc(var(--header-h) + 0.75rem);
        right: var(--gutter);
        bottom: 0.75rem;
        left: var(--gutter);
        pointer-events: none;
      }
    }

    @media (min-width: 48rem) {
      .hero-inner {
        padding-bottom: clamp(1.75rem, 4svh, 2.75rem);
      }
    }

    /*
     * Desktop: copy in the left 6.5 twelfths, art in the right 5.5. The block is centred
     * vertically between the header and the foot (equal gaps above and below), and the art's
     * centre lines up with the copy's. The art fills its column and bleeds into the right gutter;
     * it shrinks on short viewports so the copy and the foot keep their room. The headline is
     * sized to its column so it keeps two lines (the longer line is about 8.6 em).
     */
    @media (min-width: 64rem) {
      .hero-inner {
        padding-top: calc(var(--header-h) + clamp(1.5rem, 4svh, 3rem));
      }
      .hero-grid {
        grid-template-columns: minmax(0, 6.5fr) minmax(0, 5.5fr);
        align-content: center;
        align-items: center;
        column-gap: calc(var(--grid-gap) * 2);
      }
      .hero-copy {
        grid-row: 1;
        grid-column: 1;
        max-width: none;
      }
      .hero-art {
        grid-row: 1;
        grid-column: 2;
        width: min(100% + var(--gutter), (100svh - var(--header-h) - 10rem) * 900 / 620);
        margin-right: calc(-1 * var(--gutter));
      }
      .hero .hero-title {
        font-size: clamp(2.5rem, 5.6vw - 0.3rem, 5.25rem);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero-about:is(:hover, :focus-visible) :global(svg) {
        transform: translateX(3px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-cue-drop {
        animation: none;
        transform: translateY(0.625rem);
      }
      /* Reduced motion switched on mid-intro: show the composed state at once. */
      .hero.is-intro .hero-ghost,
      .hero.is-intro-svg .hero-mark :global(.logo-plate) {
        animation: none;
      }
      .hero.is-intro .hero-ghosts {
        display: none;
      }
    }

    /*
     * Print: always the light page (global.css), so never the live canvas (its inline blend and
     * clear colour follow the screen theme). The static SVG mark prints in its place, also while
     * the canvas was fading in over it (inline opacity).
     */
    @media print {
      .hero-stage :global(.hero-canvas) {
        display: none;
      }
      .hero[data-scene] .hero-mark {
        visibility: visible;
        opacity: 1 !important;
      }
    }
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-0.75rem);
    }
    70%,
    100% {
      transform: translateY(2rem);
    }
  }

  @keyframes hero-ghost-in {
    0% {
      transform: translate(var(--gx), var(--gy));
      opacity: 1;
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
    55% {
      transform: translate(calc(var(--gx) * 0.45), calc(var(--gy) * 0.45));
      animation-timing-function: cubic-bezier(0.3, 1.5, 0.5, 1);
    }
    85% {
      transform: translate(0, 0);
      opacity: 1;
    }
    100% {
      transform: translate(0, 0);
      opacity: 0;
    }
  }

  @keyframes hero-plate-in {
    0% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy));
    }
    55% {
      opacity: 1;
      transform: translate(calc(var(--dx) * 0.3), calc(var(--dy) * 0.3));
      animation-timing-function: cubic-bezier(0.3, 1.5, 0.5, 1);
    }
    100% {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
</style>
