---
/**
 * Mobile-only bar fixed to the bottom of the screen: call and Viber. A CMYK colour-bar rule runs
 * along its top edge. The call button carries a small C/M plate shadow that collapses into
 * register when pressed; both buttons sink a little on press.
 *
 * Height: 0.5rem + a 3rem button + 0.5rem, plus the safe area, which is `--float-bar-h`
 * (global.css): <body> is padded by it and other fixed UI clears it. Keep the two in step.
 *
 * Typing on a touch screen (a text field, text area or select has focus) slides the bar away, so
 * it never sits on the on-screen keyboard over the field; it returns when the field loses focus.
 * The page padding stays, so nothing moves.
 */
import Icon from './Icon.astro';
import { site } from '~/data/site';
import { t, type Locale } from '~/i18n/ui';
import { telHref, viberHref } from '~/lib/links';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<nav
  class="floating-contact md:hidden"
  aria-label={t('floatingLabel', locale)}
  data-floating-contact
>
  <a href={telHref(site.contact.phone)} class="fc-btn fc-call">
    <Icon name="phone" size={20} />
    <span>{t('callShort', locale)}</span>
  </a>
  <a href={viberHref(site.contact.viber)} class="fc-btn fc-viber">
    <Icon name="viber" size={20} />
    <span>{t('viber', locale)}</span>
  </a>
</nav>

<style>
  @layer components {
    .floating-contact {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 30;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.625rem;
      padding: 0.5rem max(var(--gutter), env(safe-area-inset-right))
        calc(0.5rem + env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
      background-color: var(--color-paper);
      transition:
        translate var(--dur-base) var(--ease-out),
        visibility 0s linear 0s;
    }
    /* Typing (script below): out of the way of the on-screen keyboard and out of the tab order. */
    .floating-contact[data-typing] {
      translate: 0 100%;
      visibility: hidden;
      transition:
        translate var(--dur-base) var(--ease-out),
        visibility 0s linear var(--dur-base);
    }
    @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
      .floating-contact {
        background-color: color-mix(in srgb, var(--color-paper) 88%, transparent);
        -webkit-backdrop-filter: blur(12px) saturate(1.2);
        backdrop-filter: blur(12px) saturate(1.2);
      }
    }
    /* The press colour bar as the bar's top rule. */
    .floating-contact::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 3px;
      background-image: linear-gradient(
        90deg,
        var(--color-cyan) 0 25%,
        var(--color-magenta) 25% 50%,
        var(--color-yellow) 50% 75%,
        var(--color-key) 75% 100%
      );
      pointer-events: none;
    }
    .fc-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 3rem;
      font-family: var(--font-display);
      font-weight: 720;
      text-decoration: none;
      border: 2px solid var(--color-key);
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      transition:
        transform var(--dur-fast) var(--ease-out),
        box-shadow var(--dur-fast) var(--ease-out),
        background-color var(--dur-fast) linear;
    }
    .fc-call {
      background: var(--color-key);
      color: var(--color-paper);
      box-shadow:
        2px 2px 0 var(--color-cyan),
        4px 4px 0 var(--color-magenta);
    }
    .fc-viber {
      background: var(--color-paper);
      color: var(--color-key);
    }
    @media (hover: hover) {
      .fc-viber:hover {
        background: var(--color-paper-2);
      }
    }
    /* Press: the plates snap into register and the button sinks onto the sheet. */
    .fc-call:active {
      box-shadow: 0 0 0 transparent;
    }
    @media (prefers-reduced-motion: no-preference) {
      .fc-call:active {
        transform: translate(2px, 2px);
      }
      .fc-viber:active {
        transform: translateY(1px) scale(0.98);
      }
    }
    .fc-viber:active {
      background: var(--color-paper-2);
    }

    /* Page changes: the bar stays in place and only cross-fades (global.css), except during the
       theme's circular reveal, which covers it with the rest of the page. */
    @media (prefers-reduced-motion: no-preference) {
      .floating-contact {
        view-transition-name: floating-contact;
      }
      :global(html.theme-vt) .floating-contact {
        view-transition-name: none;
      }
    }

    /* Print: a fixed bar would repeat over the content of every printed page. */
    @media print {
      .floating-contact {
        display: none !important;
      }
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-floating-contact]');
  /** Input types that bring up no keyboard or picker. */
  const NO_KEYBOARD = [
    'checkbox',
    'radio',
    'button',
    'submit',
    'reset',
    'range',
    'color',
    'file',
    'image',
    'hidden',
  ];
  /** Fields that bring up the on-screen keyboard (or a picker) when focused. */
  const TYPING_FIELD = [
    'textarea',
    'select',
    '[contenteditable]:not([contenteditable="false"])',
    `input:not(${NO_KEYBOARD.map((type) => `[type="${type}"]`).join(', ')})`,
  ].join(', ');
  const touch = matchMedia('(hover: none) and (pointer: coarse)');

  if (bar) {
    let queued = 0;
    // Checked after the focus has settled: moving from one field to the next fires focusout
    // before focusin, which must not flash the bar in between.
    const sync = (): void => {
      queued = 0;
      const active = document.activeElement;
      bar.toggleAttribute(
        'data-typing',
        touch.matches && active instanceof HTMLElement && active.matches(TYPING_FIELD),
      );
    };
    const queue = (): void => {
      if (!queued) queued = window.setTimeout(sync, 0);
    };
    document.addEventListener('focusin', queue);
    document.addEventListener('focusout', queue);
    touch.addEventListener('change', queue);
  }
</script>
