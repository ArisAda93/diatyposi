---
/**
 * Dark theme toggle (wired by initThemeToggle in src/scripts/theme.ts, once per page).
 *
 * A toggle button: `aria-pressed="true"` means the dark theme is on; the accessible name is
 * “Σκούρο θέμα” and never changes. The script sets `aria-pressed` and the state word
 * (`[data-theme-state]`, from `data-on` / `data-off`) on every toggle after each change. The
 * visuals follow `html[data-theme]` directly, so they are right from first paint.
 *
 * variant:
 *  - icon  44px icon button (header): the sun turns and shrinks away as the moon turns in (and
 *          back); on hover the glyph turns slightly while C/M/Y ghosts slip out of register and
 *          snap back, and a tooltip names it with its state.
 *  - row   a labelled full-width row with a square switch (menu dialog foot).
 *
 * Every animation is off under reduced motion. Without JS the toggle is hidden (the page stays
 * light then; see global.css).
 */
import Icon from './Icon.astro';
import { t, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
  variant?: 'icon' | 'row';
  class?: string;
}

const { locale, variant = 'icon', class: className } = Astro.props;
const label = t('themeToggle', locale);
const on = t('themeOn', locale);
const off = t('themeOff', locale);
/** Ghost plates first, the key plate last (on top). */
const plates = ['c', 'm', 'y', 'k'] as const;
---

{variant === 'icon' ? (
  <button
    type="button"
    class:list={['icon-btn', 'theme-toggle', className]}
    aria-label={label}
    aria-pressed="false"
    data-theme-toggle
  >
    <span class="theme-glyph" aria-hidden="true">
      {plates.map((p) => (
        <span class={`theme-plate theme-plate-${p}`}>
          <Icon name="sun" size={22} class="theme-anim theme-sun" />
          <Icon name="moon" size={22} class="theme-anim theme-moon" />
        </span>
      ))}
    </span>
    <span class="theme-tip" aria-hidden="true">
      {label} ·{' '}
      <span data-theme-state data-on={on} data-off={off}>
        {off}
      </span>
    </span>
  </button>
) : (
  <button
    type="button"
    class:list={['theme-row', className]}
    aria-pressed="false"
    data-theme-toggle
  >
    <span class="theme-glyph" aria-hidden="true">
      <span class="theme-plate theme-plate-k">
        <Icon name="sun" size={22} class="theme-anim theme-sun" />
        <Icon name="moon" size={22} class="theme-anim theme-moon" />
      </span>
    </span>
    <span class="theme-row-label">{label}</span>
    <span class="theme-row-state" aria-hidden="true" data-theme-state data-on={on} data-off={off}>
      {off}
    </span>
    <span class="theme-switch" aria-hidden="true">
      <span class="theme-switch-knob theme-anim"></span>
    </span>
  </button>
)}

<style>
  @layer components {
    /* Without JS there is nothing to switch: the page stays light. */
    :global(html.no-js) .theme-toggle,
    :global(html.no-js) .theme-row {
      display: none;
    }

    .theme-toggle {
      cursor: pointer;
    }

    /* ------------------------------------------------------------------------------------ */
    /* Glyph: sun (light) and moon (dark) stacked; the theme picks one.                     */
    /* ------------------------------------------------------------------------------------ */
    .theme-glyph {
      display: inline-grid;
      flex: none;
      width: 22px;
      height: 22px;
      transition: rotate var(--dur-base) var(--ease-out);
    }
    .theme-plate {
      display: grid;
      grid-area: 1 / 1;
    }
    .theme-plate :global(svg) {
      grid-area: 1 / 1;
      transform-origin: 50% 50%;
      transition:
        transform 560ms var(--ease-snap),
        opacity 280ms var(--ease-out);
    }
    .theme-plate :global(.theme-moon) {
      opacity: 0;
      transform: rotate(-90deg) scale(0.4);
    }
    :global(html[data-theme='dark']) .theme-plate :global(.theme-sun) {
      opacity: 0;
      transform: rotate(90deg) scale(0.4);
    }
    :global(html[data-theme='dark']) .theme-plate :global(.theme-moon) {
      opacity: 1;
      transform: none;
    }

    /*
     * Registration ghosts (hover, pointer devices): the C/M/Y plates slip out of register and
     * snap back under the key plate. The hovered face is inverted (.icon-btn: key fill), so the
     * inks overprint it the opposite way to the page: screen on the dark face of the light
     * theme, multiply on the light face of the dark theme.
     */
    .theme-plate:not(.theme-plate-k) {
      opacity: 0;
      mix-blend-mode: screen;
    }
    :global(html[data-theme='dark']) .theme-plate:not(.theme-plate-k) {
      mix-blend-mode: multiply;
    }
    .theme-plate-c {
      color: var(--color-cyan);
    }
    .theme-plate-m {
      color: var(--color-magenta);
    }
    .theme-plate-y {
      color: var(--color-yellow);
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .theme-toggle:hover .theme-glyph {
        rotate: 18deg;
      }
      .theme-toggle:hover .theme-plate-c {
        animation: theme-ghost-c 640ms var(--ease-snap) both;
      }
      .theme-toggle:hover .theme-plate-m {
        animation: theme-ghost-m 640ms var(--ease-snap) 30ms both;
      }
      .theme-toggle:hover .theme-plate-y {
        animation: theme-ghost-y 640ms var(--ease-snap) 60ms both;
      }
    }

    /* ------------------------------------------------------------------------------------ */
    /* Tooltip (icon variant): name and state, under the button.                            */
    /* ------------------------------------------------------------------------------------ */
    .theme-tip {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 50%;
      z-index: 5;
      padding: 0.375rem 0.625rem;
      background-color: var(--color-key);
      color: var(--color-paper);
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
      opacity: 0;
      translate: -50% -4px;
      pointer-events: none;
      transition:
        opacity var(--dur-fast) linear,
        translate var(--dur-base) var(--ease-out);
    }
    .theme-toggle:focus-visible .theme-tip {
      opacity: 1;
      translate: -50% 0;
    }
    @media (hover: hover) {
      .theme-toggle:hover .theme-tip {
        opacity: 1;
        translate: -50% 0;
        transition-delay: 300ms;
      }
    }

    /* ------------------------------------------------------------------------------------ */
    /* Row (menu): icon, label, state, square switch.                                       */
    /* ------------------------------------------------------------------------------------ */
    .theme-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      min-height: 3rem;
      padding-block: 0.5rem;
      border-block: 1px solid var(--color-line);
      background: transparent;
      color: var(--color-key);
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.2;
      text-align: left;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .theme-row-label {
      flex: 1;
    }
    .theme-row-state {
      color: var(--color-muted);
      font-family: var(--font-sans);
      font-size: var(--text-small);
      font-weight: 500;
    }
    .theme-switch {
      position: relative;
      flex: none;
      width: 2.75rem;
      height: 1.5rem;
      border: 2px solid var(--color-key);
      transition:
        background-color var(--dur-fast) linear,
        box-shadow var(--dur-base) var(--ease-out);
    }
    .theme-switch-knob {
      position: absolute;
      top: 2px;
      left: 2px;
      width: calc(1.5rem - 8px);
      height: calc(1.5rem - 8px);
      background-color: var(--color-key);
      transition:
        translate var(--dur-base) var(--ease-snap),
        background-color var(--dur-fast) linear;
    }
    :global(html[data-theme='dark']) .theme-switch {
      background-color: var(--color-key);
    }
    :global(html[data-theme='dark']) .theme-switch-knob {
      background-color: var(--color-paper);
      translate: calc(2.75rem - 1.5rem) 0;
    }
    .theme-row:focus-visible .theme-switch {
      box-shadow:
        2px 2px 0 var(--color-cyan),
        4px 4px 0 var(--color-magenta),
        6px 6px 0 var(--color-yellow);
    }
    /* Hover only where the pointer can hover (a tap must not leave the plates out). */
    @media (hover: hover) {
      .theme-row:hover .theme-switch {
        box-shadow:
          2px 2px 0 var(--color-cyan),
          4px 4px 0 var(--color-magenta),
          6px 6px 0 var(--color-yellow);
      }
    }

    /* Forced colours repaint backgrounds as the canvas: keep the switch's knob and fill drawn. */
    @media (forced-colors: active) {
      .theme-switch-knob {
        background-color: CanvasText;
      }
      :global(html[data-theme='dark']) .theme-switch {
        background-color: Canvas;
      }
      :global(html[data-theme='dark']) .theme-switch-knob {
        background-color: CanvasText;
      }
    }
  }

  @keyframes theme-ghost-c {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    35% {
      opacity: 1;
      transform: translate(-2.5px, -1.5px);
    }
  }
  @keyframes theme-ghost-m {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    35% {
      opacity: 1;
      transform: translate(2.5px, -1px);
    }
  }
  @keyframes theme-ghost-y {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    35% {
      opacity: 1;
      transform: translate(-1px, 2.5px);
    }
  }
</style>
