---
/**
 * The quote form's "ready" panel, shown in place of the form after a valid submit. The visitor
 * pressed one of the three send buttons (QuoteForm.astro); src/scripts/quote-form.ts composes the
 * message, fills this panel, shows it, moves focus to its heading and opens the chosen app
 * (email, Viber or WhatsApp) with the message prefilled to the shop. The site itself sends
 * nothing: the message goes only if the visitor sends it from their app.
 *
 * The panel says the message is ready and to press send in the app, reminds that files (which
 * the form cannot carry) can be attached to the same message, and, in case the app did not open,
 * offers the shop's email address, the three send links again and the composed text to copy
 * (behind a disclosure). “Πίσω στη φόρμα” brings the form back with everything kept; “Νέο αίτημα”
 * clears it and brings it back.
 *
 * The hrefs below are plain fallbacks; the script adds the subject and the composed text. Email
 * and Viber open the app itself (mailto:, viber://). WhatsApp uses its Click to Chat address
 * (https://wa.me), the link WhatsApp prefills on every platform, so it opens in a new tab and the
 * panel stays. When Viber or WhatsApp opens, the script also copies the message and says so in
 * `[data-chat-hint]`, in case the app opens the chat without the text.
 *
 * The panel prints in from the top; the check is stamped on with a C/M plate that snaps into
 * register. Reduced motion: it simply appears.
 */
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { contactText } from '~/i18n/pages/contact';
import { t } from '~/i18n/ui';
import { mailtoHref, viberHref, whatsappMessageHref } from '~/lib/links';

const text = contactText.el.result.ready;
---

<div class="result" data-result="ready" hidden>
  <h3 class="h3 result-heading" tabindex="-1" data-result-heading>
    <span class="result-mark result-mark-ok" aria-hidden="true">
      <Icon name="check" size={26} />
    </span>
    <span>{text.heading}</span>
  </h3>
  <p class="result-text">{text.text}</p>
  <p class="result-text result-chat-hint" role="status" data-chat-hint></p>
  <p class="result-text result-files">
    <Icon name="paperclip" size={22} />
    <span>{text.files}</span>
  </p>

  <div class="result-box">
    <h4 class="result-subhead">{text.notOpenedHeading}</h4>
    <p class="result-hint">
      {`${text.notOpenedHint} `}
      <a href={mailtoHref(site.contact.email)} class="link result-email">
        {site.contact.email}
      </a>
      .
    </p>
    <div class="send-actions">
      <a href={mailtoHref(site.contact.email)} class="btn btn-secondary" data-send="email">
        <Icon name="mail" />
        <span>{text.email}</span>
      </a>
      <a href={viberHref(site.contact.viber)} class="btn btn-secondary" data-send="viber">
        <Icon name="viber" />
        <span>{text.viber}</span>
      </a>
      <a
        href={whatsappMessageHref(site.contact.whatsapp)}
        class="btn btn-secondary"
        target="_blank"
        rel="noopener"
        data-send="whatsapp"
      >
        <Icon name="whatsapp" />
        <span>{text.whatsapp}</span>
        <span class="sr-only">{` ${t('newTab')}`}</span>
      </a>
    </div>

    <details class="result-copy">
      <summary class="result-copy-summary">
        <Icon name="chevron-right" size={20} class="result-copy-chevron" />
        <span>{text.previewSummary}</span>
      </summary>
      <div class="send-preview">
        <label for="q-preview" class="field-label">
          {text.previewLabel}
        </label>
        <p id="q-preview-hint" class="result-hint">
          {text.previewHint}
        </p>
        <textarea
          id="q-preview"
          class="input preview-text"
          rows="10"
          readonly
          aria-describedby="q-preview-hint"
          data-preview
        ></textarea>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="button" class="btn btn-secondary" data-copy>
            <Icon name="copy" />
            <span>{text.copy}</span>
          </button>
          <p class="text-small" role="status" data-copy-status></p>
        </div>
      </div>
    </details>
  </div>

  <div class="result-actions">
    <button type="button" class="text-action text-action-back" data-edit>
      <Icon name="chevron-left" size={20} />
      <span class="link">{text.edit}</span>
    </button>
    <button type="button" class="text-action" data-again>
      <span class="link">{text.again}</span>
      <Icon name="arrow-right" size={20} />
    </button>
  </div>
</div>

<style>
  @layer components {
    .result {
      display: flex;
      flex-direction: column;
      container-type: inline-size;
    }
    .result-heading {
      display: flex;
      align-items: flex-start;
      gap: 0.875rem;
      outline-offset: 6px;
    }
    /* The panel's stamp: a square yellow plate with an ink check. */
    .result-mark {
      flex: none;
      display: grid;
      place-items: center;
      width: 2.125rem;
      height: 2.125rem;
      margin-top: 0.05em;
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 850;
      line-height: 1;
    }
    .result-mark-ok {
      background: var(--color-yellow);
      /* Ink on yellow in both themes. */
      color: var(--ink-fixed);
    }
    .result-text {
      max-width: 52ch;
      margin-top: 0.875rem;
    }
    /* The "text copied" note after Viber or WhatsApp opens. While empty it takes no room but stays
       rendered, so the status region is in the accessibility tree and its text gets announced. */
    .result-chat-hint {
      font-weight: 600;
    }
    .result-chat-hint:empty {
      margin-top: 0;
    }

    /* The files note: a paperclip beside the text. */
    .result-files {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .result-files :global(svg) {
      flex: none;
      margin-top: 0.1em;
    }

    /* A paper box with a key rule: the fallback when the app did not open. */
    .result-box {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.75rem;
      padding: 1.125rem 1.125rem 1.25rem 1.25rem;
      background-color: var(--color-paper);
      border-left: 4px solid var(--color-key);
    }
    .result-subhead {
      font-family: var(--font-display);
      font-weight: 720;
      font-size: 1.0625rem;
      line-height: 1.3;
    }
    .result-hint {
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      color: var(--color-muted);
    }
    /* The shop's address keeps the link look but takes a hit area at least 44px tall, centred on
       the link whatever its line box rounds to; a long address may break anywhere. */
    .result-email {
      position: relative;
      overflow-wrap: anywhere;
    }
    .result-email::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -0.25rem;
      left: -0.25rem;
      height: max(2.75rem, 100%);
      translate: 0 -50%;
    }

    .send-actions {
      display: grid;
      gap: 0.625rem;
      margin-top: 0.25rem;
    }
    .send-actions .btn {
      justify-content: flex-start;
      white-space: normal;
    }
    @container (min-width: 34rem) {
      .send-actions {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .send-actions .btn {
        justify-content: center;
        padding-inline: 1rem;
      }
    }

    /* The copyable text, folded away under the send buttons. */
    .result-copy {
      margin-top: 0.25rem;
    }
    .result-copy-summary {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-height: 2.75rem;
      font-family: var(--font-display);
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }
    .result-copy-summary::-webkit-details-marker {
      display: none;
    }
    .result-copy-summary :global(.result-copy-chevron) {
      flex: none;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .result-copy[open] .result-copy-summary :global(.result-copy-chevron) {
      transform: rotate(90deg);
    }
    @media (hover: hover) {
      .result-copy-summary:hover > span {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }
    }
    .send-preview {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    /* Beats the shared .quote .input rule (QuoteForm.astro). */
    .send-preview .preview-text {
      min-height: 12rem;
      resize: vertical;
      font-size: 0.9375rem;
      line-height: 1.6;
      overflow-wrap: anywhere;
    }
    /* Touch screens: 16px, so focusing the text (the copy fallback selects it) never zooms iOS. */
    @media (pointer: coarse) {
      .send-preview .preview-text {
        font-size: 1rem;
      }
    }

    /* Quiet text actions: “Πίσω στη φόρμα” and “Νέο αίτημα” (44px tall), side by side when they
       fit. */
    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.75rem;
      margin-top: 1.5rem;
    }
    .text-action {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-height: 2.75rem;
      font-family: var(--font-display);
      font-weight: 700;
      cursor: pointer;
    }
    .text-action :global(svg) {
      flex: none;
      transition: transform var(--dur-base) var(--ease-out);
    }
    @media (prefers-reduced-motion: no-preference) {
      .text-action:focus-visible :global(svg) {
        transform: translateX(4px);
      }
      .text-action-back:focus-visible :global(svg) {
        transform: translateX(-4px);
      }
    }
    @media (prefers-reduced-motion: no-preference) and (hover: hover) {
      .text-action:hover :global(svg) {
        transform: translateX(4px);
      }
      .text-action-back:hover :global(svg) {
        transform: translateX(-4px);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .result:not([hidden]) {
        /* No fill: the clip must not outlast the animation (it would cut focus rings). */
        animation: result-print 560ms var(--ease-out);
      }
      .result:not([hidden]) .result-mark-ok {
        animation: result-stamp 700ms var(--ease-snap) 160ms both;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .result-copy-summary :global(.result-copy-chevron) {
        transition: none;
      }
    }
    @media (forced-colors: active) {
      .result-mark {
        border: 2px solid CanvasText;
      }
    }
  }

  @keyframes result-print {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes result-stamp {
    0% {
      transform: scale(1.6) rotate(-12deg);
      box-shadow:
        -5px -4px 0 var(--color-cyan),
        5px 4px 0 var(--color-magenta);
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    100% {
      transform: none;
      box-shadow:
        0 0 0 transparent,
        0 0 0 transparent;
      opacity: 1;
    }
  }
</style>
