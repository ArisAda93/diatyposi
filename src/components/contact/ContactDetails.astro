---
/**
 * Contact page, left column: phone (the owner's mobile, the shop's only phone), email and address
 * from `site`, quick Viber and WhatsApp links (both open the app), opening hours and social
 * links. Rows answer the pointer (the term darkens, a key rule runs in at the row's start); the
 * social links sink on press.
 *
 * The phone and email rows are tap targets end to end: the link's hit area stretches over its
 * whole row (`.cd-action::after`), and a small plate at the row's end shows what a tap does
 * (call, write). A press prints that plate in key.
 */
import Icon from '~/components/Icon.astro';
import OpeningHours from './OpeningHours.astro';
import { site } from '~/data/site';
import { t } from '~/i18n/ui';
import { contactText } from '~/i18n/pages/contact';
import { mailtoHref, telHref, viberHref, whatsappHref } from '~/lib/links';
import { capsEl } from '~/lib/text';

const text = contactText.el.details;
---

<section class="contact-details" aria-labelledby="contact-details-title">
  <div class="cd-block">
    <h2 id="contact-details-title" class="label">
      {capsEl(text.heading)}
    </h2>
    <address class="cd-list">
      <dl>
        <div class="cd-row cd-row-link">
          <dt class="cd-term">{t('phoneLabel')}</dt>
          <dd>
            <a href={telHref(site.contact.phone)} class="cd-big cd-action link-draw">
              {site.contact.phoneDisplay}
            </a>
            <span class="cd-go" aria-hidden="true">
              <Icon name="phone" size={20} />
            </span>
          </dd>
        </div>
        <div class="cd-row cd-row-link">
          <dt class="cd-term">{t('emailLabel')}</dt>
          <dd>
            <a href={mailtoHref(site.contact.email)} class="cd-mail cd-action link-draw">
              {site.contact.email}
            </a>
            <span class="cd-go" aria-hidden="true">
              <Icon name="mail" size={20} />
            </span>
          </dd>
        </div>
        <div class="cd-row">
          <dt class="cd-term">{t('addressLabel')}</dt>
          <dd class="cd-text">
            {site.address.street}
            <br />
            {`${site.address.postalCode} ${site.address.city}`}
          </dd>
        </div>
      </dl>
    </address>
  </div>

  <div class="cd-block">
    <h3 class="label">{capsEl(text.quickHeading)}</h3>
    <div class="cd-quick">
      <a href={viberHref(site.contact.viber)} class="btn btn-secondary">
        <Icon name="viber" />
        <span>{text.viber}</span>
      </a>
      <a href={whatsappHref(site.contact.whatsapp)} class="btn btn-secondary">
        <Icon name="whatsapp" />
        <span>{text.whatsapp}</span>
      </a>
    </div>
  </div>

  <OpeningHours />

  <div class="cd-block">
    <h3 class="label">{capsEl(t('followUs'))}</h3>
    <ul class="cd-social">
      <li>
        <a href={site.social.facebook} class="cd-social-link" aria-label={t('facebookLabel')}>
          <Icon name="facebook" size={22} />
          <span>Facebook</span>
        </a>
      </li>
      <li>
        <a href={site.social.instagram} class="cd-social-link" aria-label={t('instagramLabel')}>
          <Icon name="instagram" size={22} />
          <span>Instagram</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  @layer components {
    .contact-details {
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    }
    .cd-list {
      font-style: normal;
    }
    .cd-row {
      position: relative;
      display: grid;
      gap: 0.25rem;
      padding-block: 1rem;
      border-bottom: 1px solid var(--color-line);
    }
    /* A key rule runs in along the row's top edge when the pointer is on it. */
    .cd-row::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 0;
      width: 3rem;
      height: 2px;
      background-color: var(--color-key);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform var(--dur-base) var(--ease-out);
    }
    .cd-row:focus-within::before,
    .cd-row-link:active::before {
      transform: scaleX(1);
    }
    .cd-row:focus-within .cd-term,
    .cd-row-link:active .cd-term {
      color: var(--color-key);
    }
    @media (hover: hover) {
      .cd-row:hover::before {
        transform: scaleX(1);
      }
      .cd-row:hover .cd-term {
        color: var(--color-key);
      }
    }
    /* Linked rows: room at the end for the plate; the link covers the whole row. */
    .cd-row-link {
      padding-right: 3.5rem;
    }
    .cd-action::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .cd-go {
      position: absolute;
      top: 50%;
      right: 0;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid var(--color-line);
      color: var(--color-key);
      translate: 0 -50%;
      pointer-events: none;
      transition:
        background-color var(--dur-fast) linear,
        border-color var(--dur-fast) linear,
        color var(--dur-fast) linear;
    }
    .cd-row-link:is(:focus-within, :active) .cd-go {
      border-color: var(--color-key);
    }
    .cd-row-link:active .cd-go {
      background-color: var(--color-key);
      color: var(--color-paper);
    }
    @media (hover: hover) {
      .cd-row-link:hover .cd-go {
        background-color: var(--color-key);
        border-color: var(--color-key);
        color: var(--color-paper);
      }
    }
    .cd-row:first-child {
      border-top: 2px solid var(--color-key);
    }
    .cd-term {
      font-size: var(--text-small);
      color: var(--color-muted);
      transition: color var(--dur-fast) linear;
    }
    /* Tap target: at least 44px tall at every width. */
    .cd-big {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      font-family: var(--font-display);
      font-size: var(--text-h3);
      line-height: 1.25;
      font-weight: 780;
      letter-spacing: -0.01em;
      font-variant-numeric: tabular-nums;
      padding-block: 0.25rem;
    }
    .cd-mail {
      display: inline-block;
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 700;
      overflow-wrap: anywhere;
      padding-block: 0.5rem;
    }
    .cd-text {
      font-size: 1.0625rem;
    }
    .cd-block {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .cd-quick {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .cd-social {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    /* Phones: the two quick-message buttons stack at full width (side by side they would wrap
       unevenly), and the social links share the row while both fit, else stack. */
    @media (max-width: 39.99rem) {
      .cd-quick {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
      }
      .cd-quick .btn {
        justify-content: flex-start;
        white-space: normal;
      }
      .cd-social {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
      }
      .cd-social .cd-social-link {
        display: flex;
      }
    }
    .cd-social-link {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 2.75rem;
      padding: 0.5rem 1rem 0.5rem 0.75rem;
      border: 2px solid var(--color-key);
      font-family: var(--font-display);
      font-weight: 700;
      text-decoration: none;
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear;
    }
    .cd-social-link:active {
      background-color: var(--color-key);
      color: var(--color-paper);
    }
    @media (hover: hover) {
      .cd-social-link:hover {
        background-color: var(--color-key);
        color: var(--color-paper);
      }
    }
    @media (prefers-reduced-motion: no-preference) {
      .cd-social-link {
        transition:
          background-color var(--dur-fast) linear,
          color var(--dur-fast) linear,
          transform var(--dur-fast) var(--ease-out);
      }
      .cd-social-link:active {
        transform: translate(1px, 2px);
      }
    }
  }
</style>
