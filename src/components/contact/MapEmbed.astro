---
/**
 * The shop on a Google map. The box holds Google's embed of the shop's street address
 * (`site.address.mapQuery`), lazy-loaded and shown without JS. The whole box is one link to the
 * same address in Google Maps (`site.address.mapUrl`): a new tab on desktop, the Google Maps app
 * on phones. The map
 * itself is out of the way of keyboard and screen readers (`tabindex="-1"`, `aria-hidden`,
 * `inert`; the link lies over it), so the link is the box's only stop. A chip at the bottom
 * corner says what a tap does; hovering or focusing the box prints it in key and pulls its C/M
 * plates into register.
 *
 * Loading: until the iframe reports `load`, a halftone screen covers the map (`data-loading`),
 * sweeping unless reduced motion is asked for. The iframe's own `onload` lifts it, so a map that
 * loads before the page's scripts run is never kept hidden; a fallback lifts it LOADING_MAX_MS
 * after the box comes into view, so a blocked or slow map shows whatever it has. Without JS the
 * screen never shows.
 */
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import { t } from '~/i18n/ui';
import { contactText } from '~/i18n/pages/contact';
import { capsEl } from '~/lib/text';

const text = contactText.el.map;
const { street, postalCode, city, mapQuery, mapUrl } = site.address;
const embedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&hl=el&z=17&output=embed`;
const fullAddress = `${street}, ${postalCode} ${city}`;
---

<section class="map" aria-labelledby="map-title">
  <h2 id="map-title" class="label">
    {capsEl(text.heading)}
  </h2>
  <p class="map-address">
    <Icon name="pin" size={22} />
    <span>{`${street}, ${city}`}</span>
  </p>

  <div class="map-box crop-frame" data-map data-loading data-reveal="depth">
    <iframe
      class="map-frame"
      src={embedSrc}
      title={text.iframeTitle}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      tabindex="-1"
      aria-hidden="true"
      inert
      onload="this.parentElement.removeAttribute('data-loading')"
    ></iframe>
    <a href={mapUrl} class="map-link" target="_blank" rel="noopener">
      <span class="map-chip">
        <Icon name="external" size={20} />
        <span>
          {text.open}
          <span class="sr-only">{`: ${fullAddress} ${t('newTab')}`}</span>
        </span>
      </span>
    </a>
  </div>
</section>

<script>
  /** Longest the loading screen stays once the map is in view, if the iframe never says `load`. */
  const LOADING_MAX_MS = 6000;

  const boxes = document.querySelectorAll<HTMLElement>('[data-map][data-loading]');
  if (boxes.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const box = entry.target as HTMLElement;
        observer.unobserve(box);
        window.setTimeout(() => box.removeAttribute('data-loading'), LOADING_MAX_MS);
      }
    });
    boxes.forEach((box) => observer.observe(box));
  } else {
    boxes.forEach((box) => box.removeAttribute('data-loading'));
  }
</script>

<style>
  @layer components {
    .map {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .map-address {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-weight: 600;
    }
    .map-address :global(svg) {
      flex: none;
      margin-top: 0.1em;
    }

    /* The crop marks sit 20px outside the box: keep that room so they never overflow. */
    .map-box {
      position: relative;
      margin: 1.75rem 1.25rem 1.25rem;
      aspect-ratio: 4 / 3;
      background-color: var(--color-paper-2);
      border: 1px solid var(--color-line);
    }
    /* Phones: a square box (a 4 / 5 one under 360px), so the map shows the streets around the
       shop and not only a strip. */
    @media (max-width: 39.99rem) {
      .map-box {
        aspect-ratio: 1;
      }
    }
    @media (max-width: 359.98px) {
      .map-box {
        aspect-ratio: 4 / 5;
      }
    }
    /* Landscape phones: 4 / 3 of the full width would be taller than the screen; take most of
       the screen's height instead. */
    @media (orientation: landscape) and (max-height: 30rem) {
      .map-box {
        aspect-ratio: auto;
        min-height: 16rem;
        min-height: max(16rem, 72svh);
      }
    }
    .map-frame {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* Loading: a halftone screen over the map until it has arrived, then it fades away. */
    .map-box::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      color: var(--color-muted);
      background-color: var(--color-paper-2);
      background-image: radial-gradient(circle at center, currentColor 0 1.2px, transparent 1.8px);
      background-size: 10px 10px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--dur-slow) var(--ease-out),
        visibility 0s linear var(--dur-slow);
    }
    .map-box[data-loading]::after {
      opacity: 1;
      visibility: visible;
      transition: none;
    }
    :global(.no-js) .map-box[data-loading]::after {
      display: none;
    }
    @media (prefers-reduced-motion: no-preference) {
      .map-box[data-loading]::after {
        animation: map-screen 1.2s linear infinite;
      }
    }
    @keyframes map-screen {
      to {
        background-position: 10px 10px;
      }
    }

    /* The whole box is the link; the chip at its bottom corner names it. */
    .map-link {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: clamp(0.75rem, 0.5rem + 1vw, 1rem);
      color: var(--color-key);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      transition: box-shadow var(--dur-fast) linear;
    }
    .map-link:is(:focus-visible, :active) {
      box-shadow: inset 0 0 0 2px var(--color-key);
    }
    @media (hover: hover) {
      .map-link:hover {
        box-shadow: inset 0 0 0 2px var(--color-key);
      }
    }
    .map-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      max-width: calc(100% - 4px);
      min-height: 2.75rem;
      padding: 0.5rem 0.875rem 0.5rem 0.75rem;
      font-family: var(--font-display);
      font-weight: 700;
      line-height: 1.25;
      background-color: var(--color-paper);
      color: var(--color-key);
      border: 2px solid var(--color-key);
      box-shadow:
        2px 2px 0 var(--color-cyan),
        4px 4px 0 var(--color-magenta);
      transition:
        background-color var(--dur-fast) linear,
        color var(--dur-fast) linear,
        box-shadow var(--dur-base) var(--ease-out);
    }
    .map-chip :global(svg) {
      flex: none;
    }
    .map-link:is(:focus-visible, :active) .map-chip {
      background-color: var(--color-key);
      color: var(--color-paper);
      box-shadow: 0 0 0 transparent;
    }
    @media (hover: hover) {
      .map-link:hover .map-chip {
        background-color: var(--color-key);
        color: var(--color-paper);
        box-shadow: 0 0 0 transparent;
      }
    }
    /* Press: the chip sinks onto the sheet as its plates come into register. */
    @media (prefers-reduced-motion: no-preference) {
      .map-chip {
        transition:
          background-color var(--dur-fast) linear,
          color var(--dur-fast) linear,
          box-shadow var(--dur-base) var(--ease-out),
          transform var(--dur-fast) var(--ease-out);
      }
      .map-link:active .map-chip {
        transform: translate(2px, 2px);
      }
    }
  }
</style>
