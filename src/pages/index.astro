---
/**
 * Αρχική. Section order follows DESIGN.md §6: hero (the page's single h1, with the owner's intro),
 * services, the idea journey, selected work (hidden while `hiddenSections.work`), values, statement, contact band.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import ServicesShowcase from '~/components/home/ServicesShowcase.astro';
import IdeaJourney from '~/components/home/IdeaJourney.astro';
import WorkTeaser from '~/components/home/WorkTeaser.astro';
import Values from '~/components/home/Values.astro';
import Statement from '~/components/home/Statement.astro';
import ContactBand from '~/components/ContactBand.astro';
import SectionRail from '~/components/SectionRail.astro';
import { hiddenSections } from '~/data/site';
import { homeText } from '~/i18n/pages/home';
import { withLocality } from '~/lib/seo';
---

<BaseLayout
  title={withLocality(homeText.el.metaTitle)}
  description={homeText.el.metaDescription}
  structuredData
  heroHeader
>
  <Hero />
  <ServicesShowcase />
  <IdeaJourney />
  {!hiddenSections.work && <WorkTeaser />}
  <Values />
  <Statement />
  <ContactBand />
  <SectionRail />
</BaseLayout>
