---
/**
 * Πολιτική απορρήτου: a plain reading page that describes what this static site actually does.
 * The text (src/i18n/pages/privacy.ts) is the launch version, written to match what the site
 * does; README lists the open owner item. When the site's behaviour changes, update the text and
 * `updatedDate` / `updatedIso` together.
 *
 * Layout: a calm reading column (68ch) on the 12-column grid; from 1024px a sticky contents list
 * sits beside it (columns 1–3) and each section heading carries its number. No background is
 * painted, so the living background shows (`data-bg-accent`).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { site } from '~/data/site';
import { t } from '~/i18n/ui';
import { privacyText } from '~/i18n/pages/privacy';
import { mailtoHref, telHref } from '~/lib/links';
import { capsEl } from '~/lib/text';

const text = privacyText.el;
/** Section anchors and headings, in page order (contents list and heading numbers). */
const toc = [
  { id: 'pp-who', heading: text.who.heading },
  { id: 'pp-tracking', heading: text.tracking.heading },
  { id: 'pp-form', heading: text.form.heading },
  { id: 'pp-use', heading: text.use.heading },
  { id: 'pp-recipients', heading: text.recipients.heading },
  { id: 'pp-map', heading: text.map.heading },
  { id: 'pp-links', heading: text.links.heading },
  { id: 'pp-rights', heading: text.rights.heading },
  { id: 'pp-changes', heading: text.changes.heading },
] as const;
const num = (id: (typeof toc)[number]['id']): string =>
  String(toc.findIndex((entry) => entry.id === id) + 1).padStart(2, '0');
const updatedIso = '2026-11-25';
const { street, postalCode, city, region } = site.address;
const address = `${street}, ${postalCode} ${city}, ${region}`;
const googlePrivacy = 'https://policies.google.com/privacy';
const dataAuthority = 'https://www.dpa.gr/';
---

<BaseLayout title={text.meta.title} description={text.meta.description}>
  <PageHeader
    label={text.header.label}
    title={text.header.title}
    intro={text.header.intro}
    accent="key"
  />

  <div class="wrap privacy-layout" data-bg-accent="cyan">
    <nav class="privacy-toc" aria-labelledby="pp-toc-title">
      <h2 id="pp-toc-title" class="label">
        {capsEl(text.tocLabel)}
      </h2>
      <ol class="privacy-toc-list">
        {toc.map((entry) => (
          <li>
            <a href={`#${entry.id}`} class="privacy-toc-link">
              <span class="privacy-num" aria-hidden="true">
                {num(entry.id)}
              </span>
              <span>{entry.heading}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="privacy">
      <p class="text-small muted">
        {`${text.updatedLabel} `}
        <time datetime={updatedIso}>{text.updatedDate}</time>
      </p>

      <section aria-labelledby="pp-who">
        <h2 id="pp-who" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-who')}
          </span>
          <span>{text.who.heading}</span>
        </h2>
        {/* TODO(owner): registered business name, legal form and ΑΦΜ, if the owner wants them
            shown. */}
        <p>{text.who.body}</p>
        <p>{`${text.who.addressLabel} ${address}.`}</p>
        <p>
          {`${text.who.contactBefore} `}
          <a href={mailtoHref(site.contact.email)} class="link">
            {site.contact.email}
          </a>
          {` ${text.who.contactOr} `}
          <a href={telHref(site.contact.phone)} class="link">
            {site.contact.phoneDisplay}
          </a>
          .
        </p>
      </section>

      <section aria-labelledby="pp-tracking">
        <h2 id="pp-tracking" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-tracking')}
          </span>
          <span>{text.tracking.heading}</span>
        </h2>
        <p>{text.tracking.body}</p>
        <p>{text.tracking.storageIntro}</p>
        <ul class="privacy-list">
          <li>{text.tracking.storageTheme}</li>
          <li>{text.tracking.storageHero}</li>
        </ul>
      </section>

      <section aria-labelledby="pp-form">
        <h2 id="pp-form" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-form')}
          </span>
          <span>{text.form.heading}</span>
        </h2>
        <p>{text.form.fields}</p>
        <p>{text.form.body}</p>
        <p>{text.form.whatsapp}</p>
        <p>{text.form.clipboard}</p>
      </section>

      <section aria-labelledby="pp-use">
        <h2 id="pp-use" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-use')}
          </span>
          <span>{text.use.heading}</span>
        </h2>
        <p>{text.use.purpose}</p>
        <p>{text.use.basis}</p>
        <p>{text.use.retention}</p>
      </section>

      <section aria-labelledby="pp-recipients">
        <h2 id="pp-recipients" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-recipients')}
          </span>
          <span>{text.recipients.heading}</span>
        </h2>
        <p>{text.recipients.intro}</p>
        <ul class="privacy-list">
          {text.recipients.list.map((item) => (
            <li>
              <strong>{item.name}</strong>
              {`: ${item.text}`}
            </li>
          ))}
        </ul>
        <p>{text.recipients.transfers}</p>
      </section>

      <section aria-labelledby="pp-map">
        <h2 id="pp-map" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-map')}
          </span>
          <span>{text.map.heading}</span>
        </h2>
        <p>{text.map.body}</p>
        <p>
          {`${text.map.policyBefore} `}
          <a href={googlePrivacy} class="link" target="_blank" rel="noopener">
            {text.map.policyLink}
            <span class="sr-only">{` ${t('newTab')}`}</span>
          </a>
          .
        </p>
        <p>{text.map.external}</p>
        <p>{text.map.basis}</p>
      </section>

      <section aria-labelledby="pp-links">
        <h2 id="pp-links" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-links')}
          </span>
          <span>{text.links.heading}</span>
        </h2>
        <p>{text.links.body}</p>
      </section>

      <section aria-labelledby="pp-rights">
        <h2 id="pp-rights" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-rights')}
          </span>
          <span>{text.rights.heading}</span>
        </h2>
        <p>{text.rights.body}</p>
        <p>{text.rights.automated}</p>
        <p>
          {`${text.rights.authorityBefore} `}
          <a href={dataAuthority} class="link" target="_blank" rel="noopener">
            {text.rights.authorityLink}
            <span class="sr-only">{` ${t('newTab')}`}</span>
          </a>
          .
        </p>
      </section>

      <section aria-labelledby="pp-changes">
        <h2 id="pp-changes" class="h3 privacy-h">
          <span class="privacy-num" aria-hidden="true">
            {num('pp-changes')}
          </span>
          <span>{text.changes.heading}</span>
        </h2>
        <p>{text.changes.body}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  @layer components {
    .privacy-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      padding-top: clamp(3rem, 2rem + 3vw, 4rem);
      padding-bottom: var(--section-y);
    }
    /* Phones and tablets read straight through; the contents list is a wide-screen aid. */
    .privacy-toc {
      display: none;
    }
    @media (min-width: 64rem) {
      .privacy-layout {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--grid-gap);
        align-items: start;
      }
      .privacy-toc {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
        display: block;
        grid-column: 1 / span 3;
      }
      .privacy {
        grid-column: 4 / span 8;
      }
    }
    .privacy-toc-list {
      display: flex;
      flex-direction: column;
      margin-top: 1.25rem;
      border-top: 2px solid var(--color-key);
    }
    .privacy-toc-link {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      min-height: 2.75rem;
      padding-block: 0.625rem;
      border-bottom: 1px solid var(--color-line);
      font-size: var(--text-small);
      font-weight: 600;
      line-height: 1.35;
      text-decoration: none;
      transition: color var(--dur-fast) linear;
    }
    .privacy-toc-link > span:last-child {
      transition: transform var(--dur-base) var(--ease-out);
    }
    .privacy-toc-link:focus-visible > span:last-child {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
    @media (prefers-reduced-motion: no-preference) {
      .privacy-toc-link:focus-visible > span:last-child {
        transform: translateX(0.25rem);
      }
    }
    /* Hover only where the pointer can hover (a touch tablet wide enough for the list). */
    @media (hover: hover) {
      .privacy-toc-link:hover > span:last-child {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .privacy-toc-link:hover > span:last-child {
        transform: translateX(0.25rem);
      }
    }

    /* Long words, addresses and links break rather than widen a phone's column; paragraphs
       avoid a lone last word and headings balance their lines. */
    .privacy {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 68ch;
      font-size: 1.0625rem;
      line-height: 1.7;
      overflow-wrap: break-word;
    }
    .privacy p {
      text-wrap: pretty;
    }
    .privacy-h > span:last-child {
      text-wrap: balance;
    }
    .privacy section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.75rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--color-line);
    }
    @media (max-width: 39.99rem) {
      .privacy section {
        margin-top: 1.25rem;
      }
    }
    .privacy-h {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
    }
    .privacy-num {
      flex: none;
      min-width: 1.75rem;
      font-family: var(--font-display);
      font-size: var(--text-label);
      font-weight: 750;
      letter-spacing: 0.12em;
      color: var(--color-red);
      font-variant-numeric: tabular-nums;
    }
    /* Bulleted lists: Tailwind's preflight removes list markers, so they are restored here, in
       the red of the section numbers. */
    .privacy-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-left: 1.25rem;
      list-style: disc;
    }
    .privacy-list > li {
      padding-left: 0.25rem;
    }
    .privacy-list > li::marker {
      color: var(--color-red);
    }
    .privacy a {
      overflow-wrap: anywhere;
    }
  }
</style>
