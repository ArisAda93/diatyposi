---
/**
 * Πολιτική απορρήτου: a plain reading page that describes what this static site actually does.
 *
 * TODO(owner): add the legal entity details (registered name, legal form, ΑΦΜ, registered
 * address) in the “Ποιοι είμαστε” section, and have the whole text reviewed before launch.
 * Then remove the review note at the top and update `updatedDate` in src/i18n/pages/privacy.ts.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { site } from '~/data/site';
import { t } from '~/i18n/ui';
import { privacyText } from '~/i18n/pages/privacy';
import { mailtoHref } from '~/lib/links';

const text = privacyText.el;
const updatedIso = '2026-11-22';
const googlePrivacy = 'https://policies.google.com/privacy';
const dataAuthority = 'https://www.dpa.gr/';
---

<BaseLayout title={text.meta.title} description={text.meta.description}>
  <PageHeader label={text.header.label} title={text.header.title} intro={text.header.intro} />

  <div class="wrap pt-12 pb-(--section-y) lg:pt-16">
    <article class="privacy">
      <p class="privacy-note">{text.reviewNote}</p>
      <p class="text-small muted">
        {`${text.updatedLabel} `}
        <time datetime={updatedIso}>{text.updatedDate}</time>
      </p>

      <section aria-labelledby="pp-who">
        <h2 id="pp-who" class="h3">
          {text.who.heading}
        </h2>
        {/* TODO(owner): registered business name, legal form, ΑΦΜ and registered address. */}
        <p>{text.who.body}</p>
        <p>
          {`${text.who.contactBefore} `}
          <a href={mailtoHref(site.contact.email)} class="link">
            {site.contact.email}
          </a>
          .
        </p>
      </section>

      <section aria-labelledby="pp-tracking">
        <h2 id="pp-tracking" class="h3">
          {text.tracking.heading}
        </h2>
        <p>{text.tracking.body}</p>
        <p>{text.tracking.storage}</p>
      </section>

      <section aria-labelledby="pp-form">
        <h2 id="pp-form" class="h3">
          {text.form.heading}
        </h2>
        <p>{text.form.body}</p>
        <p>{text.form.apps}</p>
        {/* TODO(owner): confirm how incoming messages are used and how long they are kept. */}
        <p>{text.form.use}</p>
      </section>

      <section aria-labelledby="pp-map">
        <h2 id="pp-map" class="h3">
          {text.map.heading}
        </h2>
        <p>{text.map.body}</p>
        <p>
          {`${text.map.policyBefore} `}
          <a href={googlePrivacy} class="link" target="_blank" rel="noopener">
            {text.map.policyLink}
            <span class="sr-only">{` ${t('newTab')}`}</span>
          </a>
          .
        </p>
        <p>{text.map.external}</p>
      </section>

      <section aria-labelledby="pp-links">
        <h2 id="pp-links" class="h3">
          {text.links.heading}
        </h2>
        <p>{text.links.body}</p>
      </section>

      <section aria-labelledby="pp-hosting">
        <h2 id="pp-hosting" class="h3">
          {text.hosting.heading}
        </h2>
        <p>{text.hosting.fonts}</p>
        {/* TODO(owner): name the hosting provider once chosen. */}
        <p>{text.hosting.logs}</p>
      </section>

      <section aria-labelledby="pp-rights">
        <h2 id="pp-rights" class="h3">
          {text.rights.heading}
        </h2>
        <p>{text.rights.body}</p>
        <p>
          {`${text.rights.authorityBefore} `}
          <a href={dataAuthority} class="link" target="_blank" rel="noopener">
            {text.rights.authorityLink}
            <span class="sr-only">{` ${t('newTab')}`}</span>
          </a>
          .
        </p>
      </section>

      <section aria-labelledby="pp-changes">
        <h2 id="pp-changes" class="h3">
          {text.changes.heading}
        </h2>
        <p>{text.changes.body}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  @layer components {
    .privacy {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 68ch;
    }
    .privacy section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.75rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--color-line);
    }
    .privacy-note {
      padding: 1rem 1.25rem;
      background-color: var(--color-yellow);
      color: var(--color-key);
      font-weight: 600;
    }
    .privacy a {
      overflow-wrap: anywhere;
    }
  }
</style>
