---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ContactBand from '~/components/ContactBand.astro';
import AboutSheet from '~/components/about/AboutSheet.astro';
import ValueBlocks from '~/components/about/ValueBlocks.astro';
import { ownerCopy } from '~/data/site';
import { aboutText } from '~/i18n/pages/about';
import { capsEl } from '~/lib/text';

const text = aboutText.el;
const owner = ownerCopy.el;
---

<BaseLayout title={text.metaTitle} description={text.metaDescription}>
  <PageHeader label={text.headerLabel} title={text.headerTitle} intro={owner.intro} />

  <section class="section about-approach" aria-labelledby="about-approach-title">
    <div class="wrap grid-12 items-center gap-y-14">
      <div class="col-span-12 md:col-span-6 lg:col-span-5">
        <AboutSheet />
      </div>
      <div class="col-span-12 md:col-span-5 md:col-start-8 lg:col-span-6 lg:col-start-7">
        <h2 id="about-approach-title" class="label">
          {capsEl(text.approachHeading)}
        </h2>
        <p class="about-partnership">{owner.partnership}</p>
      </div>
    </div>
  </section>

  <ValueBlocks />

  <ContactBand />
</BaseLayout>

<style>
  @layer components {
    .about-approach {
      padding-top: clamp(3rem, 2rem + 4vw, 6rem);
      /* The values section below brings its own top padding. */
      padding-bottom: 0;
    }
    .about-partnership {
      margin-top: 1.5rem;
      max-width: 30ch;
      font-family: var(--font-display);
      font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2.125rem);
      font-weight: 640;
      line-height: 1.3;
      letter-spacing: -0.015em;
      text-wrap: pretty;
    }
  }
</style>
