---
/**
 * Η εταιρεία: page header with the owner's intro, then three sections (Section.astro): 01 the
 * work-table photograph (Workbench) beside the owner's “Για εμάς…” paragraph and the four
 * numbered points marked on the photo, 02 the four values
 * (ValueBlocks), and the contact band. Light sections paint no background; each tints the living
 * background through `data-bg-accent`. The section label “Πώς δουλεύουμε” is the first section's
 * heading (no separate title).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import ContactBand from '~/components/ContactBand.astro';
import SectionRail from '~/components/SectionRail.astro';
import Workbench from '~/components/about/Workbench.astro';
import ValueBlocks from '~/components/about/ValueBlocks.astro';
import { ownerCopy } from '~/data/site';
import { aboutText } from '~/i18n/pages/about';

const text = aboutText.el;
const owner = ownerCopy.el;
/** Plate ink of each numbered point, as on the photo's markers (about/Workbench.astro). */
const stepInks = ['--color-cyan', '--color-magenta', '--color-yellow', '--ink-fixed'] as const;
---

<BaseLayout title={text.metaTitle} description={text.metaDescription}>
  <PageHeader
    label={text.headerLabel}
    title={text.headerTitle}
    intro={owner.intro}
    accent="yellow"
  />

  <Section
    id="about-approach"
    index="01"
    label={text.approachHeading}
    accent="cyan"
    class="about-approach"
  >
    <div class="grid-12 items-center gap-y-12">
      <div class="col-span-12 lg:col-span-7">
        <Workbench />
      </div>
      <div class="col-span-12 lg:col-span-5 lg:col-start-8">
        <p class="about-partnership">{owner.partnership}</p>
        <ol class="about-steps" role="list" aria-label={text.workbench.stepsLabel}>
          {text.workbench.steps.map((step, i) => (
            <li class="about-step" style={`--step-ink: var(${stepInks[i]})`}>
              <span class="about-step-num" aria-hidden="true">
                {i + 1}
              </span>
              <span>
                <strong>{step.lead}</strong> {step.text}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Section>

  <ValueBlocks />

  <ContactBand />
  <SectionRail />
</BaseLayout>

<style>
  @layer components {
    .about-partnership {
      max-width: 30ch;
      font-family: var(--font-display);
      font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2.125rem);
      font-weight: 640;
      line-height: 1.3;
      letter-spacing: -0.015em;
      text-wrap: pretty;
    }
    .about-steps {
      display: grid;
      gap: 0.875rem;
      max-width: 34rem;
      margin: 2rem 0 0;
      padding: 1.5rem 0 0;
      border-top: 1px solid var(--color-line);
      list-style: none;
    }
    .about-step {
      display: flex;
      align-items: baseline;
      gap: 0.875rem;
      font-size: var(--text-body);
      line-height: 1.5;
    }
    .about-step strong {
      font-weight: 700;
    }
    /* The photo's marker in small: a white disc with the step's plate ink as its ring. */
    .about-step-num {
      display: inline-grid;
      flex: none;
      place-items: center;
      width: 1.625rem;
      height: 1.625rem;
      border-radius: 50%;
      background-color: #ffffff;
      box-shadow: inset 0 0 0 0.175rem var(--step-ink);
      color: var(--ink-fixed);
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 860;
      line-height: 1;
    }
  }
</style>
