---
/**
 * Η εταιρεία: page header with the owner's intro, then three sections (Section.astro): 01 the
 * photo slot (AboutSheet) beside the owner's “Για εμάς…” paragraph, 02 the four values
 * (ValueBlocks), and the contact band. Light sections paint no background; each tints the living
 * background through `data-bg-accent`. The section label “Πώς δουλεύουμε” is the first section's
 * heading (no separate title).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Section from '~/components/Section.astro';
import ContactBand from '~/components/ContactBand.astro';
import SectionRail from '~/components/SectionRail.astro';
import AboutSheet from '~/components/about/AboutSheet.astro';
import ValueBlocks from '~/components/about/ValueBlocks.astro';
import { ownerCopy } from '~/data/site';
import { aboutText } from '~/i18n/pages/about';

const text = aboutText.el;
const owner = ownerCopy.el;
---

<BaseLayout title={text.metaTitle} description={text.metaDescription}>
  <PageHeader
    label={text.headerLabel}
    title={text.headerTitle}
    intro={owner.intro}
    accent="yellow"
  />

  <Section
    id="about-approach"
    index="01"
    label={text.approachHeading}
    accent="cyan"
    class="about-approach"
  >
    <div class="grid-12 items-center gap-y-14">
      <div class="col-span-12 md:col-span-6 lg:col-span-5">
        <AboutSheet />
      </div>
      <div class="col-span-12 md:col-span-5 md:col-start-8 lg:col-span-6 lg:col-start-7">
        <p class="about-partnership">{owner.partnership}</p>
      </div>
    </div>
  </Section>

  <ValueBlocks />

  <ContactBand />
  <SectionRail />
</BaseLayout>

<style>
  @layer components {
    .about-partnership {
      max-width: 30ch;
      font-family: var(--font-display);
      font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2.125rem);
      font-weight: 640;
      line-height: 1.3;
      letter-spacing: -0.015em;
      text-wrap: pretty;
    }
  }
</style>
