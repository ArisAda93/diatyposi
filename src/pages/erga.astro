---
/**
 * Έργα: page header, then the filterable gallery with its lightbox (WorkGallery). The section
 * paints no background; it tints the living background through `data-bg-accent`.
 * Under development: while `hiddenSections.work` is set the page is still built but unlinked,
 * noindex and left out of the sitemap.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import WorkGallery from '~/components/portfolio/WorkGallery.astro';
import { hiddenSections } from '~/data/site';
import { workText } from '~/i18n/pages/work';

const text = workText.el;
---

<BaseLayout title={text.metaTitle} description={text.metaDescription} noindex={hiddenSections.work}>
  <PageHeader
    label={text.headerLabel}
    title={text.headerTitle}
    intro={text.headerIntro}
    accent="magenta"
  />

  <section class="wrap work-section" aria-labelledby="work-heading" data-bg-accent="cyan">
    <h2 id="work-heading" class="sr-only">
      {text.headerLabel}
    </h2>
    <WorkGallery />
  </section>
</BaseLayout>

<style>
  @layer components {
    .work-section {
      padding-top: clamp(2rem, 1rem + 3vw, 4rem);
      padding-bottom: var(--section-y);
    }
  }
</style>
