---
/**
 * Επικοινωνία: contact details, opening hours, social links, the map and the quote form
 * (#prosfora), which delivers the request straight to the shop's inbox. Desktop: details and
 * map on the left, the form on the right. Phones: details, form, map (the DOM order, so reading
 * and focus order match what is seen). On the 12-column grid: details and map in columns 1–5,
 * the form in 6–12 (1–4 and 6–12 from 1280px, where the gutter between them widens). The layout paints no background (`data-bg-accent` tints the
 * living background); the form keeps its paper job-ticket panel.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import ContactDetails from '~/components/contact/ContactDetails.astro';
import MapEmbed from '~/components/contact/MapEmbed.astro';
import QuoteForm from '~/components/contact/QuoteForm.astro';
import { contactText } from '~/i18n/pages/contact';

const text = contactText.el;
---

<BaseLayout title={text.meta.title} description={text.meta.description} structuredData>
  <PageHeader
    label={text.header.label}
    title={text.header.title}
    intro={text.header.intro}
    accent="cyan"
  />

  <div class="wrap contact-layout" data-bg-accent="yellow">
    <div class="contact-area-details">
      <ContactDetails />
    </div>
    <div class="contact-area-form">
      <QuoteForm />
    </div>
    <div class="contact-area-map">
      <MapEmbed />
    </div>
  </div>
</BaseLayout>

<style>
  @layer components {
    .contact-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(3.5rem, 2.5rem + 4vw, 5rem);
      padding-top: clamp(3rem, 2rem + 3vw, 5rem);
      padding-bottom: var(--section-y);
    }
    @media (min-width: 64rem) {
      .contact-layout {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: auto 1fr;
        column-gap: var(--grid-gap);
        row-gap: 4rem;
        align-items: start;
      }
      .contact-area-details {
        grid-column: 1 / span 5;
        grid-row: 1;
      }
      .contact-area-form {
        grid-column: 6 / -1;
        grid-row: 1 / span 2;
        padding-left: clamp(1rem, 2vw, 2rem);
      }
      .contact-area-map {
        grid-column: 1 / span 5;
        grid-row: 2;
      }
    }
    @media (min-width: 80rem) {
      .contact-area-details,
      .contact-area-map {
        grid-column: 1 / span 4;
      }
      .contact-area-form {
        padding-left: 0;
      }
    }
  }
</style>
